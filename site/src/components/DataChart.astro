---
// DataChart: one interactive chart from the article's `charts` frontmatter (flagship reports).
// Pure SVG, zero dependencies. Oct 2026 redesign:
//  * single series: bars (or a line past 16 points), the latest/current point in moss
//  * several time series: all lines at once in the validated series colours (--s1..--s4),
//    direct labels at the line ends, chips to hide/show a line, one tooltip per year
//  * categorical with several series: chips switch between them (one ranking at a time)
//  * bars grow and lines draw in when the chart scrolls into view
// A plain <table> sits in a <details> under every chart so the numbers are crawlable/copyable.
import { type Lang } from '../i18n/ui';
import DataChartSvg from './DataChartSvg.astro';
interface Series { name: string; points: (number | null)[] }
interface Chart { label: string; unit?: string; kind?: 'timeseries' | 'categorical'; categories: string[]; series: Series[]; note?: string; source?: string; url?: string }
interface Props { lang: Lang; chart: Chart; index: number; total?: number }
const { lang, chart: c, index, total } = Astro.props;
const T = lang === 'de'
  ? { table: 'Als Tabelle anzeigen', src: 'Quelle', now: 'jetzt', chart: 'Grafik', of: 'von', hint: 'Fahre über ein Jahr für die Werte. Tippe auf eine Linie, um sie auszublenden.' }
  : { table: 'Show as table', src: 'Source', now: 'now', chart: 'Chart', of: 'of', hint: 'Hover a year for values. Tap a line to hide it.' };
const cats = c.categories;
const series = c.series.filter((s) => s.points.length === cats.length && s.points.some((p) => p != null)).slice(0, 4);
const categorical = c.kind === 'categorical';
const multiLine = !categorical && series.length > 1;
const switcher = categorical && series.length > 1;
const all = series.flatMap((s) => s.points.filter((p): p is number => p != null));
const mx = Math.max(...all, 1e-9), mn = Math.min(...all, 0);
const asLine = multiLine || (!categorical && cats.length > 16);
const dense = cats.length > 14;
const lblStep = Math.ceil(cats.length / 12);
const nowYear = String(new Date().getFullYear());
const fmt = (v: number) => (Math.abs(v) >= 1000 ? v.toLocaleString(lang === 'de' ? 'de-DE' : 'en-US', { maximumFractionDigits: 1 }) : String(Math.round(v * 100) / 100).replace('.', lang === 'de' ? ',' : '.'));
const COL = ['var(--s1)', 'var(--s2)', 'var(--s3)', 'var(--s4)'];
const id = `dc${index}`;
---
<figure class="dc rv" id={id} data-multi={multiLine ? 'lines' : switcher ? 'switch' : undefined}>
  <figcaption class="dc-head">
    <span class="dc-n">{T.chart} {index + 1}{total ? ` ${T.of} ${total}` : ''}</span>
    <span class="dc-title">{c.label}{c.unit ? <span class="dc-unit"> · {c.unit}</span> : null}</span>
  </figcaption>
  {(multiLine || switcher) && (
    <div class="dc-chips" role={switcher ? 'tablist' : 'group'}>
      {series.map((s, si) => switcher
        ? <button type="button" role="tab" class="dc-chip" aria-selected={si === 0 ? 'true' : 'false'} data-s={si}>{s.name || `#${si + 1}`}</button>
        : <button type="button" class="dc-chip dc-tog" aria-pressed="true" data-s={si}><span class="dc-sw" style={`background:${COL[si]}`}></span>{s.name || `#${si + 1}`}</button>)}
    </div>
  )}
  <div class="dcw">
    <div class="dc-d"><DataChartSvg lang={lang} chart={c} series={series} nowLabel={T.now} /></div>
    <div class="dc-m"><DataChartSvg lang={lang} chart={c} series={series} nowLabel={T.now} compact /></div>
    <div class="dc-tip" hidden></div>
  </div>
  {multiLine && <p class="dc-hint">{T.hint}</p>}
  <details class="dc-table">
    <summary>{T.table}</summary>
    <table>
      <thead><tr><th></th>{series.map((s) => <th>{s.name || c.unit || ''}</th>)}</tr></thead>
      <tbody>{cats.map((cat, i) => <tr><th scope="row">{cat}</th>{series.map((s) => <td>{s.points[i] == null ? '' : fmt(s.points[i] as number)}</td>)}</tr>)}</tbody>
    </table>
  </details>
  {(c.source || c.note) && <p class="dc-src">{c.source && (c.url ? <a href={c.url} target="_blank" rel="nofollow noopener">{T.src}: {c.source} ↗</a> : <span>{T.src}: {c.source}</span>)}{c.note && <span class="dc-note"> · {c.note}</span>}</p>}
</figure>

<style is:global>
  .dc{margin:20px 0 0;padding:22px 22px 16px;border:1px solid var(--line);border-radius:20px;background:var(--panel)}
  .dc-head{display:flex;flex-direction:column;gap:6px}
  .dc-n{font-size:11px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--g3)}
  .dc-title{font-size:18px;font-weight:600;letter-spacing:-.015em;line-height:1.3}
  .dc-unit{color:var(--g3);font-weight:400}
  .dc-chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}
  .dc-chip{display:inline-flex;align-items:center;gap:8px;font:inherit;font-size:13px;font-weight:500;border:1px solid var(--line);border-radius:999px;padding:7px 12px;min-height:36px;background:var(--panel);color:var(--g2);cursor:pointer;transition:border-color .15s,color .15s}
  .dc-chip:hover{border-color:var(--chalk);color:var(--chalk)}
  .dc-chip[aria-selected="true"],.dc-chip[aria-pressed="true"]{border-color:var(--chalk);color:var(--chalk)}
  .dc-sw{display:inline-block;width:10px;height:10px;border-radius:3px;transition:opacity .15s}
  .dc-chip[aria-pressed="false"] .dc-sw{opacity:.25}
  .dcw{position:relative}
  .dc-m{display:none}
  @media(max-width:640px){ .dc-d{display:none} .dc-m{display:block} }
  .dc-pt,.dc-col{cursor:default}.dc-pt:focus,.dc-col:focus{outline:none}
  .dc-pt:hover .dc-r,.dc-pt:focus .dc-r{opacity:1}
  .dc-pt:hover .dc-dot,.dc-pt:focus .dc-dot{r:5}
  .dc-col .dc-guide,.dc-col .dc-dot{opacity:0;transition:opacity .12s}
  .dc-col:hover .dc-guide,.dc-col:hover .dc-dot,.dc-col:focus .dc-guide,.dc-col:focus .dc-dot{opacity:1}
  .dc-s.off{display:none}
  /* draw-in: runs when the figure gets .in from the page's scroll observer */
  .js .dc .dc-ln{stroke-dasharray:1;stroke-dashoffset:1;transition:stroke-dashoffset 1.4s cubic-bezier(.65,0,.35,1) .2s}
  .js .dc.in .dc-ln{stroke-dashoffset:0}
  .js .dc .dc-vbar{transform-box:fill-box;transform-origin:bottom;transform:scaleY(0);transition:transform .8s cubic-bezier(.2,.7,.2,1)}
  .js .dc.in .dc-vbar{transform:scaleY(1)}
  .js .dc .dc-hbar{transform-box:fill-box;transform-origin:left;transform:scaleX(0);transition:transform .8s cubic-bezier(.2,.7,.2,1)}
  .js .dc.in .dc-hbar{transform:scaleX(1)}
  .dc-tip{position:absolute;pointer-events:none;z-index:5;background:var(--panel);border:1px solid var(--edge);border-radius:12px;padding:9px 12px;font-size:12.5px;line-height:1.5;color:var(--chalk);transform:translate(-50%,-110%);white-space:nowrap;box-shadow:var(--shadow-lg)}
  .dc-tip b{font-family:var(--mono)}
  .dc-tip .up{color:var(--up)}.dc-tip .dn{color:var(--down)}
  .dc-tip .r{display:flex;align-items:center;gap:8px;color:var(--g2)}
  .dc-tip .r i{width:9px;height:9px;border-radius:3px;display:inline-block}
  .dc-tip .r em{margin-left:auto;padding-left:14px;font-style:normal;font-family:var(--mono);color:var(--chalk)}
  .dc-hint{font-size:12px;color:var(--g4);margin:6px 0 0}
  .dc-table{margin-top:10px}
  .dc-table summary{font-size:12.5px;font-weight:600;color:var(--g3);cursor:pointer;list-style:none;display:inline-flex;align-items:center;gap:6px}
  .dc-table summary::before{content:"▸";transition:transform .15s}
  .dc-table[open] summary::before{transform:rotate(90deg)}
  .dc-table table{width:100%;border-collapse:collapse;margin-top:8px;font-size:12.5px;font-family:var(--mono)}
  .dc-table th,.dc-table td{text-align:right;padding:5px 8px;border-top:1px solid var(--line);color:var(--g2)}
  .dc-table th[scope="row"],.dc-table thead th:first-child{text-align:left;color:var(--g1)}
  .dc-table thead th{color:var(--g4);font-weight:600}
  .dc-src{font-size:11.5px;color:var(--g4);margin:8px 0 0}
  .dc-src a{color:inherit}
  @media(max-width:560px){ .dc{padding:18px 14px 14px} }
  @media (prefers-reduced-motion: reduce){ .js .dc .dc-ln{stroke-dashoffset:0} .js .dc .dc-vbar,.js .dc .dc-hbar{transform:none} }
</style>

<script>
  // Tooltips + series toggles. Scoped per figure so any number of charts coexist.
  const COLS = ['var(--s1)', 'var(--s2)', 'var(--s3)', 'var(--s4)'];
  document.querySelectorAll<HTMLElement>('.dc').forEach((fig) => {
    const wrap = fig.querySelector<HTMLElement>('.dcw'), tip = fig.querySelector<HTMLElement>('.dc-tip');
    const lang = document.documentElement.lang || 'en';
    const nowL = lang.startsWith('de') ? 'jetzt' : 'now', yoyL = lang.startsWith('de') ? 'ggü. Vorjahr' : 'vs prior';
    const hidden = new Set<string>();
    const esc = (s: string) => s.replace(/[&<>"]/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[ch] as string));
    const place = (g: Element, html: string) => {
      if (!wrap || !tip) return;
      tip.innerHTML = html;
      const gb = (g as SVGGraphicsElement).getBoundingClientRect(), wb = wrap.getBoundingClientRect();
      const x = gb.left - wb.left + gb.width / 2;
      tip.style.left = Math.max(80, Math.min(wb.width - 80, x)) + 'px';
      tip.style.top = (g.classList.contains('dc-col') ? 40 : gb.top - wb.top) + 'px';
      tip.hidden = false;
    };
    const hide = () => { if (tip) tip.hidden = true; };
    fig.querySelectorAll('.dc-pt').forEach((g) => {
      const show = () => {
        const cat = g.getAttribute('data-cat') || '', val = g.getAttribute('data-val') || '', unit = g.getAttribute('data-unit') || '';
        const yoy = g.getAttribute('data-yoy'), now = g.getAttribute('data-now');
        let html = `<b>${esc(val)}</b>${unit ? ' ' + esc(unit) : ''}${cat ? ` · ${esc(cat)}` : ''}${now ? ' · ' + nowL : ''}`;
        if (yoy) { const up = parseFloat(yoy) >= 0; html += `<br><span class="${up ? 'up' : 'dn'}">${up ? '▲' : '▼'} ${Math.abs(parseFloat(yoy))}% ${yoyL}</span>`; }
        place(g, html);
      };
      g.addEventListener('mouseenter', show); g.addEventListener('focus', show);
      g.addEventListener('mouseleave', hide); g.addEventListener('blur', hide);
    });
    fig.querySelectorAll('.dc-col').forEach((g) => {
      const show = () => {
        const cat = g.getAttribute('data-cat') || '', unit = g.getAttribute('data-unit') || '';
        const rows = (g.getAttribute('data-vals') || '').split(';').map((r) => r.split('|'))
          .filter(([si, , v]) => v !== '' && !hidden.has(si))
          .map(([si, n, v]) => `<div class="r"><i style="background:${COLS[+si]}"></i>${esc(n)}<em>${esc(v)}</em></div>`).join('');
        place(g, `<b>${esc(cat)}</b>${unit ? ` · ${esc(unit)}` : ''}${rows}`);
      };
      g.addEventListener('mouseenter', show); g.addEventListener('focus', show);
      g.addEventListener('mouseleave', hide); g.addEventListener('blur', hide);
    });
    // categorical: switch between series
    fig.querySelectorAll<HTMLButtonElement>('.dc-chip:not(.dc-tog)').forEach((chip) => chip.addEventListener('click', () => {
      const si = chip.dataset.s;
      fig.querySelectorAll<HTMLButtonElement>('.dc-chip').forEach((c) => c.setAttribute('aria-selected', c === chip ? 'true' : 'false'));
      fig.querySelectorAll<SVGGElement>('.dc-s').forEach((g) => { g.style.display = g.dataset.s === si ? '' : 'none'; });
      hide();
    }));
    // time series: hide/show lines (at least one stays on)
    fig.querySelectorAll<HTMLButtonElement>('.dc-tog').forEach((chip) => chip.addEventListener('click', () => {
      const si = chip.dataset.s as string;
      const on = !hidden.has(si);
      if (on && hidden.size >= fig.querySelectorAll('.dc-tog').length - 1) return;
      on ? hidden.add(si) : hidden.delete(si);
      chip.setAttribute('aria-pressed', on ? 'false' : 'true');
      fig.querySelectorAll<SVGElement>(`.dc-s[data-s="${si}"]`).forEach((el) => el.classList.toggle('off', on));
      hide();
    }));
  });
</script>
