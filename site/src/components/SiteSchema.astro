---
// Sitewide entity graph: Organization + WebSite + the person behind the scores.
//
// Why this exists: page-level JSON-LD already ships on Verified reviews
// (Product/Review/AggregateRating), Daily (NewsArticle/AudioObject) and
// Intelligence (Article/Dataset) — but nothing declared WHO publishes them.
// Every one of those blocks referenced a bare `{ name: 'sqwod.life' }` string,
// so there was no resolvable publisher entity and no author identity anywhere
// on the site. The homepage carried no structured data at all.
//
// All facts below are lifted verbatim from /impressum and /about — do not add
// a claim here that is not visible to a reader on those pages.
import { type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;

const ORG_ID = 'https://sqwod.life/#organization';
const SITE_ID = 'https://sqwod.life/#website';
const PERSON_ID = 'https://sqwod.life/#tee-major';

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': ORG_ID,
      name: 'sqwod.life',
      url: 'https://sqwod.life/en/',
      logo: { '@type': 'ImageObject', url: 'https://sqwod.life/sqwod-black.png' },
      description:
        'Insider intelligence, honest gear reviews, and growth playbooks for the coaches, creators, and founders the big platforms overlook.',
      email: 'tee@sqwod.life',
      telephone: '+49 176 43220085',
      vatID: 'DE329421661',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Wisbyer Str. 70',
        postalCode: '10439',
        addressLocality: 'Berlin',
        addressCountry: 'DE',
      },
      founder: { '@id': PERSON_ID },
      // Public policy pages — the correctionsPolicy one is genuinely rare and
      // is backed by a populated, dated log at /corrections.
      publishingPrinciples: 'https://sqwod.life/en/evidence/methodology/',
      correctionsPolicy: 'https://sqwod.life/en/corrections/',
      actionableFeedbackPolicy: 'https://sqwod.life/en/corrections/',
      ethicsPolicy: 'https://sqwod.life/en/verified/disclosure/',
      knowsLanguage: ['en', 'de'],
    },
    {
      '@type': 'WebSite',
      '@id': SITE_ID,
      url: 'https://sqwod.life/en/',
      name: 'sqwod.life',
      publisher: { '@id': ORG_ID },
      inLanguage: ['en', 'de'],
    },
    {
      '@type': 'Person',
      '@id': PERSON_ID,
      name: 'Tee Major',
      givenName: 'Thomas',
      familyName: 'Major',
      email: 'tee@sqwod.life',
      url: 'https://sqwod.life/en/about/',
      jobTitle: 'Founder and Editor',
      description:
        '24+ years in the fitness industry, military fitness trainer (USMC, Army, Navy, Air Force), TRX / ACE / sports-nutrition certified.',
      worksFor: { '@id': ORG_ID },
      knowsAbout: [
        'strength and conditioning',
        'fitness business operations',
        'sports nutrition',
        'wearable technology',
        'commercial gym equipment',
      ],
      hasCredential: [
        { '@type': 'EducationalOccupationalCredential', credentialCategory: 'certification', name: 'TRX Certified' },
        { '@type': 'EducationalOccupationalCredential', credentialCategory: 'certification', name: 'ACE Certified' },
        { '@type': 'EducationalOccupationalCredential', credentialCategory: 'certification', name: 'Sports Nutrition Certified' },
      ],
    },
  ],
};
// `lang` is accepted so callers stay explicit about locale even though the
// graph itself is language-neutral (knowsLanguage/inLanguage cover both).
void lang;
---
<script type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g, '\\u003c')} />
