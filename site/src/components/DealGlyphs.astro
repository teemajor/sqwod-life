---
// One hidden sprite per page: the five deal-type icons (monochrome line icons, drawn after
// Feather, MIT) and the flags the page uses. DealIcon.astro and Flag.astro point at it with <use>.
import { flagSymbol } from '../lib/flags';
interface Props { flags?: string[] }
const { flags = [] } = Astro.props;
const ICONS: Record<string, string> = {
  raise: '<path d="M3 17l6-6 4 4 8-8"/><path d="M14 7h7v7"/>',
  acquisition: '<circle cx="18" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><path d="M6 21V9a9 9 0 0 0 9 9"/>',
  shutdown: '<circle cx="12" cy="12" r="9"/><path d="m15 9-6 6M9 9l6 6"/>',
  valuation: '<path d="M20.6 13.4l-7.2 7.2a2 2 0 0 1-2.8 0L2 12V2h10l8.6 8.6a2 2 0 0 1 0 2.8z"/><path d="M7 7h.01"/>',
  ipo: '<path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/>',
};
const sprite = Object.entries(ICONS).map(([k, p]) => `<symbol id="di-${k}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${p}</symbol>`).join('')
  + [...new Set(flags)].map(flagSymbol).join('');
---
<svg class="glyphs" aria-hidden="true" focusable="false" set:html={sprite} />
<style>.glyphs{position:absolute;width:0;height:0;overflow:hidden}</style>
