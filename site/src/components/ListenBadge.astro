---
// Official "listen on" badge for a podcast platform.
// Spotify: official full logo (icon + wordmark), monochrome per Spotify's brand rules
// (white on the dark theme, black on the light theme; our backgrounds aren't pure
// black/white, so the green version isn't allowed). Min width 70px, clear space = half
// the icon height. Files: /public/brands/ (unaltered, from developer.spotify.com/documentation/design).
// Apple: add the badge from Apple's marketing tools once the show is live on Apple.
interface Props { platform: 'spotify'; href: string; lang: string }
const { platform, href, lang } = Astro.props;
const label = lang === 'de' ? 'Auf Spotify anhören' : 'Listen on Spotify';
---
{platform === 'spotify' && href && href !== '#' && (
  <a class="lb" href={href} target="_blank" rel="noopener" aria-label={label} title={label} data-umami-event="listen-spotify">
    <img class="lb-dark" src="/brands/spotify-full-white.svg" alt="Spotify" width="81" height="22" loading="lazy" decoding="async" />
    <img class="lb-light" src="/brands/spotify-full-black.svg" alt="" aria-hidden="true" width="81" height="22" loading="lazy" decoding="async" />
  </a>
)}
<style>
  .lb{display:inline-flex;align-items:center;justify-content:center;padding:11px 16px;border:1px solid var(--line);border-radius:999px;text-decoration:none;line-height:0;transition:border-color .15s ease}
  .lb:hover{border-color:var(--accent)}
  .lb img{height:22px;width:auto;display:block}
  .lb-light{display:none !important}
  :global(:root[data-theme="light"]) .lb-dark{display:none !important}
  :global(:root[data-theme="light"]) .lb-light{display:block !important}
  @media (prefers-color-scheme: light){
    :global(:root:not([data-theme="dark"])) .lb-dark{display:none !important}
    :global(:root:not([data-theme="dark"])) .lb-light{display:block !important}
  }
</style>
