---
// Geist is self-hosted (fontsource), never loaded from Google's servers: embedding
// Google Fonts sends visitor IPs to Google, which German courts have ruled a GDPR breach.
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SiteSchema from '../components/SiteSchema.astro';
import { ANALYTICS } from '../config/analytics';
import { type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  active?: string;
  altPath?: string; // same page in the other language → hreflang
  image?: string;   // social card image (path or absolute); defaults to the brand cover
  ogType?: string;  // 'website' (default) | 'article'
  noindex?: boolean; // true → <meta robots noindex,follow> (page stays crawlable, leaves the index)
  monolingual?: boolean; // true → page exists in this language only: no hreflang pair, x-default is itself
}
const { lang, title, description = '', active, altPath, image = '/podcast-cover.png', ogType = 'website', noindex = false, monolingual = false } = Astro.props;
const other = lang === 'en' ? 'de' : 'en';
const path = Astro.url.pathname;
const otherPath = altPath ?? path.replace(`/${lang}`, `/${other}`);
// x-default must resolve to the ENGLISH page. Deriving it by swapping the
// locale segment (`/de/...` → `/en/...`) only works while both languages share
// a slug — it breaks the moment a route localizes its path, e.g. the roundups
// at /en/best/wearables/ vs /de/beste/fitness-tracker/, where the naive swap
// produced /en/beste/fitness-tracker/ and 404'd. Take the EN side of the pair.
const enPath = monolingual || lang === 'en' ? path : otherPath;
const canonical = new URL(path, Astro.site).toString();
const ogImage = new URL(image, Astro.site).toString();
const ogLocale = lang === 'de' ? 'de_DE' : 'en_US';
// Impact.com site verification uses a `value` attribute (not the standard
// `content`); spread it through a loose record so `astro check` accepts the
// non-standard attribute without altering the rendered output.
const impactVerify: Record<string, string> = { value: '7dbbad87-cd73-480d-971c-71433cf944e6' };
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <!-- Apply a saved light/dark choice before first paint (no flash). See Header.astro. -->
  <script is:inline>document.documentElement.classList.add('js');try{var s=localStorage.getItem('sqwod_theme');if(s==='light'||s==='dark')document.documentElement.setAttribute('data-theme',s)}catch(e){}</script>
  <link rel="preload" href="/fonts/anton-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
  <meta name="impact-site-verification" {...impactVerify} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  {noindex && <meta name="robots" content="noindex,follow" />}
  {ANALYTICS.src && ANALYTICS.websiteId && (
    <script defer src={ANALYTICS.src} data-website-id={ANALYTICS.websiteId}></script>
  )}
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang={lang} href={canonical} />
  {!monolingual && <link rel="alternate" hreflang={other} href={new URL(otherPath, Astro.site).toString()} />}
  <link rel="alternate" hreflang="x-default" href={new URL(enPath, Astro.site).toString()} />

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="sqwod.life" />
  <meta property="og:locale" content={ogLocale} />
  <meta property="og:locale:alternate" content={other === 'de' ? 'de_DE' : 'en_US'} />
  <meta property="og:title" content={title} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  {image.startsWith('/og/') && <><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:type" content="image/png" /></>}
  <meta property="og:image:alt" content="Sqwod" />

  <!-- Twitter / X card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  {description && <meta name="twitter:description" content={description} />}
  <meta name="twitter:image" content={ogImage} />

  <!-- Sitewide entity graph (Organization + WebSite + Person). Page-level
       JSON-LD injected via the head slot below can reference these by @id. -->
  <SiteSchema lang={lang} />

  <slot name="head" />
</head>
<body>
  <Header lang={lang} active={active} altPath={otherPath} />
  <main class="wrap">
    <slot />
  </main>
  <Footer lang={lang} />
  <script is:inline>
    // Motion (Oct 2026 redesign): reveal .rv blocks as they scroll in, count up [data-count]
    // numbers once. Reduced-motion readers get the final state at once.
    (function () {
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var count = function (el) {
        if (el.dataset.counted) return; el.dataset.counted = '1';
        var txt = el.textContent, m = txt.match(/^(\D*?)(\d[\d.,]*)(.*)$/);
        if (!m || reduce) return;
        var raw = m[2], dec = 0, sep = '';
        var dm = raw.match(/[.,](\d{1,2})$/);
        if (dm && !(raw.length > 4 && dm[1].length === 3)) { dec = dm[1].length; sep = raw.charAt(raw.length - dec - 1); }
        var thou = dec ? (sep === ',' ? '.' : ',') : ((raw.match(/[.,]/) || [''])[0]);
        var target = dec ? parseFloat(raw.split(thou).join('').replace(sep, '.')) : parseFloat(raw.replace(/[.,]/g, ''));
        if (!isFinite(target)) return;
        var t0 = null, dur = 1100;
        var fmt = function (v) {
          var s = v.toFixed(dec), parts = s.split('.');
          if (thou && raw.indexOf(thou) >= 0) parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, thou);
          return parts.join(sep || '.');
        };
        var step = function (ts) {
          if (!t0) t0 = ts; var k = Math.min(1, (ts - t0) / dur), e = 1 - Math.pow(1 - k, 3);
          el.textContent = m[1] + fmt(target * e) + m[3];
          if (k < 1) requestAnimationFrame(step); else el.textContent = txt;
        };
        requestAnimationFrame(step);
      };
      var els = document.querySelectorAll('.rv, [data-count]');
      if (!('IntersectionObserver' in window) || reduce) { els.forEach(function (el) { el.classList.add('in'); }); return; }
      var io = new IntersectionObserver(function (es) {
        es.forEach(function (e) {
          if (!e.isIntersecting) return;
          e.target.classList.add('in');
          if (e.target.hasAttribute('data-count')) count(e.target);
          e.target.querySelectorAll && e.target.querySelectorAll('[data-count]').forEach(count);
          io.unobserve(e.target);
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
      els.forEach(function (el) { io.observe(el); });
    })();
    // One-click copy on every prose code block (e.g. the AI prompts).
    document.querySelectorAll('.prose pre').forEach(function (pre) {
      if (pre.querySelector('.copy-code')) return;
      var btn = document.createElement('button');
      btn.type = 'button'; btn.className = 'copy-code'; btn.textContent = 'Copy';
      btn.addEventListener('click', function () {
        var code = pre.querySelector('code') || pre;
        navigator.clipboard.writeText(code.innerText).then(function () {
          btn.textContent = 'Copied ✓'; btn.classList.add('done');
          setTimeout(function () { btn.textContent = 'Copy'; btn.classList.remove('done'); }, 1600);
        }).catch(function () {});
      });
      pre.appendChild(btn);
    });
  </script>
</body>
</html>
