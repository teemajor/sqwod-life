---
import Base from '../../../layouts/Base.astro';
import Glyph from '../../../components/Glyph.astro';
import { getCollection } from 'astro:content';
import { languages, type Lang } from '../../../i18n/ui';
import { pillarGlyph } from '../../../i18n/pillars';
import { TOPICS, EVIDENCE_TOPICS } from '../../../config/topics';

export function getStaticPaths() { return languages.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;

const title = lang === 'de'
  ? 'Studienlage zu Supplements und Training für Coaches | Sqwod Evidence'
  : 'Supplement and Training Research for Coaches | Sqwod Evidence';
const description = lang === 'de'
  ? 'Was die Studienlage zu Supplements, Training, Ernährung, Recovery und Wearables sagt: bewertet, mit Quellen, plus das Skript für deine Kunden.'
  : 'What the research says on supplements, training, nutrition, recovery and wearables: graded, sourced, with the script for your clients.';

// The series = any article marked type: evidence. Stays in its own lane for the
// funnel; this hub unifies them by the evidence tag.
const pieces = (await getCollection('articles', (a) =>
  a.data.lang === lang && a.data.type === 'evidence'))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const pieceHref = (a: any) => `/${lang}/analysis/${a.data.urlSlug}`;
// Grouped by Evidence topic chip (27 Oct 2026); anything untagged goes last.
const groups = [...EVIDENCE_TOPICS.map((k) => ({ k, label: TOPICS[k].label[lang], items: pieces.filter((p) => p.data.topic === k) })),
  { k: 'other', label: lang === 'de' ? 'Weitere' : 'More', items: pieces.filter((p) => !p.data.topic || !EVIDENCE_TOPICS.includes(p.data.topic)) }]
  .filter((g) => g.items.length);
const fmtDate = (d: Date) => d.toISOString().slice(0, 10);
---
<Base lang={lang} title={title} description={description} active="evidence">
  <div class="pagehead">
    <div class="crumb">Sqwod Evidence</div>
    <h1>Sqwod Evidence</h1>
    <p class="sub">{lang==='de'
      ? 'Wir lesen die Forschung, damit deine Kunden es nicht müssen. Jede Aussage ist an eine benannte Studie geknüpft, nach Studienqualität bewertet und trägt einen echten Namen: plus, was gerade erst erforscht wird.'
      : 'We read the research so your clients don’t have to. Every claim tied to a named study, graded by strength of evidence, signed by a real name: plus what’s still being tested.'}</p>
    <p style="margin-top:10px;display:flex;flex-wrap:wrap;gap:8px 20px">
      <a class="cardcta" href={`/${lang}/evidence/supplements`}>{lang==='de'?'Supplements von A bis Z':'Supplements A to Z'} →</a>
      <a class="cardcta" href={`/${lang}/evidence/methodology`}>{lang==='de'?'Wie wir bewerten':'How we grade the evidence'} →</a>
    </p>
  </div>

  <nav class="ev-chips" aria-label={lang==='de'?'Themen':'Topics'}>
    {groups.map((g) => <a href={`#${g.k}`}>{g.label} · {g.items.length}</a>)}
  </nav>

  {groups.map((g, gi) => (
    <section class="block" id={g.k} style={gi === 0 ? 'border-top:1px solid var(--line);margin-top:8px' : ''}>
      <p class="kick">{g.label}{g.k === 'supplements' && <Fragment> · <a class="ev-hub" href={`/${lang}/evidence/supplements`}>{lang==='de'?'Alle von A bis Z':'All from A to Z'} →</a></Fragment>}</p>
      <div class="grid cols2">
      {g.items.map((a) => (
        <a class="card" style="grid-template-columns:52px 1fr" href={pieceHref(a)}>
          <Glyph kind={a.data.hero ? (a.data.hero.kind === 'orbit' ? 'ring' : a.data.hero.kind) : pillarGlyph(a.data.pillar)} size={52} />
          <div class="info">
            <span class="bestfor">{lang==='de'?'Evidenz':'Evidence'} · {fmtDate(a.data.updatedAt)}</span>
            <h3>{a.data.title}</h3>
            <div class="meta">{a.data.description}</div>
            <span class="cardcta">{lang==='de'?'Lesen':'Read'} →</span>
          </div>
        </a>
      ))}
      </div>
    </section>
  ))}
  {pieces.length === 0 && <p class="meta">{lang==='de'?'Bald mehr.':'More soon.'}</p>}

  <section class="block">
    <div class="note"><b>{lang==='de'?'Ein Supplement im Blick?':'Shopping a supplement?'}</b> {lang==='de'
      ? 'Die Evidenz sagt dir, was wirkt. Sqwod Verified sagt dir, welches Produkt.'
      : 'The evidence tells you what works. Sqwod Verified tells you which product to buy.'} <a class="cardcta" href={`/${lang}/verified`}>{lang==='de'?'Zu Sqwod Verified':'Browse Sqwod Verified'} →</a></div>
  </section>
</Base>

<style>
  .ev-chips{display:flex;flex-wrap:wrap;gap:8px;padding:10px 0 4px}
  .ev-chips a{font-size:13px;font-weight:600;color:var(--g1);text-decoration:none;border:1px solid var(--line);border-radius:999px;padding:6px 12px}
  .ev-chips a:hover,.ev-chips a:focus-visible{border-color:var(--chalk);color:var(--chalk)}
  .ev-hub{color:var(--chalk);text-decoration:none;letter-spacing:.06em}
  section.block[id]{scroll-margin-top:90px}
</style>
