---
// Sqwod Jobs (Germany): open roles in German fitness and wellness, updated every Friday,
// pay shown whenever the employer lists it. Data: automation/jobs.mjs -> src/data/jobs.json
// (src/lib/jobs.ts). Filter state is readable from the URL (?city=berlin&type=trainer&pay=1&q=…),
// so city landing links work before city pages exist.
import Base from '../../../layouts/Base.astro';
import InlineSignup from '../../../components/InlineSignup.astro';
import { languages, type Lang } from '../../../i18n/ui';
import { liveJobs, hasPay, jobsEdition, jobsGeneratedAt, brandOf, payMonthly, type Job } from '../../../lib/jobs';
import { JOBS_JSONLD_ON_LIST } from '../../../config/seo.mjs';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const de = lang === 'de';
const loc = de ? 'de-DE' : 'en-GB';
const jobs = liveJobs();

const T = de ? {
  title: 'Sqwod Jobs: Fitness- und Wellness-Jobs in Deutschland, mit Gehalt',
  h1: 'Fitness- und Wellness-Jobs in Deutschland.',
  sub: 'Jede offene Stelle, die wir finden, jeden Freitag aktualisiert. Gehalt immer dann, wenn der Arbeitgeber es angibt.',
  updated: 'Aktualisiert', open: 'offene Stellen',
  sRoles: 'Offene Stellen', sPay: 'mit Gehaltsangabe', sCities: 'Städte', sEmployers: 'Arbeitgeber',
  alertHead: 'Neue Fitness-Jobs jeden Freitag', alertBody: 'Eine Mail pro Woche, nur Deutschland, mit Gehalt, wenn wir es haben.', alertBtn: 'Jobs-Alert abonnieren',
  all: 'Alle', other: 'Andere Städte', remote: 'Remote', type: 'Bereich', payOnly: 'Nur mit Gehalt', search: 'Stelle oder Arbeitgeber suchen …', shown: 'Stellen angezeigt',
  noPay: 'Gehalt nicht angegeben', apply: 'Bewerben', newTab: 'öffnet in neuem Tab', nationwide: 'bundesweit', filters: 'Filter', city: 'Stadt', via: 'Quelle', none: 'Keine Stelle passt zu diesen Filtern.',
  showResults: 'Stellen anzeigen', close: 'Schließen', more: 'Alle anzeigen', less: 'Weniger anzeigen', clear: 'Alle Filter löschen', count: 'Stellen', employment: 'Anstellung', posted: 'Veröffentlicht', employer: 'Arbeitgeber', pay: 'Gehalt', last7: 'Letzte 7 Tage', last30: 'Letzte 30 Tage',
  sort: 'Sortieren', sorts: { default: 'Mit Gehalt zuerst', new: 'Neueste zuerst', pay: 'Höchstes Gehalt zuerst', az: 'Arbeitgeber A bis Z' } as Record<string, string>,
  empty: 'Die erste Liste erscheint nach dem ersten wöchentlichen Lauf. Trag dich ein, dann bekommst du sie am Freitag als Erste:r.',
  per: { hour: 'Std.', month: 'Monat', year: 'Jahr' } as Record<string, string>,
  emp: { 'full-time': 'Vollzeit', 'part-time': 'Teilzeit', freelance: 'Freiberuflich', 'mini-job': 'Minijob', unknown: '' } as Record<string, string>,
  types: { trainer: 'Trainer:in', coach: 'Coach', 'studio-manager': 'Studioleitung', sales: 'Vertrieb', marketing: 'Marketing', 'product-tech': 'Produkt & Tech', ops: 'Betrieb & Service', apprenticeship: 'Ausbildung & duales Studium', other: 'Sonstiges' } as Record<string, string>,
  method: 'So entsteht die Liste',
  methodBody: [
    'Quellen: die Jobsuche der Bundesagentur für Arbeit, Adzuna, die Karriereseiten von Fitness- und Wellness-Marken, die DSSV-Jobbörse und Fitt Insider (nur Remote-Stellen, die Deutschland erlauben).',
    'Doppelte Anzeigen führen wir zusammen und behalten die Version mit Gehalt.',
    'Gehalt steht so da, wie der Arbeitgeber es angibt. Brutto und netto rechnen wir nicht um.',
    'Eine Stelle verschwindet, wenn wir sie 21 Tage lang nicht mehr finden.',
  ],
} : {
  title: 'Sqwod Jobs: fitness and wellness jobs in Germany, with pay',
  h1: 'Fitness and wellness jobs in Germany.',
  sub: 'Every open role we can find, updated every Friday. Pay shown whenever the employer lists it.',
  updated: 'Updated', open: 'open roles',
  sRoles: 'Open roles', sPay: 'with pay listed', sCities: 'Cities', sEmployers: 'Employers',
  alertHead: 'New fitness jobs every Friday', alertBody: 'One email a week, Germany only, pay listed when we have it.', alertBtn: 'Get the jobs alert',
  all: 'All', other: 'Other cities', remote: 'Remote', type: 'Area', payOnly: 'Pay listed', search: 'Search a role or employer…', shown: 'roles shown',
  noPay: 'Pay not listed', apply: 'Apply', newTab: 'opens in a new tab', nationwide: 'Germany-wide', filters: 'Filters', city: 'City', via: 'Source', none: 'No role matches these filters.',
  showResults: 'Show roles', close: 'Close', more: 'Show all', less: 'Show fewer', clear: 'Clear all filters', count: 'roles', employment: 'Employment', posted: 'Posted', employer: 'Employer', pay: 'Pay', last7: 'Last 7 days', last30: 'Last 30 days',
  sort: 'Sort', sorts: { default: 'Pay listed first', new: 'Newest first', pay: 'Highest pay first', az: 'Employer A to Z' } as Record<string, string>,
  empty: 'The first list goes up after the first weekly run. Sign up and get it first, on Friday.',
  per: { hour: 'hour', month: 'month', year: 'year' } as Record<string, string>,
  emp: { 'full-time': 'Full-time', 'part-time': 'Part-time', freelance: 'Freelance', 'mini-job': 'Mini-job', unknown: '' } as Record<string, string>,
  types: { trainer: 'Trainer', coach: 'Coach', 'studio-manager': 'Studio manager', sales: 'Sales', marketing: 'Marketing', 'product-tech': 'Product & tech', ops: 'Operations & service', apprenticeship: 'Apprenticeship & dual study', other: 'Other' } as Record<string, string>,
  method: 'How the list is built',
  methodBody: [
    'Sources: the Federal Employment Agency job search (Bundesagentur für Arbeit), Adzuna, the careers pages of fitness and wellness brands, the DSSV job board and Fitt Insider (remote roles open to Germany only).',
    'Duplicate ads are merged; we keep the version with pay.',
    'Pay is shown as the employer states it. Gross and net are not converted.',
    'A role drops off when we have not found it for 21 days.',
  ],
};
const SOURCE: Record<string, string> = { ba: 'Bundesagentur für Arbeit', adzuna: 'Adzuna', 'career-page': de ? 'Karriereseite' : 'Careers page', dssv: 'DSSV', fitt: 'Fitt Insider' };
// city chips: label, URL slug, region value in the data
const CITIES: [string, string, string][] = [['Berlin', 'berlin', 'Berlin'], ['Hamburg', 'hamburg', 'Hamburg'], ['München', 'muenchen', 'München'], ['Köln', 'koeln', 'Köln'], ['Frankfurt', 'frankfurt', 'Frankfurt'], [T.other, 'other', 'Other DE'], [T.remote, 'remote', 'Remote DE']];
const citySlug = (r: string) => (CITIES.find((c) => c[2] === r) || ['', 'other'])[1];
const types = Object.keys(T.types).filter((k) => jobs.some((j) => j.type === k));
const count = (f: (j: Job) => boolean) => jobs.filter(f).length;
const employments = ['full-time', 'part-time', 'freelance', 'mini-job'].filter((e) => jobs.some((j) => j.employment === e));
const sources = Object.keys(SOURCE).filter((k) => jobs.some((j) => j.source === k));
const today = jobsEdition || jobsGeneratedAt || new Date().toISOString().slice(0, 10);
const daysOld = (j: Job) => Math.round((Date.parse(today + 'T12:00:00Z') - Date.parse((j.postedAt || j.seenAt) + 'T12:00:00Z')) / 86400000);
const postedBucket = (j: Job) => { const d = daysOld(j); return d <= 7 ? '7 30' : d <= 30 ? '30' : ''; };
const brands = new Map<string, { b: ReturnType<typeof brandOf>; n: number }>();
for (const j of jobs) { const b = brandOf(j); if (!b.key) continue; const cur = brands.get(b.key); if (cur) cur.n++; else brands.set(b.key, { b, n: 1 }); }
const employerRows = [...brands.values()].sort((a, b) => b.n - a.n || a.b.short.localeCompare(b.b.short, loc));

const fmtDate = (d: string, opts: Intl.DateTimeFormatOptions = { day: 'numeric', month: 'short' }) => new Date(d + 'T12:00:00Z').toLocaleDateString(loc, { ...opts, timeZone: 'UTC' });
const eur = (n: number) => (de ? `${n.toLocaleString(loc, { maximumFractionDigits: 2 })} €` : `€${n.toLocaleString(loc, { maximumFractionDigits: 2 })}`);
function pay(j: Job) {
  if (!hasPay(j)) return null;
  const a = j.payMin != null ? eur(j.payMin) : null, b = j.payMax != null ? eur(j.payMax) : null;
  const amt = a && b && a !== b ? `${a}–${b}` : a && b ? a : a ? `${de ? 'ab' : 'from'} ${a}` : `${de ? 'bis' : 'up to'} ${b}`;
  return j.payPeriod ? `${amt} / ${T.per[j.payPeriod]}` : amt;
}
// gross or net as the ad says it (never converted)
const basis = (j: Job) => (/netto|\bnet\b/i.test(j.payText || '') ? (de ? 'netto' : 'net') : /brutto|\bgross\b/i.test(j.payText || '') ? (de ? 'brutto' : 'gross') : null);
const summary = (j: Job) => (de ? j.summaryDe : j.summaryEn) || null;

// stats, all from the live rows
const withPay = jobs.filter(hasPay).length;
const payPct = jobs.length ? Math.round((withPay / jobs.length) * 100) : 0;
const cities = new Set(jobs.filter((j) => j.region !== 'Remote DE').map((j) => (j.city || '').toLowerCase()).filter(Boolean)).size;
const employers = new Set(jobs.map((j) => (j.employer || '').toLowerCase()).filter(Boolean)).size;
const edition = jobsEdition || jobsGeneratedAt;

// JobPosting JSON-LD per row: switched off by default (see JOBS_JSONLD_ON_LIST in config/seo.mjs).
const EMP_SCHEMA: Record<string, string> = { 'full-time': 'FULL_TIME', 'part-time': 'PART_TIME', freelance: 'CONTRACTOR', 'mini-job': 'PART_TIME' };
const addDays = (d: string, n: number) => new Date(Date.parse(d + 'T12:00:00Z') + n * 86400000).toISOString().slice(0, 10);
const postings = !JOBS_JSONLD_ON_LIST ? [] : jobs.map((j) => ({
  '@context': 'https://schema.org', '@type': 'JobPosting', title: j.title,
  description: summary(j) || j.title, datePosted: j.postedAt || j.seenAt, validThrough: addDays(j.postedAt || j.seenAt, 30),
  hiringOrganization: { '@type': 'Organization', name: j.employer || 'Unknown', ...(j.employerSite ? { sameAs: j.employerSite } : {}) },
  ...(j.region === 'Remote DE'
    ? { jobLocationType: 'TELECOMMUTE', applicantLocationRequirements: { '@type': 'Country', name: 'DE' } }
    : { jobLocation: { '@type': 'Place', address: { '@type': 'PostalAddress', addressLocality: j.city, addressCountry: 'DE' } } }),
  ...(EMP_SCHEMA[j.employment] ? { employmentType: EMP_SCHEMA[j.employment] } : {}),
  ...(hasPay(j) && j.payPeriod ? { baseSalary: { '@type': 'MonetaryAmount', currency: 'EUR', value: { '@type': 'QuantitativeValue', unitText: j.payPeriod.toUpperCase(),
    ...(j.payMin != null && j.payMax != null && j.payMin !== j.payMax ? { minValue: j.payMin, maxValue: j.payMax } : { value: j.payMin ?? j.payMax }) } } } : {}),
  directApply: false, url: j.url,
}));
---
<Base lang={lang} title={T.title} description={T.sub} active="tools" noindex={jobs.length < 10}>
  {postings.map((p) => <script type="application/ld+json" set:html={JSON.stringify(p).replace(/</g, '\\u003c')} />)}
  <section class="jh">
    <div class="jh-l">
      <p class="kick jh-crumb"><a href={`/${lang}/tools/`}>Sqwod Tools</a> / Jobs</p>
      {edition && <p class="jh-live"><span class="pulse" aria-hidden="true"></span>{T.updated} {fmtDate(edition)} · {jobs.length.toLocaleString(loc)} {T.open}</p>}
      <h1 class="jh-h1">{T.h1}</h1>
      <p class="jh-sub">{T.sub}</p>
      {jobs.length > 0 && (
        <div class="jh-stats">
          <div><b class="dnum">{jobs.length.toLocaleString(loc)}</b><span>{T.sRoles}</span></div>
          <div><b class="dnum jh-acc">{withPay.toLocaleString(loc)}<small> · {payPct}%</small></b><span>{T.sPay}</span></div>
          <div><b class="dnum">{cities.toLocaleString(loc)}</b><span>{T.sCities}</span></div>
          <div><b class="dnum">{employers.toLocaleString(loc)}</b><span>{T.sEmployers}</span></div>
        </div>
      )}
    </div>
    <div class="jh-r">
      <InlineSignup lang={lang} source="jobs-alert" event="jobs-alert" id="jobs-alert" head={T.alertHead} body={T.alertBody} btn={T.alertBtn} />
    </div>
  </section>

  {jobs.length === 0 ? (
    <div class="note jb-empty">{T.empty}</div>
  ) : (
    <>
      <div class="fx" id="all-jobs" data-fx>
        <div class="fx-bar">
          <label class="dt-q">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
            <input type="search" placeholder={T.search} aria-label={T.search} autocomplete="off" enterkeyhint="search" data-q />
          </label>
          <button type="button" class="fx-open" data-fx-open aria-controls="fx-side" aria-expanded="false">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4" /></svg>{T.filters}<b data-fx-n hidden></b>
          </button>
          <span class="dt-sel fx-sort"><select aria-label={T.sort} data-sort>{Object.entries(T.sorts).map(([v, l]) => <option value={v}>{T.sort}: {l}</option>)}</select></span>
        </div>
        <p class="dt-count fx-count" aria-live="polite"><span><b data-shown>{jobs.length}</b> {T.count}</span><button type="button" class="dt-clear" data-clear hidden>{T.clear}</button></p>
        <ul class="fx-chips" data-fx-chips aria-label={T.filters}></ul>

        <aside class="fx-side" id="fx-side" data-fx-side aria-label={T.filters}>
          <div class="fx-side-head"><b>{T.filters}</b><button type="button" class="fx-x" data-fx-close aria-label={T.close}>×</button></div>
          <div class="fx-side-body">
            <details class="fx-g" open><summary>{T.city}</summary><div>
              {CITIES.filter((c) => jobs.some((j) => j.region === c[2])).map(([label, slug, region]) => <label class="fx-opt"><input type="checkbox" name="city" value={slug} /><span>{label}</span><i data-n>{count((j) => j.region === region)}</i></label>)}
            </div></details>
            <details class="fx-g" open><summary>{T.type}</summary><div>
              {types.map((k) => <label class="fx-opt"><input type="checkbox" name="type" value={k} /><span>{T.types[k]}</span><i data-n>{count((j) => j.type === k)}</i></label>)}
            </div></details>
            <details class="fx-g" open><summary>{T.pay}</summary><div>
              <label class="fx-opt"><input type="checkbox" name="pay" value="1" /><span>{T.payOnly}</span><i data-n>{withPay}</i></label>
            </div></details>
            <details class="fx-g"><summary>{T.employment}</summary><div>
              {employments.map((e) => <label class="fx-opt"><input type="checkbox" name="emp" value={e} /><span>{T.emp[e]}</span><i data-n>{count((j) => j.employment === e)}</i></label>)}
            </div></details>
            <details class="fx-g"><summary>{T.posted}</summary><div>
              <label class="fx-opt"><input type="radio" name="posted" value="7" /><span>{T.last7}</span><i data-n>{count((j) => daysOld(j) <= 7)}</i></label>
              <label class="fx-opt"><input type="radio" name="posted" value="30" /><span>{T.last30}</span><i data-n>{count((j) => daysOld(j) <= 30)}</i></label>
            </div></details>
            <details class="fx-g"><summary>{T.employer}</summary><div data-fx-more>
              {employerRows.map((r, k) => <label class="fx-opt" hidden={k >= 8}><input type="checkbox" name="employer" value={r.b.key} /><span>{r.b.logo ? <img class="fx-logo" src={r.b.logo} width="18" height="18" alt="" loading="lazy" /> : <i class="fx-mono" style={`--h:${r.b.hue}`}>{r.b.initials}</i>}{r.b.short}</span><i data-n>{r.n}</i></label>)}
              {employerRows.length > 8 && <button type="button" class="fx-more" data-fx-toggle data-more={T.more} data-less={T.less}>{T.more} ({employerRows.length})</button>}
            </div></details>
            <details class="fx-g"><summary>{T.via}</summary><div>
              {sources.map((k) => <label class="fx-opt"><input type="checkbox" name="src" value={k} /><span>{SOURCE[k]}</span><i data-n>{count((j) => j.source === k)}</i></label>)}
            </div></details>
          </div>
          <div class="fx-side-foot"><button type="button" class="dt-clear" data-clear>{T.clear}</button><button type="button" class="ih-cta fx-show" data-fx-close><span data-shown-2>{jobs.length}</span>&nbsp;{T.showResults}</button></div>
        </aside>
        <div class="fx-veil" data-fx-veil data-fx-close hidden></div>

        <ul class="jb-list">
          {jobs.map((j) => { const b = brandOf(j); return (
            <li class="jb" data-city={citySlug(j.region)} data-type={j.type || 'other'} data-pay={hasPay(j) ? '1' : '0'} data-emp={j.employment} data-posted={postedBucket(j)} data-employer={b.key} data-src={j.source}
              data-date={(j.postedAt || j.seenAt).replace(/-/g, '')} data-paym={payMonthly(j) ?? ''} data-az={b.short.toLowerCase()} data-name={`${j.title} ${j.employer || ''} ${b.short} ${j.city || ''}`.toLowerCase()}>
              <div class="jb-logo" aria-hidden="true">{b.logo ? <img src={b.logo} width="44" height="44" alt="" loading="lazy" decoding="async" /> : <span class="jb-mono" style={`--h:${b.hue}`}>{b.initials}</span>}</div>
              <div class="jb-main">
                <h2 class="plain jb-t">{j.title}</h2>
                <p class="jb-meta"><b title={b.name !== b.short ? b.name : undefined}>{b.short}</b>{[j.region === 'Remote DE' ? T.remote : /^(deutschland|germany)$/i.test(j.city || '') ? T.nationwide : j.city, T.emp[j.employment]].filter(Boolean).map((x) => <span>{x}</span>)}</p>
                {summary(j) && <p class="jb-sum">{summary(j)}</p>}
                <p class="jb-src">{T.via}: {SOURCE[j.source] || j.source}{(j.postedAt || j.seenAt) && <> · {fmtDate(j.postedAt || j.seenAt)}</>}</p>
              </div>
              <div class="jb-side">
                {pay(j) ? <span class="jb-payw"><span class="dnum jb-payv" title={j.payText || undefined}>{pay(j)}</span>{basis(j) && <span class="jb-basis">{basis(j)}</span>}</span> : <span class="jb-nopay">{T.noPay}</span>}
                <a class="jb-apply" href={j.url} rel="nofollow noopener" target="_blank" aria-label={`${T.apply}: ${j.title} (${T.newTab})`} data-umami-event="job-apply" data-umami-event-source={j.source}>{T.apply} ↗</a>
              </div>
            </li>
          ); })}
          <li class="dt-none" data-none hidden>{T.none}<button type="button" class="dt-clear" data-clear>{T.clear}</button></li>
        </ul>
      </div>
    </>
  )}

  <section class="note jb-method">
    <b>{T.method}</b>
    <ul>{T.methodBody.map((l) => <li>{l}</li>)}</ul>
  </section>
</Base>

<style>
  .jh{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);gap:40px;align-items:start;margin:0 0 8px}
  .jh-crumb{margin:0 0 14px}
  .jh-crumb a{color:inherit;text-decoration:none}
  .jh-crumb a:hover{color:var(--chalk);text-decoration:underline}
  .jh-live{display:inline-flex;align-items:center;gap:9px;margin:0 0 18px;padding:6px 13px;border:1px solid var(--accent-line);border-radius:999px;background:var(--accent-soft);font-size:13px;font-weight:600;color:var(--chalk)}
  .jh-live .pulse{box-shadow:0 0 8px 2px var(--accent-line)}
  .jh-h1{font-size:76px;line-height:.95;margin:0;hyphens:manual}
  .jh-sub{margin:18px 0 0;font-size:17px;line-height:1.5;color:var(--g2);max-width:58ch}
  .jh-stats{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:24px 0 0}
  .jh-stats div{border:1px solid var(--line);border-radius:14px;background:var(--panel);padding:14px 14px 12px;min-width:0}
  .jh-stats b{display:block;font-size:46px;color:var(--chalk);white-space:nowrap}
  .jh-stats b small{font-size:.5em}
  .jh-stats span{display:block;font-size:13px;color:var(--g2);margin-top:6px}
  .jh-stats .jh-acc{color:var(--accent)}
  .jh-r :global(.isu){margin:0}
  .jb-empty{margin-top:28px}
  /* faceted filter: same pattern as the Investor Map (sidebar on desktop, sheet on phones) */
  .fx{position:relative;display:grid;grid-template-columns:230px minmax(0,1fr);grid-template-areas:"bar bar" "count count" "chips chips" "side list";column-gap:22px;margin:30px 0 0;scroll-margin-top:16px}
  .fx-bar{grid-area:bar;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px}
  .fx-open{display:none}
  .dt-q,.dt-sel{position:relative;display:block;min-width:0}
  .dt-q svg{position:absolute;left:13px;top:50%;width:16px;height:16px;transform:translateY(-50%);color:var(--g2);pointer-events:none}
  .dt-sel::after{content:"";position:absolute;right:14px;top:50%;width:7px;height:7px;border-right:1.5px solid var(--g2);border-bottom:1.5px solid var(--g2);transform:translateY(-70%) rotate(45deg);pointer-events:none}
  .fx-bar input,.fx-bar select{width:100%;box-sizing:border-box;border:1px solid var(--line);background:var(--panel);color:var(--chalk);border-radius:10px;padding:9px 11px;font:inherit;font-size:14px;min-height:42px}
  .fx-bar input{padding-left:38px}
  .fx-bar select{appearance:none;-webkit-appearance:none;padding-right:34px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .fx-bar input:focus-visible,.fx-bar select:focus-visible,.fx-open:focus-visible,.dt-clear:focus-visible,.fx-more:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
  .dt-count{grid-area:count;display:flex;align-items:center;justify-content:space-between;gap:12px;font-size:12px;color:var(--g2);margin:8px 0 0}
  .dt-count b{font-weight:600;color:var(--chalk)}
  .dt-clear{border:0;background:none;padding:8px 0;margin:-8px 0;font:inherit;font-size:12px;font-weight:600;color:var(--chalk);text-decoration:underline;text-underline-offset:3px;cursor:pointer}
  .dt-clear:hover{color:var(--accent)}
  .dt-clear[hidden]{display:none}
  .fx-chips{grid-area:chips;list-style:none;margin:8px 0 0;padding:0;display:flex;flex-wrap:wrap;gap:6px}
  .fx-chips:empty{display:none}
  .fx-chips :global(button){display:inline-flex;align-items:center;gap:6px;min-height:30px;padding:0 10px;border:1px solid var(--accent-line);background:var(--accent-soft);color:var(--chalk);border-radius:999px;font:inherit;font-size:12.5px;cursor:pointer}
  .fx-chips :global(button::after){content:"×";font-size:15px;color:var(--g2)}
  .fx-chips :global(button:hover){border-color:var(--accent)}
