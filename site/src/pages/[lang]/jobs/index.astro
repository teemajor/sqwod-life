<script>
  import { initFacets } from '../../../lib/facets';
  const root = document.querySelector<HTMLElement>('[data-fx]');
  if (root) {
    // old city links used ?city=munich / köln etc.; map them onto the facet values
    const ALIAS: Record<string, string> = { munich: 'muenchen', 'münchen': 'muenchen', munchen: 'muenchen', cologne: 'koeln', 'köln': 'koeln', koln: 'koeln', 'frankfurt-am-main': 'frankfurt' };
    const u = new URLSearchParams(location.search); const c = u.get('city');
    if (c && ALIAS[c.toLowerCase()]) { u.set('city', ALIAS[c.toLowerCase()]); history.replaceState(null, '', location.pathname + '?' + u); }
    initFacets({
      root, rowSelector: '.jb', defaultSort: 'default',
      facets: [
        { name: 'city', mode: 'one' }, { name: 'type', mode: 'one' }, { name: 'pay', mode: 'flag' }, { name: 'emp', mode: 'one' },
        { name: 'posted', mode: 'many' }, { name: 'employer', mode: 'one' }, { name: 'src', mode: 'one' },
      ],
      sortKey: (el, k) => k === 'new' ? -Number(el.dataset.date || 0) : k === 'pay' ? -(Number(el.dataset.paym) || 0) : k === 'az' ? (el.dataset.az || '') : -(el.dataset.pay === '1' ? 1e9 : 0) - Number(el.dataset.date || 0),
    });
  }
</script>
