---
// Articles hub (27 Oct 2026): browse by topic chip, then the latest pieces.
// Evidence playbooks and data reports have their own nav sections, so they are
// not listed here.
import Base from '../../../layouts/Base.astro';
import Glyph from '../../../components/Glyph.astro';
import { getCollection } from 'astro:content';
import { languages, t, type Lang } from '../../../i18n/ui';
import { pillarGlyph } from '../../../i18n/pillars';
import { TOPICS, ARTICLE_TOPICS, topicLabel } from '../../../config/topics';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const de = lang === 'de';
const title = de ? 'Artikel für Studio- und Gym-Betreiber | Sqwod' : 'Articles for Gym and Studio Operators | Sqwod';

const articles = (await getCollection('articles', (a) =>
  a.data.lang === lang && a.data.type !== 'evidence' && a.data.format !== 'report' && a.data.format !== 'index'))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const count = (k: string) => articles.filter((a) => a.data.topic === k).length;
const topics = ARTICLE_TOPICS.filter((k) => count(k) > 0);
const recent = articles.slice(0, 12);
const href = (a: (typeof articles)[number]) => `/${lang}/analysis/${a.data.urlSlug}`;
---
<Base lang={lang} title={title} description={de ? 'Analysen für Coaches, Studio-Gründer:innen und Betreiber, nach Thema sortiert.' : 'Analysis for coaches, studio founders and operators, sorted by topic.'} active="articles">
  <div class="pagehead">
    <div class="crumb">{t(lang,'nav.articles')}</div>
    <h1>{de ? 'Artikel' : 'Articles'}</h1>
    <p class="sub">{de ? 'Analysen für Coaches, Studio-Gründer:innen und Betreiber. Wähle ein Thema.' : 'Analysis for coaches, studio founders and operators. Pick a topic.'}</p>
  </div>

  <section class="block" style="border-top:1px solid var(--line);margin-top:8px">
    <p class="kick">{de ? 'Themen' : 'Topics'}</p>
    <div class="grid cols3">
      {topics.map((k) => (
        <a class="card topic" href={`/${lang}/articles/${k}`}>
          <div class="info">
            <span class="bestfor">{`${count(k)} ${de ? 'Artikel' : (count(k) === 1 ? 'article' : 'articles')}`}</span>
            <h3>{TOPICS[k].label[lang]}</h3>
            <div class="meta">{TOPICS[k].desc[lang]}</div>
          </div>
        </a>
      ))}
    </div>
    <p class="meta" style="margin-top:14px">
      {de ? 'Studienlage zu Supplements und Training: ' : 'Research on supplements and training: '}<a class="cardcta" href={`/${lang}/evidence`}>Sqwod Evidence →</a>
      &nbsp; {de ? 'Marktdaten: ' : 'Market data: '}<a class="cardcta" href={`/${lang}/intelligence`}>Reports →</a>
    </p>
  </section>

  {recent.length > 0 && (
    <section class="block">
      <p class="kick">{de ? 'Neueste Artikel' : 'Latest articles'}</p>
      <div class="grid cols2">
      {recent.map((a) => (
        <a class="card" style="grid-template-columns:52px 1fr" href={href(a)}>
          <Glyph kind={a.data.hero ? (a.data.hero.kind === 'orbit' ? 'ring' : a.data.hero.kind) : pillarGlyph(a.data.pillar)} size={52} />
          <div class="info">
            {a.data.topic && <span class="bestfor">{topicLabel(a.data.topic, lang)}</span>}
            <h3>{a.data.title}</h3>
            <div class="meta">{a.data.description}</div>
            <span class="cardcta">{de ? 'Lesen' : 'Read'} →</span>
          </div>
        </a>
      ))}
      </div>
    </section>
  )}
</Base>

<style>
  .card.topic{grid-template-columns:1fr}
</style>
