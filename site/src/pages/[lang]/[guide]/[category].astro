---
// Sqwod Verified — "best of" roundups.  /en/best/<slug>  ·  /de/beste/<slug>
//
// The route is [lang]/[guide]/[category] rather than [lang]/best/[category] so
// the German prefix can be "beste" instead of "best". Astro ranks static path
// segments above dynamic ones, so /en/articles/move still resolves to
// [lang]/articles/[pillar] and /en/verified/x to [lang]/verified/[slug] — this
// route only ever builds the exact paths returned by getStaticPaths below.
//
// Everything numeric (score, sub-scores, price, 90-day low, confidence) is read
// live from the reviews collection at build time. Nothing is duplicated into
// config/best.ts, so a score change in a review flows straight through to the
// roundup, the table and the structured data with no second edit.
import Base from '../../../layouts/Base.astro';
import CategoryIcon from '../../../components/CategoryIcon.astro';
import ProductThumb from '../../../components/ProductThumb.astro';
import { getCollection } from 'astro:content';
import { languages, type Lang } from '../../../i18n/ui';
import { categories, byCategory } from '../../../config/verified-categories';
import { guides, GUIDE_PREFIX } from '../../../config/best';
import ScorePill from '../../../components/ScorePill.astro';
import { hasSubscription, formatPrice, type PriceValue } from '../../../lib/price';
import type { BestRole } from '../../../config/best';

export async function getStaticPaths() {
  return languages.flatMap((lang) =>
    guides
      // only build a guide if its category actually exists in Verified
      .filter((g) => categories.some((c) => c.slug === g.category))
      .map((g) => ({
        params: { lang, guide: GUIDE_PREFIX[lang], category: g.slug[lang] },
        props: { guideCategory: g.category },
      })),
  );
}

const lang = Astro.params.lang as Lang;
const other: Lang = lang === 'en' ? 'de' : 'en';
const guide = guides.find((g) => g.category === Astro.props.guideCategory)!;
const cat = byCategory(guide.category)!;
const de = lang === 'de';
const year = new Date().getFullYear();

// hreflang partner — localized on BOTH segments, driven by the same slug map.
const altPath = `/${other}/${GUIDE_PREFIX[other]}/${guide.slug[other]}/`;

// --- live data -------------------------------------------------------------
const reviews = await getCollection('reviews', (r) => r.data.lang === lang && !r.data.draft);
const dataFor = (slug?: string) => (slug ? reviews.find((r) => r.data.urlSlug === slug)?.data : undefined);

const scored = cat.picks
  .map((p) => ({ pick: p, r: dataFor(p.reviewSlug) }))
  .filter((x) => x.r) // a roundup ranks scored products only; editorial picks stay on the category page
  .sort((a, b) => b.r!.sqwodScore - a.r!.sqwodScore);

const top = scored[0];
const dateFmt = (d: Date) =>
  d.toLocaleDateString(de ? 'de-DE' : 'en-GB', { day: '2-digit', month: 'short', year: 'numeric' });

const lastUpdated = scored.length
  ? new Date(Math.max(...scored.map((s) => s.r!.updatedAt.getTime())))
  : new Date();

// --- families (1 Nov 2026) ------------------------------------------------
// Generation pairs (Oura Gen3 / Ring 5, Apple Watch 9 / 11 / 12 ...) collapse to one row. The
// highest score leads the row (ranking is by score only); a tie goes to the generation on sale.
// The other generations sit in a one-line note under it, linked to their reviews.
type Scored = { pick: (typeof cat.picks)[number]; r: NonNullable<ReturnType<typeof dataFor>> };
type Row = { head: Scored; others: Array<Scored & { rel: 'newer' | 'older' }> };
const fam = new Map<string, Scored[]>();
for (const x of scored as Scored[]) {
  const k = x.pick.family ?? x.pick.reviewSlug!;
  fam.set(k, [...(fam.get(k) ?? []), x]);
}
const rows: Row[] = [...fam.values()]
  .map((members) => {
    const sorted = [...members].sort((a, b) => b.r.sqwodScore - a.r.sqwodScore || (b.pick.current ? 1 : 0) - (a.pick.current ? 1 : 0));
    const head = sorted[0];
    const others = sorted.slice(1).map((o) => ({ ...o, rel: (o.pick.current && !head.pick.current ? 'newer' : 'older') as 'newer' | 'older' }));
    return { head, others };
  })
  .sort((a, b) => b.head.r.sqwodScore - a.head.r.sqwodScore);
const families = rows.length;

// --- money ------------------------------------------------------------------
// Whole euros on the guide (the review page keeps the cents) and a first-year figure
// that folds a required subscription in: "€394 + €70/yr" becomes "€464 first year".
const requiredSub = (v?: PriceValue) => hasSubscription(v) && !/optional/i.test(v!.subscription!);
const sticker = (v?: PriceValue) => (typeof v?.bestPrice !== 'number' ? null
  : formatPrice((v.priceType ?? 'oneoff') === 'oneoff' ? Math.round(v.bestPrice) : v.bestPrice, v.currency ?? 'EUR', lang, v.priceType ?? 'oneoff'));
const firstYear = (v?: PriceValue): number | null => {
  if (typeof v?.bestPrice !== 'number') return null;
  const t = v.priceType ?? 'oneoff';
  let total = t === 'monthly' ? v.bestPrice * 12 : v.bestPrice;
  if (t === 'oneoff' && requiredSub(v)) {
    const m = v.subscription!.match(/(\d+(?:[.,]\d+)?)\s*\/\s*(mo|month|monat|yr|year|jahr)/i);
    if (m) { const n = parseFloat(m[1].replace(',', '.')); total += /^(mo|month|monat)/i.test(m[2]) ? n * 12 : n; }
  }
  return Math.round(total);
};
const firstYearOf = (v?: PriceValue) => { const n = firstYear(v); return n === null ? null : formatPrice(n, v?.currency ?? 'EUR', lang, 'oneoff'); };
// filter value: the sticker price for a one-off buy, the yearly total for a subscription product
const priceForFilter = (v?: PriceValue) => (typeof v?.bestPrice !== 'number' ? 0 : (v.priceType ?? 'oneoff') === 'oneoff' ? Math.round(v.bestPrice) : firstYear(v) ?? 0);

// --- roles ("Our picks") ----------------------------------------------------
// Best overall is the top score. Each configured role takes the highest-scoring row that fits
// its rule and is not already used, so six roles give six different products.
const used = new Set<string>();
const fits = (row: Row, role: BestRole) =>
  (role.reviewSlug ? [row.head, ...row.others].some((x) => x.r.urlSlug === role.reviewSlug) : true) &&
  (role.kind ? row.head.pick.kind === role.kind : true) &&
  (role.maxPrice ? priceForFilter(row.head.r.value) > 0 && priceForFilter(row.head.r.value) <= role.maxPrice : true) &&
  (role.noSub ? !requiredSub(row.head.r.value) : true);
const pickFor = (row: Row, role: BestRole): Scored =>
  role.reviewSlug ? [row.head, ...row.others].find((x) => x.r.urlSlug === role.reviewSlug)! : row.head;
const roleCards: Array<{ role: BestRole; x: Scored }> = [];
if (rows[0]) {
  roleCards.push({ role: { key: 'overall', label: { en: 'Best overall', de: 'Beste insgesamt' } }, x: rows[0].head });
  used.add(rows[0].head.r.urlSlug);
}
for (const role of guide.roles ?? []) {
  const row = rows.find((rw) => fits(rw, role) && !used.has(pickFor(rw, role).r.urlSlug));
  if (!row) continue;
  const x = pickFor(row, role); used.add(x.r.urlSlug); roleCards.push({ role, x });
}
if (!guide.roles?.length && rows.length > 1) {
  // guides without configured roles: add the best score among the cheaper half
  const priced = rows.filter((rw) => priceForFilter(rw.head.r.value) > 0).sort((a, b) => priceForFilter(a.head.r.value) - priceForFilter(b.head.r.value));
  const cheap = priced.slice(0, Math.ceil(priced.length / 2)).sort((a, b) => b.head.r.sqwodScore - a.head.r.sqwodScore).find((rw) => !used.has(rw.head.r.urlSlug));
  if (cheap) roleCards.push({ role: { key: 'value', label: { en: 'Best value', de: 'Bestes Preis-Leistungs-Verhältnis' } }, x: cheap.head });
}

// --- lede ---------------------------------------------------------------------
// Taken from the top pick's own verdict, so it can never describe a product that no
// longer leads (the static guide ledes did exactly that and are gone).
const verdictLede = (() => {
  const v = top?.r?.verdict ?? '';
  // split only where a sentence really ends: punctuation, space, capital (so "1.43-inch" survives)
  const sentences = v.split(/(?<=[.!?])\s+(?=[A-ZÄÖÜ0-9"“])/);
  let out = ''; for (const sn of sentences) { if ((out + ' ' + sn).trim().length > 230 && out) break; out = (out + ' ' + sn).trim(); }
  return out;
})();

const kindFilters = guide.filters?.kinds?.filter((k) => rows.some((rw) => rw.head.pick.kind === k.key)) ?? [];
const maxPrice = guide.filters?.maxPrice;
const anySub = rows.some((rw) => requiredSub(rw.head.r.value));

const title = de
  ? `Beste ${guide.title.de} ${year}: ${families} Modelle bewertet`
  : `Best ${guide.title.en} ${year}: ${families} Picks, Scored 0–100`;

// --- structured data -------------------------------------------------------
// ItemList carries the full ranked list — rank, product, brand, URL, price and
// the Sqwod Score — so a single pass yields the whole answer. FAQPage mirrors
// the visible accordion below verbatim.
const base = 'https://sqwod.life';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    '@id': `${base}/${lang}/${GUIDE_PREFIX[lang]}/${guide.slug[lang]}/#itemlist`,
    name: title,
    description: guide.description[lang],
    url: `${base}/${lang}/${GUIDE_PREFIX[lang]}/${guide.slug[lang]}/`,
    numberOfItems: rows.length,
    itemListOrder: 'https://schema.org/ItemListOrderDescending',
    inLanguage: lang,
    itemListElement: rows.map(({ head: { pick, r } }, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: pick.bestFor[lang],
      item: {
        '@type': 'Product',
        name: r!.productName,
        brand: { '@type': 'Brand', name: pick.brand },
        url: `${base}/${lang}/verified/${r!.urlSlug}/`,
        ...(r!.asset.images[0] ? { image: r!.asset.images[0] } : {}),
        review: {
          '@type': 'Review',
          reviewRating: { '@type': 'Rating', ratingValue: r!.sqwodScore, bestRating: 100, worstRating: 0 },
          author: { '@id': `${base}/#organization` },
        },
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': `${base}/${lang}/${GUIDE_PREFIX[lang]}/${guide.slug[lang]}/#faq`,
    inLanguage: lang,
    mainEntity: guide.faq.map((f) => ({
      '@type': 'Question',
      name: f.q[lang],
      acceptedAnswer: { '@type': 'Answer', text: f.a[lang] },
    })),
  },
];

const tx = {
  picksKick: de ? 'Unsere Empfehlungen' : 'Our picks',
  glance: de ? 'Alle bewerteten Modelle' : 'Every scored model',
  howScore: de ? 'Wie wir bewerten' : 'How we score',
  before: de ? 'Was du vor dem Kauf wissen solltest' : 'What to know before buying',
  details: de ? 'Die Modelle im Detail' : 'The picks in detail',
  operator: de ? 'Für Trainer:innen und Studiobetreiber' : 'For coaches and studio owners',
  faq: de ? 'Häufige Fragen' : 'Frequently asked questions',
  related: de ? 'Weiterlesen' : 'Related',
  bestFor: de ? 'Am besten für' : 'Best for',
  score: 'Sqwod Score',
  price: de ? 'Preis' : 'Price',
  firstYear: de ? 'Erstes Jahr' : 'First year',
  low: de ? '90-Tage-Tief' : '90-day low',
  readReview: de ? 'Bewertung lesen' : 'Read review',
  bestDeal: de ? 'Bester Deal' : 'Best deal',
  updated: de ? 'Zuletzt geprüft' : 'Last verified',
  allIn: de ? 'Alle bewerteten Produkte der Kategorie' : 'Every scored product in this category',
  methodology: de ? 'Vollständige Methodik' : 'Full methodology',
  sub: de ? 'Abo' : 'Subscription',
  pros: de ? 'Dafür' : 'Pros',
  cons: de ? 'Dagegen' : 'Cons',
  buyIf: de ? 'Kaufen, wenn' : 'Buy it if',
  skipIf: de ? 'Überspringen, wenn' : 'Skip it if',
  newer: de ? 'Neuer' : 'Newer',
  older: de ? 'Älter' : 'Older',
  all: de ? 'Alle' : 'All',
  noSub: de ? 'Ohne Abo' : 'Subscription-free',
  noSubShort: de ? 'kein Abo' : 'no subscription',
  under: de ? 'Unter' : 'Under',
  shown: de ? 'angezeigt' : 'shown',
  noMatch: de ? 'Kein Modell passt zu dieser Auswahl.' : 'No model matches this selection.',
  jump: de ? 'Springe zu' : 'Jump to',
  scoreOnly: de
    ? 'Rangfolge nur nach Score. Provisionen ändern die Reihenfolge nie.'
    : 'Ranked by score only. Commission never changes the order.',
  firstYearNote: de
    ? 'Erstes Jahr = Preis plus zwölf Monate Pflicht-Abo. Optionale Abos zählen nicht.'
    : 'First year = price plus twelve months of any required subscription. Optional subscriptions are not counted.',
};
const jump = [
  ['picks', tx.picksKick], ['table', tx.glance], ['before', tx.before], ['details', tx.details], ['score', tx.howScore], ['faq', 'FAQ'],
];
const otherLine = (o: Row['others'][number]) =>
  `${o.rel === 'newer' ? tx.newer : tx.older}: ${o.r.productName}, ${o.r.sqwodScore}/100${sticker(o.r.value) ? `, ${sticker(o.r.value)}` : ''}`;
---
<Base
  lang={lang}
  title={title}
  description={guide.description[lang]}
  active="verified"
  ogType="article"
  altPath={altPath}
  image={top?.r?.asset.images[0] ?? '/podcast-cover.png'}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />

  <div class="crumb">Sqwod Verified / {cat.label[lang]}</div>

  <div style="display:flex;gap:16px;align-items:center;margin-top:6px">
    <CategoryIcon cat={cat.slug} size={56} />
    <h1 style="margin:0">{title}</h1>
  </div>

  <p class="byline">
    {de ? 'Bewertet von' : 'Scored by'} <a href={`/${lang}/about/`}>Tee Major</a>
    · {tx.updated} <b>{dateFmt(lastUpdated)}</b>
    · <span class="score-only">{tx.scoreOnly}</span>
  </p>

  {top && (
    <p class="lede">
      {de
        ? <>Für die meisten ist <b>{top.r!.productName}</b> die richtige Wahl: <b>{top.r!.sqwodScore}/100</b>, der höchste Wert der Kategorie{sticker(top.r!.value) ? <>, bei <b>{sticker(top.r!.value)}</b></> : null}. {verdictLede}</>
        : <>For most people the <b>{top.r!.productName}</b> is the right buy: <b>{top.r!.sqwodScore}/100</b>, the highest score in this category{sticker(top.r!.value) ? <>, at <b>{sticker(top.r!.value)}</b></> : null}. {verdictLede}</>}
    </p>
  )}

  <div class="disc">{de
    ? 'Wir erhalten unter Umständen eine Provision über Links auf dieser Seite. Der Sqwod Score und das Ranking bleiben davon unberührt.'
    : 'We may earn a commission from links on this page. It never affects the Sqwod Score or the ranking.'}</div>

  <nav class="jump" aria-label={tx.jump}>
    {jump.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
  </nav>

  <!-- ----------------------------------------------------------- our picks -->
  <section class="block" id="picks">
    <p class="kick">{tx.picksKick}</p>
    <div class="roles">
      {roleCards.map(({ role, x }, i) => (
        <article class:list={['role', { 'role-top': i === 0 }]}>
          <p class="role-label">{role.label[lang]}</p>
          <div class="role-head">
            <ProductThumb src={x.r.asset.images[0]} alt={x.r.productName} cat={cat.slug} size={i === 0 ? 120 : 64} eager={i === 0} />
            <div class="role-body">
              <h2><a href={`/${lang}/verified/${x.r.urlSlug}/`}>{x.r.productName}</a></h2>
              <div class="role-meta">
                <ScorePill score={x.r.sqwodScore} lang={lang} size={i === 0 ? 'lg' : 'sm'} />
                {sticker(x.r.value) ? <span class="rm-price"><b>{sticker(x.r.value)}</b>{requiredSub(x.r.value) && firstYearOf(x.r.value) ? <small> · {tx.firstYear} {firstYearOf(x.r.value)}</small> : null}</span> : null}
              </div>
              <p class="role-why">{role.why?.[lang] ?? x.pick.why[lang]}</p>
            </div>
          </div>
          <div class="tp-cta">
            <a class="deal" href={`/go/${x.r.urlSlug}`} rel="sponsored nofollow" data-umami-event="deal-click" data-umami-event-product={x.r.urlSlug} data-umami-event-placement={i === 0 ? 'guide-top' : 'guide-role'} data-umami-event-earns="yes">{tx.bestDeal} →</a>
            <a class="ghost" href={`/${lang}/verified/${x.r.urlSlug}/`}>{tx.readReview}</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- --------------------------------------------------------- every model -->
  <section class="block" id="table">
    <p class="kick">{tx.glance}</p>
    {(kindFilters.length > 0 || anySub || maxPrice) && (
      <div class="filters" data-filters role="group" aria-label="Filter">
        <button type="button" class="fchip on" data-f="all">{tx.all} <span class="fn">{rows.length}</span></button>
        {kindFilters.map((k) => <button type="button" class="fchip" data-f="kind" data-v={k.key}>{k.label[lang]} <span class="fn">{rows.filter((rw) => rw.head.pick.kind === k.key).length}</span></button>)}
        {anySub && <button type="button" class="fchip" data-f="nosub">{tx.noSub} <span class="fn">{rows.filter((rw) => !requiredSub(rw.head.r.value)).length}</span></button>}
        {maxPrice && <button type="button" class="fchip" data-f="price" data-v={maxPrice}>{tx.under} {formatPrice(maxPrice, 'EUR', lang)} <span class="fn">{rows.filter((rw) => priceForFilter(rw.head.r.value) > 0 && priceForFilter(rw.head.r.value) <= maxPrice).length}</span></button>}
      </div>
    )}
    <p class="fstatus" data-fstatus hidden></p>

    <!-- desktop: a real table. phone: cards (same rows, same data attributes). -->
    <div class="tablewrap">
      <table class="glance">
        <thead>
          <tr>
            <th>#</th><th>{de ? 'Modell' : 'Model'}</th><th>{tx.bestFor}</th>
            <th>{tx.score}</th><th>{tx.price}</th><th>{tx.firstYear}</th>
          </tr>
        </thead>
        <tbody>
          {rows.map(({ head: { pick, r }, others }, i) => (
            <tr data-row data-kind={pick.kind ?? ''} data-sub={requiredSub(r.value) ? '1' : '0'} data-price={priceForFilter(r.value)}>
              <td class="rank">{i + 1}</td>
              <td>
                <a class="gl-prod" href={`/${lang}/verified/${r.urlSlug}/`}><ProductThumb src={r.asset.images[0]} alt="" cat={cat.slug} size={44} />{r.productName}</a>
                {others.map((o) => <a class="gen" href={`/${lang}/verified/${o.r.urlSlug}/`}>{otherLine(o)}</a>)}
              </td>
              <td>{pick.bestFor[lang]}</td>
              <td class="sc"><ScorePill score={r.sqwodScore} lang={lang} size="sm" /></td>
              <td>
                {sticker(r.value)
                  ? <><b>{sticker(r.value)}</b>
                      {hasSubscription(r.value) ? <span class="subline">{r.value.subscription}</span> : null}</>
                  : '—'}
              </td>
              <td>{firstYear(r.value) !== null && firstYear(r.value) !== priceForFilter(r.value) ? firstYearOf(r.value) : <span class="muted">{tx.noSubShort}</span>}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <ol class="rank-cards">
      {rows.map(({ head: { pick, r }, others }, i) => (
        <li class="rc" data-row data-kind={pick.kind ?? ''} data-sub={requiredSub(r.value) ? '1' : '0'} data-price={priceForFilter(r.value)}>
          <span class="rc-n">{i + 1}</span>
          <ProductThumb src={r.asset.images[0]} alt="" cat={cat.slug} size={48} />
          <div class="rc-body">
            <a class="rc-name" href={`/${lang}/verified/${r.urlSlug}/`}>{r.productName}</a>
            <span class="rc-for">{pick.bestFor[lang]}</span>
            <div class="rc-row">
              <ScorePill score={r.sqwodScore} lang={lang} size="sm" />
              {sticker(r.value) ? <span class="rc-price"><b>{sticker(r.value)}</b>{requiredSub(r.value) && firstYearOf(r.value) ? <small>{tx.firstYear} {firstYearOf(r.value)}</small> : null}</span> : null}
            </div>
            {others.map((o) => <a class="gen" href={`/${lang}/verified/${o.r.urlSlug}/`}>{otherLine(o)}</a>)}
          </div>
          <a class="rc-deal" href={`/go/${r.urlSlug}`} rel="sponsored nofollow" data-umami-event="deal-click" data-umami-event-product={r.urlSlug} data-umami-event-placement="guide-card" data-umami-event-earns="yes" aria-label={`${tx.bestDeal}: ${r.productName}`}>→</a>
        </li>
      ))}
    </ol>
    <p class="note">
      {de ? 'Preise recherchiert, Stand ' : 'Prices researched, as of '}{dateFmt(lastUpdated)}. {tx.firstYearNote}
      {' '}<a href={`/${lang}/verified/c/${cat.slug}/`}>{tx.allIn} →</a>
    </p>
  </section>

  <!-- --------------------------------------------------- before you buy -->
  <section class="block" id="before">
    <p class="kick">{tx.before}</p>
    <ul class="guidance">
      {guide.before.map((b) => <li>{b[lang]}</li>)}
    </ul>
  </section>

  <!-- ------------------------------------------------------------ details -->
  <section class="block" id="details">
    <p class="kick">{tx.details}</p>
    {rows.map(({ head: { pick, r }, others }, i) => (
      <article class="pick" id={`pick-${r.urlSlug}`}>
        <div class="pick-head">
          <span class="num">#{i + 1}</span>
          <span class="tag">{pick.bestFor[lang]}</span>
        </div>
        <div class="pick-title">
          <ProductThumb src={r.asset.images[0]} alt={r.productName} cat={cat.slug} size={96} />
          <div>
            <h3>{r.productName}</h3>
            {others.map((o) => <a class="gen" href={`/${lang}/verified/${o.r.urlSlug}/`}>{otherLine(o)}</a>)}
          </div>
        </div>
        <div class="pick-meta">
          <ScorePill score={r.sqwodScore} lang={lang} size="sm" />
          <span>Crowd {r.crowd.score}</span>
          <span>Assessment {r.assessment.score}</span>
          <span>Value {r.value.score}</span>
          {sticker(r.value) ? <span><b>{sticker(r.value)}</b></span> : null}
          {hasSubscription(r.value) ? <span>{tx.sub}: {r.value.subscription}</span> : null}
          {requiredSub(r.value) && firstYearOf(r.value) ? <span>{tx.firstYear}: <b>{firstYearOf(r.value)}</b></span> : null}
        </div>
        <p class="why">{pick.why[lang]}</p>
        {r.assessment.criteria?.length ? (
          <ul class="crit">
            {r.assessment.criteria.map((c) => <li><span>{c.name}</span><b>{c.score}</b></li>)}
          </ul>
        ) : null}
        <div class="pc">
          <div class="pros"><h4>{tx.pros}</h4><ul>{r.pros.slice(0, 3).map((p) => <li>{p}</li>)}</ul></div>
          <div class="cons"><h4>{tx.cons}</h4><ul>{r.cons.slice(0, 2).map((c) => <li>{c}</li>)}</ul></div>
        </div>
        {r.proRead
