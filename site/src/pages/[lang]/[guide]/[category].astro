      ))}
    </ul>
  </section>
</Base>

<script>
  // Filter chips: client-side on the rows already on the page (table rows on desktop, cards
  // on phones share the same data attributes). One filter at a time; "All" resets.
  const box = document.querySelector<HTMLElement>('[data-filters]');
  if (box) {
    const rows = [...document.querySelectorAll<HTMLElement>('[data-row]')];
    const status = document.querySelector<HTMLElement>('[data-fstatus]');
    const total = document.querySelectorAll('table.glance [data-row]').length;
    const lang = document.documentElement.lang;
    const apply = (f: string, v: string) => {
      let shown = 0;
      for (const r of rows) {
        const ok = f === 'all' || (f === 'kind' && r.dataset.kind === v) || (f === 'nosub' && r.dataset.sub === '0') || (f === 'price' && Number(r.dataset.price) > 0 && Number(r.dataset.price) <= Number(v));
        r.hidden = !ok; if (ok) shown++;
      }
      shown = shown / 2; // table row + card per model
      if (status) {
        status.hidden = f === 'all';
        status.textContent = shown === 0 ? (lang === 'de' ? 'Kein Modell passt zu dieser Auswahl.' : 'No model matches this selection.') : `${shown} / ${total} ${lang === 'de' ? 'angezeigt' : 'shown'}`;
      }
      try { (window as any).umami?.track('guide-filter', { f, v }); } catch {}
    };
    box.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.fchip'); if (!b) return;
      box.querySelectorAll('.fchip').forEach((x) => x.classList.toggle('on', x === b));
      apply(b.dataset.f || 'all', b.dataset.v || '');
    });
  }
</script>

