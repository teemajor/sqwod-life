          <a class="ghost" href={`/${lang}/verified/${r.urlSlug}/`}>{tx.readReview}</a>
        </div>
      </article>
    ))}
  </section>

  {guide.pro && (
    <section class="block pro-note">
      <p class="kick">{de ? '◆ Für Profis' : '◆ For professionals'}</p>
      <p class="pro-p">{guide.pro[lang]}</p>
