---
// Homepage, Oct 2026 redesign (approved mockup "sqwod.life redesign mockups", board
// "Homepage · alive"): money ticker, display hero with a live bar field and the sign-up
// above the fold, today's Daily strip, Intelligence cards, one inverted band, Verified
// picks, operator playbooks and the three "work with Sqwod" doors.
import Base from '../../layouts/Base.astro';
import Glyph from '../../components/Glyph.astro';
import InlineSignup from '../../components/InlineSignup.astro';
import { getCollection } from 'astro:content';
import { languages, type Lang } from '../../i18n/ui';
import { pillarMeta, type Pillar } from '../../i18n/pillars';
import { topicLabel } from '../../config/topics';
import { readdirSync } from 'node:fs';
import { reviewEarns } from '../../config/verified-categories';
import { isLiveIssue } from '../../config/daily.mjs';
import { priceOf } from '../../lib/price';
import { join } from 'node:path';
import { appleFor, spotifyFor, episodeAudio } from '../../config/podcast';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const de = lang === 'de';
const fmtDate = (d: Date) => d.toLocaleDateString(de ? 'de-DE' : 'en-GB', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' });

// --- Daily
const issues = (await getCollection('daily', (i) => i.data.lang === lang && isLiveIssue(i.data.status, i.data.date)))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const latest = issues[0];
let audioFiles = new Set<string>();
try { audioFiles = new Set(readdirSync(join(process.cwd(), 'public', 'audio'))); } catch { /* none yet */ }
const latestHasAudio = !!(latest && audioFiles.has(`${latest.data.urlSlug}-${lang}.mp3`));
const moves = latest?.data.moneyMoves ?? [];
// the card's money column: the first move with a disclosed amount, else the first move
const move = moves.find((m) => m.amount) ?? moves[0];
const dStat = latest?.data.stat?.number ? latest.data.stat : null;
// "Source: <name>" for the stat when the Daily carries a source URL for it (short host name)
const statSource = (() => { try { return dStat?.url && /^https?:/.test(dStat.url) ? new URL(dStat.url).hostname.replace(/^www\./, '') : null; } catch { return null; } })();
const issueHref = latest ? `/${lang}/daily/${latest.data.urlSlug}/` : '';
// episode length: the frontmatter duration ("2:51"), else the spoken script at ~150 words a minute (as audio.mjs)
const duration = (() => {
  const d = latest?.data.duration?.match(/^(\d+):(\d{2})$/);
  if (d) return `${Math.max(1, Math.round(+d[1] + +d[2] / 60))} min`;
  const words = latest?.data.audioScript ? latest.data.audioScript.split(/\s+/).length : 0;
  return `${words ? Math.max(1, Math.round(words / 150)) : 5} min`;
})();
// "22 Mio. Dollar" / "$22 million" -> "22 Mio. $" / "$22M": the card's big number stays big
function compactAmount(a: string) {
  const m = a.match(/^\s*([$€£])?\s*(\d[\d.,]*)\s*(Mio\.?|Millionen|Mrd\.?|Milliarden|million|billion|bn|M|B)\s*(Dollar|US-Dollar|USD|Euro|EUR|Pfund|GBP|[$€£])?\s*$/i);
  if (!m) return a;
  const sym = m[1] || ({ dollar: '$', 'us-dollar': '$', usd: '$', euro: '€', eur: '€', pfund: '£', gbp: '£' } as Record<string, string>)[(m[4] || '').toLowerCase()] || m[4] || '';
  const big = /^(mrd|milliard|billion|bn|b$)/i.test(m[3]);
  return de ? `${m[2]} ${big ? 'Mrd.' : 'Mio.'} ${sym}`.trim() : `${sym}${m[2]}${big ? 'B' : 'M'}`;
}
const moveAmount = move?.amount ? compactAmount(move.amount) : '';
const KIND: Record<string, string> = de
  ? { raise: 'Finanzierung', acquisition: 'Übernahme', valuation: 'Bewertung', ipo: 'Börsengang', shutdown: 'Schließung', news: 'News', report: 'Report' }
  : { raise: 'Raise', acquisition: 'Acquisition', valuation: 'Valuation', ipo: 'IPO', shutdown: 'Shutdown', news: 'News', report: 'Report' };

// --- Articles
const articles = (await getCollection('articles', (a) => a.data.lang === lang))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
type Art = (typeof articles)[number];
const isReport = (a: Art) => a.data.format === 'report' || a.data.format === 'index';
const hrefFor = (a: Art) => `/${lang}/${isReport(a) ? 'intelligence' : 'analysis'}/${a.data.urlSlug}`;
const statOf = (a: Art) => a.data.hero?.stat ?? a.data.figures[0]?.value;
const statLabelOf = (a: Art) => a.data.hero?.statLabel ?? a.data.figures[0]?.label;
const reports = articles.filter((a) => isReport(a) && statOf(a)).slice(0, 3);
const flagship = articles.find((a) => isReport(a) && !a.data.gated) ?? reports[0];
const reportCount = articles.filter(isReport).length;
const builds = articles.filter((a) => !isReport(a) && a.data.pillar === 'build').slice(0, 2);
const evidence = articles.find((a) => a.data.type === 'evidence');
const playbooks = [...builds, ...(evidence ? [evidence] : [])];
const laneTag = (a: Art) => topicLabel(a.data.topic, lang) || (a.data.type === 'evidence' ? 'Evidence' : (pillarMeta[a.data.pillar as Pillar]?.label[lang] ?? a.data.pillar));

// --- Ticker: today's money movement, then the latest headlines, then the newest report stat
type Tick = { k: string; t: string; href: string };
const ticks: Tick[] = [];
for (const iss of issues.slice(0, 4)) {
  for (const m of iss.data.moneyMoves ?? []) ticks.push({ k: KIND[m.kind] ?? m.kind, t: `${m.entity} · ${m.amount}${m.note ? `, ${m.note}` : ''}`, href: `/${lang}/daily/${iss.data.urlSlug}` });
}
for (const it of (latest?.data.items ?? []).slice(0, 4)) ticks.push({ k: KIND.news, t: it.headline, href: `/${lang}/daily/${latest!.data.urlSlug}` });
if (reports[0]) ticks.push({ k: KIND.report, t: `${statLabelOf(reports[0]) ?? reports[0].data.title} · ${statOf(reports[0])}`, href: hrefFor(reports[0]) });
const tickLine = ticks.slice(0, 10);

// --- Verified
const reviews = (await getCollection('reviews', (r) => r.data.lang === lang && !r.data.draft))
  .sort((a, b) => b.data.sqwodScore - a.data.sqwodScore);
type Rev = (typeof reviews)[number];
const isTool = (r: Rev) => /coaching|studio|software|apps/i.test(r.data.category);
const tool = reviews.find(isTool);
const picks: Rev[] = [];
const seenCat = new Set<string>();
for (const r of reviews) {
  if (picks.length >= 2) break;
  if (isTool(r) || seenCat.has(r.data.category) || !r.data.asset.images[0]) continue;
  seenCat.add(r.data.category); picks.push(r);
}
const topPicks = (tool ? [picks[0], picks[1], tool] : picks).filter(Boolean) as Rev[];
const price = (r: Rev) => `${de ? 'ab' : 'from'} ${priceOf(r.data.value, de ? 'de' : 'en')}`;

// --- Hero bar field (deterministic, decorative)
const bars = Array.from({ length: 44 }, (_, i) => `left:${(i / 44) * 100}%;height:${18 + ((i * 37) % 61)}%;animation-delay:-${(i % 7) * 0.45}s;animation-duration:${5 + (i % 5)}s`);

const title = de ? 'Sqwod: dein Vorsprung im Fitness-Business' : 'Sqwod: your edge in the fitness industry';
const tagline = de
  ? 'Intelligence, Reviews und Playbooks für die Menschen, die Fitness aufbauen: Gründer:innen, Betreiber:innen, Coaches, Marken und Investor:innen.'
  : 'Intelligence, reviews and playbooks for the people who build fitness: founders, operators, coaches, brands and investors.';
// headline words; `a` marks the one moss word
const h1 = de
  ? [{ w: 'Dein' }, { w: 'Vorsprung' }, { w: 'im', br: true }, { w: 'Fitness-Business.', a: true }]
  : [{ w: 'Your' }, { w: 'edge' }, { w: 'in' }, { w: 'the', br: true }, { w: 'fitness', a: true }, { w: 'industry.' }];
const T = de
  ? { kicker: 'Sqwod Daily · werktäglich · EN & DE', signup: 'Hol dir den 5-Minuten-Brief',
      today: 'Heutiger Daily', listen: 'Anhören', pause: 'Pause', undisclosed: 'Nicht genannt', allDeals: 'Alle Deals im Tracker', allDealsShort: 'Alle Deals', source: 'Quelle', moreStats: 'Mehr Zahlen', onApple: 'Auf Apple Podcasts anhören', onSpotify: 'Auf Spotify anhören', readShort: 'Ausgabe lesen', newTab: 'öffnet neuen Tab', moneyOne: 'Geldbewegung', readLong: 'Heutige Ausgabe lesen', read: 'Ausgabe lesen', money: 'Geldbewegungen', invRead: 'Investor-Sicht', statDay: 'Zahl des Tages', heads: 'Heute im Daily',
      repKick: 'Sqwod Intelligence', repH: 'Die Daten hinter dem Business.', repAll: 'Alle Reports',
      invKick: 'Sqwod Intelligence · monatlicher Flagship-Report', invH: 'Ein großer Report im Monat. Gebaut auf 2.061 Statista-Grafiken.', invA: 'Reports live', invB: 'Sprachen, nativ geschrieben', invC: 'interaktive Grafiken pro Report', invCta: 'Flagship-Report lesen',
      vKick: 'Sqwod Verified', vH: 'Produkte mit Score.', vP: 'Für deine Kund:innen, dein Studio und dein Regal.', allGuides: 'Alle Kaufberater', trade: 'Trade-Sicht', ad: 'Anzeige',
      pbKick: 'Artikel', pbH: 'Playbooks für Operator', allReads: 'Alle Artikel',
      workKick: 'Partner', workH: 'Mit Sqwod arbeiten',
      brandK: 'Für Marken', brandH: 'Erreiche die Menschen, die Fitness machen.', brandP: 'Sqwod Daily, der Podcast, Plätze auf der Seite. Oder lass dein Produkt bewerten und in Sqwod Pods einsetzen.', brandCta: 'Werben',
      investK: 'Für Investor:innen', investH: 'Dealflow, täglich eingeordnet.', investP: 'Jede Finanzierung, Übernahme und Eröffnung mit Investor-Sicht. Dazu jeden Monat ein Flagship-Report.', investCta: 'Als Investor:in abonnieren',
      podK: 'Für Coaches in Berlin', podH: 'Trainiere Kund:innen in einem privaten Sqwod Pod.', podP: 'Voll ausgestattete private Trainingsräume in Prenzlauer Berg und Weißensee.', podCta: 'Pod buchen' }
  : { kicker: 'Sqwod Daily · every weekday · EN & DE', signup: 'Get the 5-minute brief',
      today: "Today's Daily", listen: 'Listen', pause: 'Pause', undisclosed: 'Undisclosed', newTab: 'opens in a new tab', moneyOne: 'Money movement', readLong: "Read today's issue", allDeals: 'All deals in the tracker', allDealsShort: 'All deals', source: 'Source', moreStats: 'More stats', onApple: 'Listen on Apple Podcasts', onSpotify: 'Listen on Spotify', readShort: 'Read the issue', read: "Read today's issue", money: 'Money movement', invRead: 'Investor read', statDay: 'Stat of the day', heads: 'In today\'s Daily',
      repKick: 'Sqwod Intelligence', repH: 'The data behind the business.', repAll: 'All reports',
      invKick: 'Sqwod Intelligence · monthly flagship', invH: 'One deep report a month. Built on 2,061 Statista charts.', invA: 'reports live', invB: 'languages, written natively', invC: 'interactive charts per report', invCta: 'Read the flagship',
      vKick: 'Sqwod Verified', vH: 'products scored.', vP: 'For your clients, your studio and your shelf.', allGuides: "All buyer's guides", trade: 'Trade read', ad: 'Ad',
      pbKick: 'Articles', pbH: 'Operator playbooks', allReads: 'All articles',
      workKick: 'Partners', workH: 'Work with Sqwod',
      brandK: 'For brands', brandH: 'Reach the people who run fitness.', brandP: 'Sqwod Daily, the podcast, site placements. Or get your product reviewed and used in Sqwod Pods.', brandCta: 'Advertise',
      investK: 'For investors', investH: 'Deal flow, decoded daily.', investP: 'Every raise, acquisition and opening with an investor read. Plus one flagship report a month.', investCta: 'Join as an investor',
      podK: 'For coaches in Berlin', podH: 'Train clients in a private Sqwod Pod.', podP: 'Fully equipped private training rooms in Prenzlauer Berg and Weißensee.', podCta: 'Book a Pod' };
---
<Base lang={lang} title={title} description={tagline} active="">
  {tickLine.length > 2 && (
    <div class="tick bleed" aria-label={T.money}>
      <div class="tick-in">
        {[0, 1].map((rep) => tickLine.map((t) => <a href={t.href} tabindex={rep ? -1 : undefined} aria-hidden={rep ? 'true' : undefined}><b>{t.k.toUpperCase()}</b>{t.t}</a>))}
      </div>
    </div>
  )}

  <!-- Hero -->
  <section class="hx">
    <div class="hx-field" aria-hidden="true">{bars.map((s) => <i style={s}></i>)}</div>
    <div class="hx-in">
      <p class="kick hx-kick"><span class="pulse" aria-hidden="true"></span>{T.kicker}</p>
      <h1 class="hx-h1">
        {h1.map((x, i) => <Fragment><span class={x.a ? 'hw hx-acc' : 'hw'} style={`animation-delay:${i * 0.08}s`}>{x.w}</span>{' '}{x.br ? <br /> : null}</Fragment>)}
      </h1>
      <p class="hx-sub">{tagline}</p>
      <InlineSignup lang={lang} source="home-hero" head={T.signup} variant="hero" />
    </div>
  </section>

  <!-- Today's Daily: card C1b (Oct 2026). Headline, the day's biggest money move and the stat,
       with one shared footer row of actions. -->
  {latest && (
    <section class={`dc rv${dStat ? '' : ' dc-nostat'}`} aria-label={T.today}>
      <div class="dc-c dc-h">
        <p class="kick dc-k"><span class="pulse" aria-hidden="true"></span>{T.today} · {fmtDate(latest.data.date)}</p>
        <a class="dc-title" href={issueHref} data-umami-event="daily-read" data-umami-event-where="headline">{latest.data.summary || latest.data.title}</a>
      </div>
      <div class="dc-c dc-m">
        {move ? (
          <Fragment>
            <p class="kick">{T.moneyOne} · {KIND[move.kind] ?? move.kind}</p>
            <span class={`dnum dc-big dc-amt${moveAmount ? '' : ' dc-und'}`} style={`--len:${(moveAmount || T.undisclosed).length}`}>{moveAmount || T.undisclosed}</span>
            <p class="dc-line"><b>{move.entity}</b>{move.note ? <Fragment> · {move.note}</Fragment> : null}</p>
          </Fragment>
        ) : (
          <Fragment>
            <p class="kick">{T.heads}</p>
            <ul class="ds-heads">{latest.data.items.slice(0, 3).map((i) => <li>{i.headline}</li>)}</ul>
          </Fragment>
        )}
      </div>
      {dStat && (
        <div class="dc-c dc-s">
          <p class="kick">{T.statDay}</p>
          <span class="dnum dc-big" style={`--len:${dStat.number.length}`}>{dStat.number}</span>
          <p class="dc-line">{dStat.label}</p>
        </div>
      )}
      <div class="dc-f dc-f1">
        {(latestHasAudio || appleFor(lang) !== '#' || spotifyFor(lang) !== '#') && <div class="dc-listen">
          {latestHasAudio && (
            <Fragment>
              <button type="button" class="dc-play" data-playing="false" data-label-play={`${T.listen} · ${duration}`} data-label-pause={`${T.pause} · ${duration}`}>
                <svg class="dc-ico-play" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor"/></svg>
                <svg class="dc-ico-pause" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" fill="currentColor"/></svg>
                <span>{T.listen} · {duration}</span>
              </button>
              <audio class="dc-audio" preload="none" src={episodeAudio(latest.data.urlSlug, lang)}></audio>
            </Fragment>
          )}
          {appleFor(lang) !== '#' && <a class="dc-app" href={appleFor(lang)} target="_blank" rel="noopener" aria-label={T.onApple} title={T.onApple} data-umami-event="listen-apple" data-umami-event-where="home">
            <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><circle cx="12" cy="9.5" r="2.6" fill="currentColor"/><path d="M10.6 13.4h2.8l-.5 7.1h-1.8z" fill="currentColor"/><path d="M7.2 15.2a6.8 6.8 0 1 1 9.6 0M4.6 17.6a10.2 10.2 0 1 1 14.8 0" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
          </a>}
          {spotifyFor(lang) !== '#' && <a class="dc-app" href={spotifyFor(lang)} target="_blank" rel="noopener" aria-label={T.onSpotify} title={T.onSpotify} data-umami-event="listen-spotify" data-umami-event-where="home">
            <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="currentColor"/><path d="M6.4 9.1c3.8-1.1 8.1-.8 11.3 1M7 12.3c3.2-.9 6.6-.6 9.3.9M7.6 15.3c2.6-.7 5.2-.5 7.4.7" fill="none" stroke="var(--panel)" stroke-width="1.6" stroke-linecap="round"/></svg>
          </a>}
        </div>}
        <a class="dc-link dc-read" href={issueHref} data-umami-event="daily-read" data-umami-event-where="footer"><span class="dc-long">{T.readLong}</span><span class="dc-short">{T.readShort}</span> →</a>
      </div>
      <div class="dc-f dc-f2">
        <a class="dc-link" href={`/${lang}/intelligence/deals/`} data-umami-event="daily-deals"><span class="dc-long">{T.allDeals}</span><span class="dc-short">{T.allDealsShort}</span> →</a>
      </div>
      {dStat && (
        <div class="dc-f dc-f3">
          {statSource
            ? <a class="dc-link" href={dStat.url} target="_blank" rel="noopener" aria-label={`${T.source}: ${statSource} (${T.newTab})`} data-umami-event="daily-source">{T.source}: {statSource} ↗</a>
            : <a class="dc-link" href={issueHref} data-umami-event="daily-source" data-umami-event-kind="more-stats">{T.moreStats} →</a>}
        </div>
      )}
    </section>
  )}

  <!-- Intelligence -->
  {reports.length > 0 && (
    <section class="sx">
      <div class="sx-head rv">
        <div><p class="kick">{T.repKick}</p><h2>{T.repH}</h2></div>
        <a class="sx-all" href={`/${lang}/intelligence`}>{T.repAll} →</a>
      </div>
      <div class="g3 swipe">
        {reports.map((r, i) => (
          <a class={`rc lift rv d${i + 1}${i === 1 ? ' tilt' : ''}`} href={hrefFor(r)}>
            <span class="dnum rc-n" data-count>{statOf(r)}</span>
            <span class="rc-l">{statLabelOf(r)}</span>
            <span class="rc-h">{r.data.title}</span>
            <span class="rc-go">{de ? 'Report lesen' : 'Read the report'} →</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Inverted band -->
  {flagship && (
    <section class="inv bleed">
      <div class="wrap inv-in">
        <div class="rv">
          <p class="kick">{T.invKick}</p>
          <h2 class="inv-h">{T.invH}</h2>
        </div>
        <div class="inv-side rv d1">
          <div class="inv-stats">
            <div><span class="dnum" data-count>{reportCount}</span><span>{T.invA}</span></div>
            <div><span class="dnum">2</span><span>{T.invB}</span></div>
            <div><span class="dnum">8–10</span><span>{T.invC}</span></div>
          </div>
          <a class="inv-btn" href={hrefFor(flagship)}>{T.invCta} →</a>
        </div>
      </div>
    </section>
  )}

  <!-- Verified -->
  {topPicks.length > 0 && (
    <section class="sx">
      <div class="sx-head rv">
        <div><p class="kick">{T.vKick}</p><h2><span data-count>{reviews.length}</span> {T.vH}</h2><p>{T.vP}</p></div>
        <a class="sx-all" href={`/${lang}/verified`}>{T.allGuides} →</a>
      </div>
      <div class="g3 swipe">
        {topPicks.map((r, i) => (
          <a class={`vc lift rv d${i + 1}`} href={`/${lang}/verified/${r.data.urlSlug}`}>
            <div class="vc-img">
              {r.data.asset.images[0]
                ? <img src={r.data.asset.images[0]} alt={r.data.productName} loading="lazy" />
                : <Glyph kind={r.data.glyph} size={96} framed={false} />}
            </div>
            <div class="vc-b">
              <div class="vc-top"><span class="dnum vc-score">{r.data.sqwodScore}</span><span class="vc-sl">Sqwod Score</span></div>
              <span class="vc-h">{r.data.productName}</span>
              <span class="vc-p">{r.data.proRead?.trade ? <Fragment><b>{T.trade}:</b> {r.data.proRead.trade}</Fragment> : r.data.verdict}</span>
              <span class="vc-foot"><span class="vc-price">{price(r)}</span>{reviewEarns(r.data.urlSlug) && <span class="vc-ad">{T.ad}</span>}</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Operator playbooks -->
  {playbooks.length > 0 && (
    <section class="sx">
      <div class="sx-head rv">
        <div><p class="kick">{T.pbKick}</p><h2>{T.pbH}</h2></div>
        <a class="sx-all" href={`/${lang}/articles`}>{T.allReads} →</a>
      </div>
      <div class="g3 swipe">
        {playbooks.map((a, i) => (
          <a class={`pc2 lift rv d${i + 1}`} href={hrefFor(a)}>
            <span class="pc2-tag">{laneTag(a)}</span>
            <span class="pc2-h">{a.data.title}</span>
            <span class="pc2-p">{a.data.description}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Work with Sqwod -->
  <section class="sx sx-last">
    <div class="sx-head rv"><div><p class="kick">{T.workKick}</p><h2>{T.workH}</h2></div></div>
    <div class="g3 swipe">
      <div class="door lift rv d1"><p class="kick">{T.brandK}</p><span class="door-h">{T.brandH}</span><p>{T.brandP}</p><a class="cta door-cta" href={`/${lang}/advertise`}>{T.brandCta} →</a></div>
      <div class="door lift rv d2 tilt"><p class="kick">{T.investK}</p><span class="door-h">{T.investH}</span><p>{T.investP}</p><a class="door-ghost" href={`/${lang}/subscribe`}>{T.investCta} →</a></div>
      <div class="door lift rv d3"><p class="kick">{T.podK}</p><span class="door-h">{T.podH}</span><p>{T.podP}</p><a class="door-ghost" href="https://sqwodpod.com" target="_blank" rel="noopener">{T.podCta} →</a></div>
    </div>
  </section>
</Base>

<script is:inline>
  // Daily card: "Listen" plays the episode right here (the <audio> is only rendered when the
  // MP3 exists in the build). Button text and aria-pressed follow the player.
  (function () {
    var b = document.querySelector('.dc-play'), au = document.querySelector('.dc-audio');
    if (!b || !au) return;
    var label = b.querySelector('span');
    var sync = function () { var on = !au.paused; b.setAttribute('data-playing', on ? 'true' : 'false'); label.textContent = b.getAttribute(on ? 'data-label-pause' : 'data-label-play'); };
    var tracked = false;
    b.addEventListener('click', function () { if (au.paused) { var p = au.play(); if (p && p.catch) p.catch(sync); } else au.pause(); });
    // Umami "daily-listen" counts the first play only (pause clicks are not listens)
    au.addEventListener('play', function () { sync(); if (!tracked && window.umami && umami.track) { tracked = true; umami.track('daily-listen', { where: 'home' }); } });
    au.addEventListener('pause', sync); au.addEventListener('ended', sync);
  })();
</script>

<script is:inline>
  // Ticker speed: a fixed reading pace (~32 px a second) whatever the number of items,
  // so a long day of headlines doesn't race past. One loop = half the doubled strip.
  (function () {
    var t = document.querySelector('.tick-in'); if (!t) return;
    var loop = t.scrollWidth / 2; if (loop > 0) t.style.animationDuration = Math.round(loop / 32) + 's';
  })();
</script>

