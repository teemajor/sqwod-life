  /* Phones and tablets in portrait, same breakpoint as the hero (the 7-column table needs 720px): the table becomes a list of
     cards from the same DOM. Each <tr> is a wrapping flex row and the cells are re-ordered;
     the company cell uses display:contents so the name and the note sit on different lines. */
  @media(max-width:899px){
    .dt-filters{margin-top:24px}
    .dt-chips{flex-wrap:nowrap;gap:8px;margin:0 -24px 12px;padding:2px 24px;overflow-x:auto;scroll-snap-type:x proximity;scroll-padding:24px;scrollbar-width:none;-webkit-overflow-scrolling:touch;
      -webkit-mask-image:linear-gradient(90deg,transparent,#000 24px,#000 calc(100% - 24px),transparent);mask-image:linear-gradient(90deg,transparent,#000 24px,#000 calc(100% - 24px),transparent)}
    .dt-chips::-webkit-scrollbar{display:none}
    .dt-chips button{flex:0 0 auto;min-height:44px;padding:0 15px;font-size:13.5px;scroll-snap-align:start}
    .dt-row{grid-template-columns:1fr 1fr}
    .dt-q{grid-column:1/-1}
    .dt-row input,.dt-row select{min-height:48px;padding-top:0;padding-bottom:0;font-size:16px}   /* 16px: iOS Safari does not zoom in on focus */
    .dt-count{margin-top:10px;font-size:13px}
    .dt-wrap{overflow:visible}
    .dt{min-width:0;display:block}
    .dt thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}   /* column names stay for screen readers */
    .dt tbody{display:block}
    .dt tr{display:flex;flex-wrap:wrap;align-items:baseline;column-gap:10px;row-gap:5px;padding:14px 16px 12px;border-top:1px solid var(--line)}
    .dt tr:first-child{border-top:0}
    .dt tr[hidden]{display:none}
    .dt td{display:block;padding:0;border:0}
    .dt td.dt-who{display:contents}
    .dt-who b{order:1;flex:1 1 0;min-width:0;font-size:16px;font-weight:700;line-height:1.3;overflow-wrap:break-word}
    .dt-amt{order:2;flex:0 0 auto;max-width:48%;text-align:right;white-space:normal;font-family:var(--display);font-weight:400;font-size:22px;line-height:.9;letter-spacing:.005em;font-variant-numeric:tabular-nums;color:var(--chalk)}
