---
// Sqwod Deal Tracker: every raise, acquisition, valuation and IPO the Daily has logged,
// merged, web-checked and approved by Tee (one tap per deal). Data: src/lib/deals.ts.
import { isLiveIssue } from '../../../config/daily.mjs'; // issues before DAILY_START are not built, so no Daily link for them
import Base from '../../../layouts/Base.astro';
import { ogPath } from '../../../lib/og';
import DataChart from '../../../components/DataChart.astro';
import InlineSignup from '../../../components/InlineSignup.astro';
import { languages, type Lang } from '../../../i18n/ui';
import { liveAll, generatedAt } from '../../../lib/deals';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const de = lang === 'de';
const all = liveAll().sort((a, b) => b.date.localeCompare(a.date));
const deals = all.filter((d) => d.kind !== 'shutdown');     // money deals: the headline numbers and charts
const closures = all.filter((d) => d.kind === 'shutdown');

const T = de ? {
  title: 'Sqwod Deal Tracker: Finanzierungen & Übernahmen in Fitness und Wellness',
  h1: 'Sqwod Deal Tracker',
  heroH1: 'Jede Finanzierung. Jede Übernahme. Jede Pleite.',
  sub: 'Jede Finanzierung, Übernahme, jeder Börsengang und jede Schließung in Fitness und Wellness, gegen die Quelle geprüft. Nach Region filterbar, DACH inklusive.',
  updatedOn: 'Aktualisiert', sinceShort: 'seit', dealsShort: 'Deals', closuresShort: 'Schließungen',
  cta: 'Neue Deals jeden Werktag →', csv: 'CSV herunterladen',
  latest: 'Neueste Deals', seeAll: (n: number) => `Alle ${n} ansehen ↓`, panelFoot: 'Gegen die Quelle geprüft · Beträge wie veröffentlicht',
  deals: 'Deals erfasst', value: 'Offengelegtes Volumen', valueNote: 'ca. USD, Finanzierungen + M&A + IPOs', eu: 'Europa & DACH', euNote: 'Anteil der Deals', since: 'Seit',
  all: 'Alle', region: 'Region', kind: 'Art', cat: 'Kategorie', search: 'Firma suchen …', count: 'Deals angezeigt',
  th: ['Datum', 'Firma', 'Deal', 'Betrag', 'Region', 'Kategorie', 'Quelle'],
  kinds: { raise: 'Finanzierung', acquisition: 'Übernahme', valuation: 'Bewertung', ipo: 'Börsengang', shutdown: 'Insolvenz / Schließung' } as Record<string, string>,
  closures: 'Insolvenzen und Schließungen', closuresNote: 'seit Januar 2026 erfasst',
  undisclosed: 'nicht genannt', source: 'Quelle', daily: 'Daily',
  chart1: 'Offengelegtes Deal-Volumen pro Monat', unit1: 'Mio. USD (ca.)', chart2: 'Deals nach Kategorie', unit2: 'Anzahl',
  method: 'So entsteht der Tracker',
  methodBody: [
    'Quelle: der Abschnitt „Money movement“ in jeder Ausgabe von Sqwod Daily, mit Link zur Originalmeldung.',
    'Meldet die Presse denselben Deal innerhalb von 60 Tagen erneut, führen wir ihn zu einem Eintrag zusammen und behalten das Datum der ersten Meldung.',
    'Neue Deals werden im Web gegengeprüft (Firmensitz, Betrag, Quelle) und erst nach Freigabe durch Tee Major veröffentlicht.',
    'USD-Werte sind Näherungen mit festen Wechselkursen. Maßgeblich ist der Betrag in Originalwährung.',
  ],
  empty: 'Die ersten Deals werden gerade geprüft. Trag dich ein und bekomm jeden neuen Deal in Sqwod Daily.',
  download: 'Daten herunterladen', cite: 'Zitieren', updated: 'Stand',
  signupHead: 'Jeden Deal am Morgen, bevor er Thema ist', signupBody: 'Sqwod Daily: Geld, Deals und was sie für dein Business heißen. Werktäglich, kostenlos.',
} : {
  title: 'Sqwod Deal Tracker: Fitness & Wellness Funding and M&A',
  h1: 'Sqwod Deal Tracker',
  heroH1: 'Who’s raising, buying and closing in fitness.',
  sub: 'Every raise, acquisition, IPO and closure in fitness and wellness, checked against the source. Filter by region, DACH included.',
  updatedOn: 'Updated', sinceShort: 'since', dealsShort: 'Deals', closuresShort: 'Closures',
  cta: 'Get new deals every weekday →', csv: 'Download CSV',
  latest: 'Latest deals', seeAll: (n: number) => `See all ${n} ↓`, panelFoot: 'Checked against the source · amounts as disclosed',
  deals: 'Deals tracked', value: 'Disclosed value', valueNote: 'approx. USD, raises + M&A + IPOs', eu: 'Europe & DACH', euNote: 'share of deals', since: 'Since',
  all: 'All', region: 'Region', kind: 'Type', cat: 'Category', search: 'Search a company…', count: 'deals shown',
  th: ['Date', 'Company', 'Deal', 'Amount', 'Region', 'Category', 'Source'],
  kinds: { raise: 'Raise', acquisition: 'Acquisition', valuation: 'Valuation', ipo: 'IPO', shutdown: 'Bankruptcy / closure' } as Record<string, string>,
  closures: 'Bankruptcies and closures', closuresNote: 'tracked since January 2026',
  undisclosed: 'undisclosed', source: 'Source', daily: 'Daily',
  chart1: 'Disclosed deal value per month', unit1: 'USD millions (approx.)', chart2: 'Deals by category', unit2: 'count',
  method: 'How the tracker is built',
  methodBody: [
    'Source: the "Money movement" block in every Sqwod Daily issue, linked to the original report.',
    'When the press reports the same deal again within 60 days, we merge it into one entry and keep the date it was first reported.',
    'New deals are checked on the web (headquarters, amount, source) and published only after Tee Major approves them.',
    'USD values are approximations at fixed exchange rates. The amount in the original currency is the reference.',
  ],
  empty: 'The first deals are being checked right now. Sign up and get every new deal in Sqwod Daily.',
  download: 'Download the data', cite: 'Cite', updated: 'As of',
  signupHead: 'Every deal, in your inbox before it is old news', signupBody: 'Sqwod Daily: money, deals and what they mean for your business. Every weekday, free.',
};
const REGION_DE: Record<string, string> = { DACH: 'DACH', UK: 'UK', Europe: 'Europa', 'North America': 'Nordamerika', 'Asia-Pacific': 'Asien-Pazifik', 'Middle East': 'Naher Osten', 'Latin America': 'Lateinamerika', Other: 'Sonstige' };
const CAT_DE: Record<string, string> = { 'Gyms & studios': 'Studios & Clubs', 'Wearables & devices': 'Wearables & Geräte', 'Health & longevity': 'Health & Longevity', 'Nutrition & supplements': 'Ernährung & Supplements', 'Software & AI': 'Software & KI', 'Apparel & footwear': 'Bekleidung & Schuhe', Other: 'Sonstige' };
const rName = (r: string) => (de ? REGION_DE[r] || r : r);
const cName = (c: string) => (de ? CAT_DE[c] || c : c);
const loc = de ? 'de-DE' : 'en-GB';
const fmtDate = (d: string) => new Date(d + 'T12:00:00Z').toLocaleDateString(loc, { day: '2-digit', month: 'short', year: 'numeric' });
const usd = (n: number) => (n >= 1e9 ? `$${(n / 1e9).toLocaleString(loc, { maximumFractionDigits: 1 })}${de ? ' Mrd.' : 'bn'}` : n >= 1e6 ? `$${(n / 1e6).toLocaleString(loc, { maximumFractionDigits: n >= 1e8 ? 0 : 1 })}${de ? ' Mio.' : 'M'}` : `$${Math.round(n / 1e3)}K`);

// headline numbers, all computed from the live rows
// A valuation is a price tag, not money that moved: it stays out of the disclosed-value sum and the chart.
const moved = (d: { kind: string }) => d.kind !== 'valuation';
const disclosed = deals.filter(moved).reduce((s, d) => s + (d.amountUsd || 0), 0);
const euShare = deals.length ? Math.round((deals.filter((d) => d.region === 'Europe' || d.region === 'DACH' || d.region === 'UK').length / deals.length) * 100) : 0;
const first = deals.length ? deals[deals.length - 1].date : generatedAt;
const dayMonth = (d: string) => new Date(d + 'T12:00:00Z').toLocaleDateString(loc, { day: 'numeric', month: 'short', timeZone: 'UTC' });
const latest6 = deals.slice(0, 6);   // newest approved money deals (deals is sorted newest first)

// charts (same component as the flagship reports)
const months = [...new Set(deals.map((d) => d.date.slice(0, 7)))].sort();
const monthLabel = (m: string) => new Date(m + '-15T12:00:00Z').toLocaleDateString(loc, { month: 'short', year: '2-digit' });
const chartMonths = { label: T.chart1, unit: T.unit1, kind: 'timeseries' as const, categories: months.map(monthLabel),
  series: [{ name: T.value, points: months.map((m) => Math.round(deals.filter((d) => moved(d) && d.date.startsWith(m)).reduce((s, d) => s + (d.amountUsd || 0), 0) / 1e5) / 10) }],
  source: 'Sqwod Deal Tracker' };
const cats = [...new Set(deals.map((d) => d.category))].sort((a, b) => deals.filter((d) => d.category === b).length - deals.filter((d) => d.category === a).length);
const chartCats = { label: T.chart2, unit: T.unit2, kind: 'categorical' as const, categories: cats.map(cName),
  series: [{ name: T.deals, points: cats.map((c) => deals.filter((d) => d.category === c).length) }], source: 'Sqwod Deal Tracker' };

const charts = [...(months.length >= 3 ? [chartMonths] : []), ...(cats.length >= 2 ? [chartCats] : [])];
const regions = ['DACH', 'UK', 'Europe', 'North America', 'Asia-Pacific', 'Middle East'].filter((r) => deals.some((d) => d.region === r));
const kinds = ['raise', 'acquisition', 'valuation', 'ipo', 'shutdown'].filter((k) => all.some((d) => d.kind === k));
const url = `https://sqwod.life/${lang}/intelligence/deals/`;
const citation = `Sqwod Intelligence. "Sqwod Deal Tracker." sqwod.life, ${new Date(generatedAt + 'T12:00:00Z').toLocaleDateString('en-GB', { month: 'short', year: 'numeric' })}. ${url}`;
const schema = { '@context': 'https://schema.org', '@type': 'Dataset', name: 'Sqwod Deal Tracker', description: T.sub, url, inLanguage: lang,
  creator: { '@type': 'Organization', name: 'Sqwod', url: 'https://sqwod.life' }, dateModified: generatedAt, temporalCoverage: `${first}/..`,
  distribution: [{ '@type': 'DataDownload', encodingFormat: 'text/csv', contentUrl: 'https://sqwod.life/data/deals.csv' }, { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: 'https://sqwod.life/data/deals.json' }] };
---
<Base lang={lang} title={T.title} description={T.sub} active="intelligence" image={ogPath('deals', lang)} noindex={deals.length < 10}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  {deals.length === 0 ? (
    <>
      <p class="kick"><a href={`/${lang}/intelligence`}>Sqwod Intelligence</a> / {T.h1}</p>
      <h1>{T.h1}</h1>
      <p class="sub">{T.sub}</p>
      <div class="note" style="margin-top:20px">{T.empty}</div>
    </>
  ) : (
    <>
      <!-- Hero (design "D", Oct 2026). Never add a chart of deal value by month up here:
           one big month next to a quiet one reads as "the money is drying up". -->
      <section class="dh">
        <div class="dh-l">
          <p class="kick dh-crumb"><a href={`/${lang}/intelligence`}>Sqwod Intelligence</a> / Deal Tracker</p>
          <p class="dh-live"><span class="pulse" aria-hidden="true"></span>{T.updatedOn} {dayMonth(generatedAt)} · {T.sinceShort} {dayMonth(first)}</p>
          <h1 class="dh-h1">{T.heroH1}</h1>
          <p class="dh-sub">{T.sub}</p>
          <div class="dh-kpis">
            <div><b class="dnum dh-acc">{usd(disclosed)}</b><span>{T.value}</span></div>
            <div><b class="dnum">{deals.length.toLocaleString(loc)}</b><span>{T.dealsShort}</span></div>
            <div><b class="dnum">{euShare}<small class="dh-pct">%</small></b><span>{T.eu}</span></div>
            <div><b class="dnum">{closures.length}</b><span>{T.closuresShort}</span></div>
          </div>
          <div class="dh-btns">
            <a class="dh-cta" href="#deals-signup" data-umami-event="deals-hero-cta" data-hero-cta>{T.cta}</a>
            <a class="dh-csv" href="/data/deals.csv" download data-umami-event="deals-csv" data-umami-event-where="hero">{T.csv}</a>
          </div>
        </div>
        <aside class="dh-panel" aria-labelledby="dh-latest">
          <h2 class="plain dh-ph" id="dh-latest">{T.latest}</h2>
          <ul class="dh-rows">
            {latest6.map((d) => (
              <li>
                <span class="dh-date">{dayMonth(d.date)}</span>
                <span class="dh-who"><b>{d.entity}</b><small>{T.kinds[d.kind] || d.kind} · {cName(d.category)}</small></span>
                {d.amount
                  ? <span class={`dnum dh-amt${d.kind === 'raise' ? ' dh-acc' : ''}`}>{d.amount}</span>
                  : <span class="dh-und">{T.undisclosed}</span>}
              </li>
            ))}
          </ul>
          <a class="dh-all" href="#all-deals">{T.seeAll(all.length)}</a>
          <p class="dh-pfoot">{T.panelFoot}</p>
        </aside>
        <a class="dh-csv-m" href="/data/deals.csv" download data-umami-event="deals-csv" data-umami-event-where="hero-phone">{T.csv}</a>
      </section>

      {charts.map((c, i) => <DataChart lang={lang} chart={c} index={i} total={charts.length} />)}

      <section class="dt-filters" id="all-deals" aria-label={T.region}>
        <div class="dt-chips" role="group">
          <button type="button" class="on" data-region="">{T.all}</button>
          <button type="button" data-region="europe-all">{T.eu}</button>
          {regions.map((r) => <button type="button" data-region={r}>{rName(r)}</button>)}
        </div>
        <div class="dt-row">
          <input type="search" placeholder={T.search} aria-label={T.search} data-q />
          <select aria-label={T.kind} data-kind><option value="">{T.kind}: {T.all}</option>{kinds.map((k) => <option value={k}>{T.kinds[k]}</option>)}</select>
          <select aria-label={T.cat} data-cat><option value="">{T.cat}: {T.all}</option>{cats.map((c) => <option value={c}>{cName(c)}</option>)}</select>
        </div>
        <p class="dt-count"><span data-count>{all.length}</span> {T.count}</p>
      </section>

      <div class="dt-wrap">
        <table class="dt">
          <thead><tr>{T.th.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>
            {all.map((d) => (
              <tr data-region={d.region} data-kind={d.kind} data-cat={d.category} data-name={`${d.entity} ${d.note}`.toLowerCase()}>
                <td class="dt-date">{fmtDate(d.date)}</td>
                <td><b>{d.entity}</b><span class="dt-note">{de && d.noteDe ? d.noteDe : d.note}</span></td>
                <td>{T.kinds[d.kind] || d.kind}</td>
                <td class="dt-amt">{d.amount ? <>{d.amount}{d.amountUsd && d.currency !== 'USD' ? <span class="dt-note">≈ {usd(d.amountUsd)}</span> : null}</> : <span class="dt-muted">{T.undisclosed}</span>}</td>
                <td>{d.country || rName(d.region)}</td>
                <td>{cName(d.category)}</td>
                <td class="dt-src">{d.url ? <a href={d.url} rel="nofollow noopener" target="_blank">{T.source} ↗</a> : null}{d.issue && isLiveIssue('published', d.issue.slice(-10)) ? <>{' '}<a href={d.issue.replace('/en/', `/${lang}/`)}>{T.daily}</a></> : null}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}

  <InlineSignup lang={lang} source="deal-tracker" id="deals-signup" head={T.signupHead} body={T.signupBody} />

  <section class="note dt-method">
    <b>{T.method}</b>
    <ul>{T.methodBody.map((l) => <li>{l}</li>)}</ul>
    {deals.length > 0 && <p><b>{T.download}:</b> <a href="/data/deals.csv" download>CSV</a> · <a href="/data/deals.json">JSON</a> · {T.updated} {fmtDate(generatedAt)}</p>}
    <p><b>{T.cite}:</b> {citation}</p>
  </section>
</Base>

<style>
  /* hero, design "D" (Oct 2026) */
  .dh{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);gap:40px;align-items:start;margin:0 0 8px}
  .dh-crumb{margin:0 0 14px}
  .dh-crumb a{color:inherit;text-decoration:none}
  .dh-crumb a:hover{color:var(--chalk)}
  .dh-live{display:inline-flex;align-items:center;gap:9px;margin:0 0 18px;padding:6px 13px;border:1px solid var(--accent-line);border-radius:999px;background:var(--accent-soft);font-size:13px;font-weight:600;color:var(--chalk)}
  .dh-live .pulse{box-shadow:0 0 8px 2px var(--accent-line)}
  .dh-h1{font-size:76px;line-height:.95;margin:0;hyphens:manual}
  .dh-sub{margin:18px 0 0;font-size:17px;line-height:1.5;color:var(--g2);max-width:58ch}
  .dh-kpis{display:grid;grid-template-columns:minmax(max-content,1.4fr) repeat(3,minmax(0,1fr));gap:10px;margin:24px 0 0}
  .dh-kpis div{border:1px solid var(--line);border-radius:14px;background:var(--panel);padding:14px 14px 12px;min-width:0}
  .dh-kpis b{display:block;font-size:46px;color:var(--chalk);white-space:nowrap}
  .dh-kpis span{display:block;font-size:13px;color:var(--g2);margin-top:6px;line-height:1.3}
  .dh-kpis .dh-acc,.dh-acc{color:var(--accent)}
  .dh-pct{font-size:.62em;margin-left:1px}
  .dh-btns{display:flex;flex-wrap:wrap;gap:10px;margin:22px 0 0}
  .dh-cta,.dh-csv{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 22px;border-radius:999px;font-size:15px;font-weight:600;text-decoration:none;white-space:nowrap}
  .dh-cta{background:var(--accent);color:var(--accent-ink)}
  .dh-cta:hover{background:var(--chalk);color:var(--ink)}
  .dh-csv{border:1px solid var(--edge);color:var(--chalk)}
  .dh-csv:hover{border-color:var(--accent);color:var(--accent)}
  .dh-panel{border:1px solid var(--line);border-radius:20px;background:var(--panel);padding:22px 22px 18px;min-width:0}
  .dh-ph{font-size:12px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--g2);margin:0 0 6px}
  .dh-rows{list-style:none;margin:0;padding:0}
  .dh-rows li{display:grid;grid-template-columns:52px minmax(0,1fr) auto;gap:12px;align-items:center;padding:11px 0;border-top:1px solid var(--line)}
  .dh-rows li:first-child{border-top:0}
  .dh-date{font-size:13px;color:var(--g2);white-space:nowrap}
  .dh-who{min-width:0}
  .dh-who b{display:block;font-size:15px;color:var(--chalk);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .dh-who small{display:block;font-size:12px;color:var(--g2);margin-top:2px}
  .dh-amt{font-size:24px;color:var(--chalk);white-space:nowrap;text-align:right}
  .dh-und{font-size:12px;color:var(--g2);text-align:right}
  .dh-all{display:inline-flex;align-items:center;min-height:44px;margin-top:4px;font-size:14px;font-weight:600;color:var(--chalk);text-decoration:underline;text-underline-offset:4px}
  .dh-all:hover{color:var(--accent)}
  .dh-pfoot{margin:4px 0 0;font-size:12px;color:var(--g2)}
  .dh-csv-m{display:none}
  @media(max-width:1100px) and (min-width:900px){.dh-h1{font-size:60px}.dh-kpis b{font-size:36px}}
  @media(max-width:899px){
    .dh{grid-template-columns:1fr;gap:0}
    .dh-crumb{margin-bottom:10px}
    .dh-live{margin-bottom:12px;font-size:12px}
    .dh-h1{font-size:50px}
    .dh-sub{font-size:15px;margin-top:12px}
    .dh-kpis{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:16px}
    .dh-kpis div{padding:10px 12px}
    .dh-kpis b{font-size:34px}
    .dh-kpis span{margin-top:4px;font-size:12.5px}
    .dh-btns{margin-top:14px}
    .dh-cta{width:100%}
    .dh-csv{display:none}
    .dh-panel{margin-top:28px}
    .dh-csv-m{display:flex;align-items:center;justify-content:center;min-height:44px;margin:8px auto 0;font-size:14px;font-weight:600;color:var(--chalk);text-decoration:underline;text-underline-offset:4px}
  }
  .dt-filters{margin:26px 0 10px}
  .dt-chips{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:10px}
  .dt-chips button{border:1px solid var(--line);background:var(--panel);color:var(--g1);border-radius:999px;padding:7px 13px;font:inherit;font-size:13px;cursor:pointer}
  .dt-chips button.on{background:var(--chalk);color:var(--ink);border-color:var(--chalk)}
  .dt-row{display:grid;grid-template-columns:1fr;gap:8px}
  @media(min-width:640px){.dt-row{grid-template-columns:2fr 1fr 1fr}}
  .dt-row input,.dt-row select{width:100%;box-sizing:border-box;border:1px solid var(--line);background:var(--panel);color:var(--chalk);border-radius:10px;padding:9px 11px;font:inherit;font-size:14px}
  .dt-count{font-size:12px;color:var(--g2);margin:8px 0 0}
  .dt-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:14px;background:var(--panel);margin-bottom:24px}
  .dt{width:100%;border-collapse:collapse;font-size:13.5px;min-width:720px}
  .dt th{text-align:left;font-weight:600;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--g2);padding:11px 12px;border-bottom:1px solid var(--line);white-space:nowrap}
  .dt td{padding:11px 12px;border-bottom:1px solid var(--line);vertical-align:top;color:var(--g1)}
  .dt tr:last-child td{border-bottom:0}
  .dt td b{color:var(--chalk)}
  .dt-note{display:block;font-size:12px;color:var(--g2);margin-top:3px;line-height:1.45}
  .dt-muted{color:var(--g3)}
  .dt-date{white-space:nowrap;font-family:var(--mono);font-size:12px;color:var(--g2)}
  .dt-amt{white-space:nowrap}
  .dt-src{white-space:nowrap;font-size:12.5px}
  .dt-src a{color:var(--g1)}
  .dt-method ul{margin:8px 0 10px;padding-left:18px}
  .dt-method p{margin:6px 0 0;word-break:break-word}
</style>

<script>
  // Hero CTA: a sign-up that starts from the hero is recorded as source "deal-tracker-hero".
  document.querySelector('[data-hero-cta]')?.addEventListener('click', () => {
    const src = document.querySelector<HTMLInputElement>('#deals-signup input[name="source"]');
    if (src) src.value = 'deal-tracker-hero';
  });
  const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>('.dt tbody tr'));
  const q = document.querySelector<HTMLInputElement>('[data-q]');
  const kind = document.querySelector<HTMLSelectElement>('[data-kind]');
  const cat = document.querySelector<HTMLSelectElement>('[data-cat]');
  const count = document.querySelector('[data-count]');
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.dt-chips button'));
  let region = '';
  const EUROPE = new Set(['DACH', 'UK', 'Europe']);
  function apply() {
    const s = (q?.value || '').trim().toLowerCase();
    let n = 0;
    for (const r of rows) {
      const okR = !region || (region === 'europe-all' ? EUROPE.has(r.dataset.region || '') : r.dataset.region === region);
      const ok = okR && (!kind?.value || r.dataset.kind === kind.value) && (!cat?.value || r.dataset.cat === cat.value) && (!s || (r.dataset.name || '').includes(s));
      r.hidden = !ok; if (ok) n++;
    }
    if (count) count.textContent = String(n);
  }
  chips.forEach((b) => b.addEventListener('click', () => { region = b.dataset.region || ''; chips.forEach((c) => c.classList.toggle('on', c === b)); apply(); }));
  q?.addEventListener('input', apply); kind?.addEventListener('change', apply); cat?.addEventListener('change', apply);
</script>
