---
// Sqwod Investor Map: who funds, buys and supports fitness and wellness companies.
// Directory: automation/investors.json (researched, Tee-reviewed). Deals: src/lib/investors.ts merges
// every backer and buyer named on a live Deal Tracker entry and the CB Insights / Crunchbase enrichment.
// Three parts: a faceted filter (sidebar on desktop, sheet on phones, state in the URL), the cards,
// and the Investor Matcher (a scored shortlist from a short form; top 5 free, the rest after sign-up).
import Base from '../../../layouts/Base.astro';
import { ogPath } from '../../../lib/og';
import InlineSignup from '../../../components/InlineSignup.astro';
import DealGlyphs from '../../../components/DealGlyphs.astro';
import DealIcon from '../../../components/DealIcon.astro';
import Flag from '../../../components/Flag.astro';
import { flagCode, countryName, COUNTRY_CODE } from '../../../lib/flags';
import { investors, regionOf, TYPE_LABEL, TYPE_PLURAL, TYPE_HELP, STAGE_LABEL, FOCUS_LABEL, BAND_LABEL, STAGES, FOCUS, BANDS, type InvestorType } from '../../../lib/investors';
import { generatedAt } from '../../../lib/deals';
import { PITCH } from '../../../config/pitch';
import { SUBSCRIBE } from '../../../config/subscribe';
import { languages, type Lang } from '../../../i18n/ui';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const de = lang === 'de';
const loc = de ? 'de-DE' : 'en-GB';
const all = investors();
const CHECKED = '2026-10-31';
const today = generatedAt;   // the day the data was built (the site rebuilds every weekday)
const isOpen = (i: (typeof all)[number]) => !!i.apply && (i.apply.status === 'rolling' || (i.apply.status === 'open' && (!i.apply.deadline || i.apply.deadline >= today)));
const withDeals = all.filter((i) => i.deals.length);
const countries = [...new Set(all.map((i) => i.country).filter(Boolean))];
const openCalls = all.filter(isOpen);
const REGIONS = ['DACH', 'UK', 'Europe', 'North America', 'Asia-Pacific', 'Middle East', 'Latin America', 'Other'];
const regions = REGIONS.filter((r) => all.some((i) => i.region === r));
const types: InvestorType[] = ['vc', 'corporate', 'accelerator', 'competition', 'grant', 'buyer'];
const REGION_FLAGS: Record<string, string[]> = { 'europe-all': ['eu'], DACH: ['de', 'at', 'ch'], UK: ['gb'], Europe: ['eu'], 'North America': ['us', 'ca'] };
const flagCodes = [...new Set([...all.map((i) => flagCode(i.country)), ...Object.values(REGION_FLAGS).flat()])].filter(Boolean);
const fmtDate = (d: string) => new Date(d + 'T12:00:00Z').toLocaleDateString(loc, { day: '2-digit', month: 'short', year: 'numeric' });
const REGION_DE: Record<string, string> = { DACH: 'DACH', UK: 'UK', Europe: 'Europa', 'North America': 'Nordamerika', 'Asia-Pacific': 'Asien-Pazifik', 'Middle East': 'Naher Osten', 'Latin America': 'Lateinamerika', Other: 'Andere' };
const rName = (r: string) => (de ? REGION_DE[r] || r : r);
const count = (f: (i: (typeof all)[number]) => boolean) => all.filter(f).length;
// countries by number of entries, for the facet list
const countryRows = countries.map((c) => ({ c, code: flagCode(c), n: count((i) => i.country === c), region: regionOf(c) })).sort((a, b) => b.n - a.n || a.c.localeCompare(b.c));
// every country a founder can pick in the matcher, grouped by region
const pickCountries = Object.keys(COUNTRY_CODE).filter((c) => c !== 'European Union').map((c) => ({ c, region: regionOf(c) })).sort((a, b) => countryName(a.c, lang).localeCompare(countryName(b.c, lang), loc));
const pickGroups = REGIONS.map((r) => ({ r, list: pickCountries.filter((x) => x.region === r) })).filter((g) => g.list.length);
// short money: 22000000 -> $22M. No regex literal here on purpose: the Astro compiler mis-hoists getStaticPaths when the frontmatter holds /\.0$/.
const trim0 = (s: string) => (s.endsWith(".0") ? s.slice(0, -2) : s);
function fmtUsd(n: number): string {
  if (n >= 1e9) return "$" + trim0((n / 1e9).toFixed(1)) + "B";
  if (n >= 1e6) return "$" + trim0((n / 1e6).toFixed(1)) + "M";
  if (n >= 1e3) return "$" + Math.round(n / 1e3) + "K";
  return "$" + n;
}

const T = de ? {
  title: 'Sqwod Investor Map: Wer Fitness und Wellness finanziert',
  heroH1: 'Wer Fitness und Wellness finanziert.',
  sub: 'Fonds, Corporates, Accelerators, Wettbewerbe und Förderprogramme für Gründer:innen in Fitness, Wellness und Health-Tech, plus jeder Geldgeber und Käufer aus dem Deal Tracker. Mit Portfolio-Daten von CB Insights und Crunchbase, Quelle und Prüfdatum.',
  crumb: 'Investor Map', checked: 'Geprüft', entries: 'Einträge', withDeals: 'mit Deals im Tracker', countries: 'Länder', open: 'offene Aufrufe',
  cta: 'Passende Investoren finden →', tracker: 'Zum Deal Tracker', globe: '3D-Globus öffnen', globeKick: 'Investor Globe', globeH: 'Alle Investoren auf einem drehbaren Globus.', globeP: 'Punkt = Sitz, Größe = Investments der letzten 12 Monate, Bogen = ein Deal aus dem Tracker in einem anderen Land. Mit Tour durch die Regionen.',
  all: 'Alle', region: 'Region', country: 'Land', eu: 'Europa & DACH', search: 'Investor, Programm oder Portfolio-Firma suchen …', count: 'Einträge', clear: 'Alle Filter löschen', none: 'Kein Eintrag passt zu diesen Filtern.',
  filters: 'Filter', showResults: 'Einträge anzeigen', close: 'Schließen', more: 'Alle anzeigen', less: 'Weniger anzeigen',
  fType: 'Art', fStage: 'Phase', fCheck: 'Ticketgröße', fFocus: 'Fokus', fActivity: 'Aktivität & Zugang',
  openNow: 'Jetzt offen', hasDeals: 'Deals im Tracker', active12: 'Aktiv in den letzten 12 Monaten', abroad: 'Investiert außerhalb der Heimatregion', leads: 'Führt Runden an', hasData: 'Mit Portfolio-Daten',
  sort: 'Sortieren', sorts: { active: 'Aktivste zuerst', deals: 'Meiste Deals im Tracker', recent: 'Zuletzt aktiv', open: 'Offene Aufrufe zuerst', az: 'A bis Z' } as Record<string, string>,
  types: TYPE_PLURAL.de as Record<string, string>, typeHelp: TYPE_HELP.de as Record<string, string>, typeLegend: 'Was bedeuten die Typen?',
  stage: 'Phase', check: 'Ticket', typical: 'Typische Runde', deals: 'Deals im Tracker', recent: 'Zuletzt investiert', lead: 'Lead', deadline: 'Bewerbung bis', rolling: 'Laufende Bewerbung', closed: 'Bewerbung geschlossen', tba: 'Termine werden angekündigt', site: 'Website ↗', source: 'Quelle', fromDeals: 'aus dem Deal Tracker', founded: 'gegr.', inLast12: 'in 12 Monaten', investments: 'Investments',
  // matcher
  mKick: 'Investor Matcher', mH: 'Welche Investoren passen zu deiner Firma?', mSub: 'Beschreib dein Unternehmen in fünf Feldern. Du bekommst eine Rangliste mit Match-Score und den Daten dahinter: Phase, Portfolio, Ticketgröße, Standort, Aktivität.',
  mCat: 'Was baust du?', mStage: 'Phase', mCountry: 'Land', mAmount: 'Gesuchte Summe', mWant: 'Was suchst du?', mKeys: 'Stichworte (optional)', mKeysPh: 'z. B. Boutique-Studio, Recovery, Protein, Coaching-App',
  wants: { money: 'Investment', programme: 'Accelerator oder Programm', grant: 'Förderung oder Wettbewerb', buyer: 'Käufer / Exit' } as Record<string, string>,
  mBtn: 'Investoren finden', mReset: 'Zurücksetzen', mResults: 'Treffer', mTop: 'Deine Top 5', mScore: 'Match', mWhy: 'Warum',
  mLockH: 'Die komplette Liste nach Anmeldung', mLockP: 'Sqwod Daily ist kostenlos. Nach der Bestätigung siehst du alle Treffer mit Score und Daten, auf diesem Gerät dauerhaft.', mLocked: 'weitere Treffer nach der Anmeldung', mUnlocked: 'Fast geschafft: bestätige die Mail in deinem Postfach. Deine komplette Liste ist auf diesem Gerät freigeschaltet.', mSignupErr: 'Die Anmeldung hat nicht geklappt. Bitte E-Mail prüfen und noch einmal versuchen.',
  mNone: 'Kein Investor passt zu dieser Kombination. Lockere Phase, Summe oder „Was suchst du?“.',
  pitchH: 'Oder füg deinen Pitch ein', pitchP: 'Zwei bis zehn Sätze reichen: was du baust, für wen, wo, wie weit du bist, was du suchst. Claude liest den Pitch gegen alle Einträge und begründet jede Empfehlung mit den Daten.', pitchPh: 'Wir bauen … für … in … Wir sind in Phase … und suchen …', pitchBtn: 'KI-Einschätzung holen', pitchLocked: 'Kostenlos nach Anmeldung', pitchSoon: 'Die KI-Einschätzung geht in Kürze live.', pitchWait: 'Pitch wird gelesen …', pitchErr: 'Das hat nicht geklappt. Bitte in einer Minute noch einmal versuchen.', pitchQuota: 'Fünf Einschätzungen pro Tag sind frei. Morgen wieder.', pitchShort: 'Bitte mindestens zwei Sätze.', aiRead: 'KI-Einschätzung', aiTop: 'Top 10 laut KI', aiNote: 'Modell: {m}. Jede Begründung steht neben den Daten, aus denen sie kommt. Prüf sie, bevor du schreibst.',
  ev: { stage: 'Phase', focus: 'Fokus', geo: 'Standort', check: 'Ticket', activity: 'Aktivität', portfolio: 'Portfolio', sameCountry: 'gleiches Land', sameRegion: 'gleiche Region', abroad: 'investiert auch außerhalb der Heimatregion', otherRegion: 'andere Region', unknown: 'keine Angabe', open: 'Aufruf offen', none: 'keine passende Phase', adjacent: 'angrenzende Phase', noFocus: 'kein Fokus-Treffer', fits: 'passt', near: 'nahe dran', off: 'außerhalb', last: 'zuletzt', inv12: 'Investments in 12 Monaten', tracker: 'im Deal Tracker' },
  method: 'So entsteht die Investor Map',
  methodBody: [
    'Verzeichnis: am 31. Oktober 2026 per Websuche recherchiert, jeder Eintrag mit Quelle und Vertrauensstufe (Certain = Aussage der Organisation oder Primärbericht, Likely = über mehrere Profile hinweg konsistent).',
    'Deals: jeder Investor und Käufer, der auf einem freigegebenen Deal im Deal Tracker genannt wird, erscheint hier automatisch, auch ohne Verzeichniseintrag.',
    'Portfolio und Sitz: CB Insights (Investments, Profil) für alle Einträge, Crunchbase (Phasen, Gründung) für die aktivsten 20. Abgerufen am 31. Oktober 2026; die Zahl der Investments ist eine Untergrenze (maximal zehn Zeilen je Investor abgefragt).',
    'Match-Score: Phase 25, Fokus 30, Standort 15, Ticket 15, Aktivität 15 Punkte; ein Investor mit klarem, aber anderem Fokus verliert 10. Angezeigt wird, was 45 oder mehr erreicht. Jede Zeile zeigt die Daten dahinter. Keine KI, nur Regeln, damit du das Ergebnis nachvollziehen kannst.',
    'Bewerbungsfristen ändern sich. Vor einer Bewerbung immer die Seite des Programms prüfen.',
    'Fehlt ein Fonds oder Programm? Schreib an hello@sqwod.life.',
  ],
  signupHead: 'Jeden Deal am Morgen, bevor er Thema ist', signupBody: 'Sqwod Daily: Geld, Deals und was sie für dein Business heißen. Werktäglich, kostenlos.',
} : {
  title: 'Sqwod Investor Map: who funds fitness and wellness',
  heroH1: 'Who funds fitness and wellness.',
  sub: 'Funds, corporates, accelerators, competitions and grants for founders in fitness, wellness and health tech, plus every backer and buyer from the Deal Tracker. With portfolio data from CB Insights and Crunchbase, a source and a check date.',
  crumb: 'Investor Map', checked: 'Checked', entries: 'entries', withDeals: 'with deals in the tracker', countries: 'countries', open: 'open calls',
  cta: 'Find my investors →', tracker: 'Open the Deal Tracker', globe: 'Open the 3D globe', globeKick: 'Investor Globe', globeH: 'Every investor on a globe you can spin.', globeP: 'Dot = HQ, size = investments in the last 12 months, arc = a tracker deal in another country. With a tour through the regions.',
  all: 'All', region: 'Region', country: 'Country', eu: 'Europe & DACH', search: 'Search an investor, programme or portfolio company…', count: 'entries', clear: 'Clear all filters', none: 'No entries match these filters.',
  filters: 'Filters', showResults: 'Show results', close: 'Close', more: 'Show all', less: 'Show fewer',
  fType: 'Type', fStage: 'Stage', fCheck: 'Cheque size', fFocus: 'Focus', fActivity: 'Activity & access',
  openNow: 'Open now', hasDeals: 'Deals in the tracker', active12: 'Active in the last 12 months', abroad: 'Invests outside home region', leads: 'Leads rounds', hasData: 'With portfolio data',
  sort: 'Sort', sorts: { active: 'Most active first', deals: 'Most deals in the tracker', recent: 'Recently active', open: 'Open calls first', az: 'A to Z' } as Record<string, string>,
  types: TYPE_PLURAL.en as Record<string, string>, typeHelp: TYPE_HELP.en as Record<string, string>, typeLegend: 'What do the types mean?',
  stage: 'Stage', check: 'Cheque', typical: 'Typical round', deals: 'Deals in the tracker', recent: 'Recent investments', lead: 'lead', deadline: 'Apply by', rolling: 'Rolling applications', closed: 'Applications closed', tba: 'Dates to be announced', site: 'Website ↗', source: 'Source', fromDeals: 'from the Deal Tracker', founded: 'est.', inLast12: 'in 12 months', investments: 'investments',
  mKick: 'Investor Matcher', mH: 'Which investors fit your company?', mSub: 'Describe your company in five fields. You get a ranked shortlist with a match score and the data behind it: stage, portfolio, cheque size, location, activity.',
  mCat: 'What are you building?', mStage: 'Stage', mCountry: 'Country', mAmount: 'Amount you are raising', mWant: 'What do you want?', mKeys: 'Keywords (optional)', mKeysPh: 'e.g. boutique studio, recovery, protein, coaching app',
  wants: { money: 'Investment', programme: 'Accelerator or programme', grant: 'Grant or competition', buyer: 'Buyer / exit' } as Record<string, string>,
  mBtn: 'Find investors', mReset: 'Reset', mResults: 'matches', mTop: 'Your top 5', mScore: 'Match', mWhy: 'Why',
  mLockH: 'The full list after sign-up', mLockP: 'Sqwod Daily is free. Once you confirm, every match with its score and data is unlocked on this device for good.', mLocked: 'more matches after sign-up', mUnlocked: 'Almost there: confirm the email in your inbox. Your full list is unlocked on this device.', mSignupErr: 'The sign-up did not go through. Please check the email address and try again.',
  mNone: 'No investor fits this combination. Loosen the stage, the amount or “What do you want?”.',
  pitchH: 'Or paste your pitch', pitchP: 'Two to ten sentences are enough: what you build, for whom, where, how far you are, what you want. Claude reads the pitch against every entry and backs each pick with the data.', pitchPh: 'We build … for … in … We are at … stage and are raising …', pitchBtn: 'Get the AI read', pitchLocked: 'Free after sign-up', pitchSoon: 'The AI read goes live shortly.', pitchWait: 'Reading your pitch…', pitchErr: 'That did not work. Please try again in a minute.', pitchQuota: 'Five reads a day are free. Come back tomorrow.', pitchShort: 'Please write at least two sentences.', aiRead: 'AI read', aiTop: 'Top 10 by AI', aiNote: 'Model: {m}. Every reason sits next to the data it came from. Check it before you write.',
  ev: { stage: 'Stage', focus: 'Focus', geo: 'Location', check: 'Cheque', activity: 'Activity', portfolio: 'Portfolio', sameCountry: 'same country', sameRegion: 'same region', abroad: 'also invests outside its home region', otherRegion: 'other region', unknown: 'not stated', open: 'call open', none: 'no matching stage', adjacent: 'adjacent stage', noFocus: 'no focus match', fits: 'fits', near: 'close', off: 'outside', last: 'last', inv12: 'investments in 12 months', tracker: 'in the Deal Tracker' },
  method: 'How the Investor Map is built',
  methodBody: [
    'Directory: researched by web search on 31 October 2026, every entry with a source and a confidence level (Certain = stated by the organisation or a primary report, Likely = consistent across several profiles).',
    'Deals: every investor and buyer named on an approved Deal Tracker entry appears here automatically, with or without a directory entry.',
    'Portfolio and HQ: CB Insights (investments, profile) for every entry, Crunchbase (stages, founding year) for the 20 most active. Pulled on 31 October 2026; investment counts are a floor (at most ten rows requested per investor).',
    'Match score: stage 25, focus 30, location 15, cheque 15, activity 15 points; an investor with a clear but different focus loses 10. Anything scoring 45 or more is shown. Every line shows the data behind it. Rules, not AI, so you can check the result.',
    'Application deadlines move. Always check the programme’s own page before applying.',
    'Missing a fund or programme? Write to hello@sqwod.life.',
  ],
  signupHead: 'Every deal, in your inbox before it is old news', signupBody: 'Sqwod Daily: money, deals and what they mean for your business. Every weekday, free.',
};
const url = `https://sqwod.life/${lang}/intelligence/investors/`;
const schema = { '@context': 'https://schema.org', '@type': 'Dataset', name: 'Sqwod Investor Map', description: T.sub, url, inLanguage: lang, license: `https://sqwod.life/${lang}/data-licence/`, isAccessibleForFree: true,
  creator: { '@type': 'Organization', name: 'Sqwod', url: 'https://sqwod.life' }, dateModified: CHECKED };
const applyLine = (i: (typeof all)[number]) => {
  if (!i.apply) return '';
  const s = i.apply.status;
  const base = s === 'open' ? (i.apply.deadline ? `${T.deadline} ${fmtDate(i.apply.deadline)}` : T.openNow) : s === 'rolling' ? T.rolling : s === 'closed' ? T.closed : T.tba;
  const note = de ? i.apply.noteDe || i.apply.note : i.apply.note;
  return note ? `${base} · ${note}` : base;
};
const stageLine = (i: (typeof all)[number]) => i.stage || (i.stages.length ? (i.stages.length === STAGES.length ? T.all : `${STAGE_LABEL[lang][i.stages[0]]}${i.stages.length > 1 ? ` – ${STAGE_LABEL[lang][i.stages[i.stages.length - 1]]}` : ''}`) : '');
// compact client data for the matcher (one row per investor)
const data = all.map((i) => ({ id: i.id, n: i.name, t: i.type, c: i.country, cc: flagCode(i.country), r: i.region, city: i.city || '', st: i.stages, sf: i.stagesFrom, min: i.checkMin, max: i.checkMax, chk: i.check || '', typ: i.typicalRound, f: i.focusTags,
  p: i.portfolio.map((r) => r[1]), d: i.deals.slice(0, 3).map((d) => d.entity), tot: i.dealsTotal, a12: i.active12m, last: i.lastDeal, open: isOpen(i) ? 1 : 0, lead: i.leadsRounds ? 1 : 0, ab: i.abroad ? 1 : 0, kw: `${i.name} ${i.focus} ${i.portfolio.map((r) => r[1]).join(' ')} ${i.deals.map((d) => d.entity).join(' ')}`.toLowerCase(), cbi: i.enrich?.cbi?.url || '', cb: i.enrich?.cb?.permalink ? `https://www.crunchbase.com/organization/${i.enrich.cb.permalink}` : '' }));
---
<Base lang={lang} title={T.title} description={T.sub} active="tools" image={ogPath('investors', lang)}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <DealGlyphs flags={flagCodes} />
  <section class="ih">
    <p class="kick ih-crumb"><a href={`/${lang}/intelligence`}>Sqwod Intelligence</a> / <a href={`/${lang}/intelligence/deals/`}>Deal Tracker</a> / {T.crumb}</p>
    <p class="ih-live"><span class="pulse" aria-hidden="true"></span>{T.checked} {fmtDate(CHECKED)}</p>
    <h1 class="ih-h1">{T.heroH1}</h1>
    <p class="ih-sub">{T.sub}</p>
    <p class="ih-links"><a href="#matcher" data-umami-event="investors-hero-cta">{T.cta}</a><a href={`/${lang}/intelligence/investors/map/`}>{T.globe} →</a><a href={`/${lang}/intelligence/deals/`}>{T.tracker} →</a></p>
  </section>

  <div class="pg">
  <!-- Filter + list -->
  <div class="fx" id="all-investors">
    <div class="fx-bar">
      <label class="dt-q">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        <input type="search" placeholder={T.search} aria-label={T.search} autocomplete="off" enterkeyhint="search" data-q />
      </label>
      <button type="button" class="fx-open" data-fx-open aria-controls="fx-side" aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4" /></svg>{T.filters}<b data-fx-n hidden></b>
      </button>
      <span class="dt-sel fx-sort"><select aria-label={T.sort} data-sort>{Object.entries(T.sorts).map(([v, l]) => <option value={v}>{T.sort}: {l}</option>)}</select></span>
    </div>
    <p class="dt-count fx-count"><span><b data-shown>{all.length}</b> {T.count}</span><button type="button" class="dt-clear" data-clear hidden>{T.clear}</button></p>
    <ul class="fx-chips" data-fx-chips aria-label={T.filters}></ul>

    <aside class="fx-side" id="fx-side" data-fx-side aria-label={T.filters}>
      <div class="fx-side-head"><b>{T.filters}</b><button type="button" class="fx-x" data-fx-close aria-label={T.close}>×</button></div>
      <div class="fx-side-body">
        <details class="fx-g" open><summary>{T.fType}</summary><div>
          {types.map((t) => <label class="fx-opt" title={T.typeHelp[t]}><input type="checkbox" name="type" value={t} /><span>{T.types[t]}</span><i data-n>{count((i) => i.type === t)}</i></label>)}
          <details class="fx-help"><summary>{T.typeLegend}</summary><ul>{types.map((t) => <li><b>{T.types[t]}:</b> {T.typeHelp[t]}</li>)}</ul></details>
        </div></details>
        <details class="fx-g" open><summary>{T.region}</summary><div>
          <label class="fx-opt"><input type="checkbox" name="region" value="europe-all" /><span>{T.eu}</span><i data-n>{count((i) => ['DACH', 'UK', 'Europe'].includes(i.region))}</i></label>
          {regions.map((r) => <label class="fx-opt"><input type="checkbox" name="region" value={r} /><span>{rName(r)}</span><i data-n>{count((i) => i.region === r)}</i></label>)}
        </div></details>
        <details class="fx-g"><summary>{T.country}</summary><div data-fx-more>
          {countryRows.map((x, k) => <label class="fx-opt" hidden={k >= 8}><input type="checkbox" name="country" value={x.c} data-region={x.region} /><span><Flag code={x.code} />{countryName(x.c, lang)}</span><i data-n>{x.n}</i></label>)}
          {countryRows.length > 8 && <button type="button" class="fx-more" data-fx-toggle data-more={T.more} data-less={T.less}>{T.more} ({countryRows.length})</button>}
        </div></details>
        <details class="fx-g" open><summary>{T.fStage}</summary><div>
          {STAGES.map((s) => <label class="fx-opt"><input type="checkbox" name="stage" value={s} /><span>{STAGE_LABEL[lang][s]}</span><i data-n>{count((i) => i.stages.includes(s))}</i></label>)}
        </div></details>
        <details class="fx-g"><summary>{T.fCheck}</summary><div>
          {BAND_LABEL.map((b, k) => <label class="fx-opt"><input type="checkbox" name="band" value={k} /><span>{b}</span><i data-n>{count((i) => i.bands.includes(k))}</i></label>)}
        </div></details>
        <details class="fx-g" open><summary>{T.fFocus}</summary><div>
          {FOCUS.map((f) => <label class="fx-opt"><input type="checkbox" name="focus" value={f} /><span>{FOCUS_LABEL[lang][f]}</span><i data-n>{count((i) => i.focusTags.includes(f))}</i></label>)}
        </div></details>
        <details class="fx-g" open><summary>{T.fActivity}</summary><div>
          <label class="fx-opt"><input type="checkbox" name="open" value="1" /><span>{T.openNow}</span><i data-n>{openCalls.length}</i></label>
          <label class="fx-opt"><input type="checkbox" name="deals" value="1" /><span>{T.hasDeals}</span><i data-n>{withDeals.length}</i></label>
          <label class="fx-opt"><input type="checkbox" name="active" value="1" /><span>{T.active12}</span><i data-n>{count((i) => i.active12m > 0)}</i></label>
          <label class="fx-opt"><input type="checkbox" name="abroad" value="1" /><span>{T.abroad}</span><i data-n>{count((i) => i.abroad)}</i></label>
          <label class="fx-opt"><input type="checkbox" name="leads" value="1" /><span>{T.leads}</span><i data-n>{count((i) => i.leadsRounds)}</i></label>
          <label class="fx-opt"><input type="checkbox" name="data" value="1" /><span>{T.hasData}</span><i data-n>{count((i) => !!i.enrich?.cbi?.url)}</i></label>
        </div></details>
      </div>
      <div class="fx-side-foot"><button type="button" class="dt-clear" data-clear>{T.clear}</button><button type="button" class="ih-cta fx-show" data-fx-close><span data-shown-2>{all.length}</span>&nbsp;{T.showResults}</button></div>
    </aside>
    <div class="fx-veil" data-fx-close hidden></div>

    <ul class="iv-list">
      {all.map((i) => (
        <li class="iv" id={i.id} data-type={i.type} data-region={i.region} data-country={i.country} data-stage={i.stages.join(' ')} data-band={i.bands.join(' ')} data-focus={i.focusTags.join(' ')}
          data-open={isOpen(i) ? '1' : ''} data-deals={i.deals.length ? '1' : ''} data-active={i.active12m > 0 ? '1' : ''} data-abroad={i.abroad ? '1' : ''} data-leads={i.leadsRounds ? '1' : ''} data-data={i.enrich?.cbi?.url ? '1' : ''}
          data-a12={i.active12m} data-tot={i.dealsTotal} data-nd={i.deals.length} data-last={i.lastDeal} data-az={i.name.toLowerCase()}
          data-name={`${i.name} ${i.country} ${i.city || ''} ${i.focus} ${i.portfolio.map((r) => r[1]).join(' ')} ${i.deals.map((d) => d.entity).join(' ')}`.toLowerCase()}>
          <div class="iv-top">
            <h3 class="iv-name">{i.url ? <a href={i.url} rel="noopener" target="_blank">{i.name}</a> : i.name}</h3>
            <span class={`iv-type iv-type-${i.type}`} title={T.typeHelp[i.type]}>{TYPE_LABEL[lang][i.type]}</span>
          </div>
          {(i.country || i.stages.length || i.check || i.founded) && (
            <p class="iv-meta">
              {i.country && <><Flag country={i.country} />{countryName(i.country, lang)}{i.city ? `, ${i.city}` : ''}</>}
              {i.founded && <span>{T.founded} {i.founded}</span>}
              {stageLine(i) && <span>{stageLine(i)}</span>}
              {i.check ? <span>{i.check}</span> : i.typicalRound ? <span>{T.typical} {fmtUsd(i.typicalRound)}</span> : null}
            </p>
          )}
          {i.focusTags.length > 0 && <p class="iv-tags">{i.focusTags.map((f) => <button type="button" class="iv-tag" data-tag={f}>{FOCUS_LABEL[lang][f]}</button>)}</p>}
          {i.focus && <p class="iv-focus">{de ? i.focusDe || i.focus : i.focus}</p>}
          {i.deals.length > 0 && (
            <p class="iv-deals"><b>{T.deals}:</b> {i.deals.map((d, k) => <>{k > 0 && ' · '}<a href={`/${lang}/intelligence/deals/#deal-${d.id}`}><DealIcon kind={d.kind} />{d.entity}</a>{d.amount && <span class="iv-amt"> {d.amount}</span>}{d.lead && d.role === 'investor' && <i> ({T.lead})</i>}</>)}</p>
          )}
          {i.portfolio.length > 0 && (
            <p class="iv-port"><b>{T.recent}:</b> {i.portfolio.map((r, k) => <>{k > 0 && ' · '}<span>{r[1]}<i> {r[2]}{r[3] ? `, ${fmtUsd(r[3])}` : ''}</i></span></>)}
              {i.active12m > 0 && <span class="iv-act"> · <b>{i.active12m}</b> {T.inLast12}</span>}</p>
          )}
          {i.apply && <p class={`iv-apply${isOpen(i) ? ' is-open' : ''}`}>{applyLine(i)}</p>}
          <p class="iv-src">{i.inDirectory
            ? <>{`${T.checked} ${fmtDate(i.checked)} · `}<a href={i.source} rel="nofollow noopener" target="_blank">{T.source} ↗</a> · {i.confidence}</>
            : <>{T.fromDeals}</>}
            {i.enrich?.cbi?.url && <> · <a href={i.enrich.cbi.url} rel="nofollow noopener" target="_blank">CB Insights ↗</a></>}
            {i.enrich?.cb?.permalink && <> · <a href={`https://www.crunchbase.com/organization/${i.enrich.cb.permalink}`} rel="nofollow noopener" target="_blank">Crunchbase ↗</a></>}</p>
        </li>
      ))}
      <li class="dt-none" data-none hidden>{T.none}<button type="button" class="dt-clear" data-clear>{T.clear}</button></li>
    </ul>
  </div>

  <aside class="sb" aria-label={T.mKick}>
  <a class="gb" href={`/${lang}/intelligence/investors/map/`} data-umami-event="investors-globe">
    <img class="gb-poster" src="/img/investor-globe-800.jpg" srcset="/img/investor-globe-800.jpg 800w, /img/investor-globe.jpg 1600w" sizes="(max-width: 899px) 100vw, 300px" width="800" height="450" alt="" loading="lazy" decoding="async" />
    <span class="gb-txt"><span class="kick">{T.globeKick}</span><b>{T.globeH}</b><span class="gb-p">{T.globeP}</span><span class="gb-cta">{T.globe} →</span></span>
  </a>
  <!-- Investor Matcher -->
  <section class="mt" id="matcher" aria-labelledby="mt-h">
    <p class="kick">{T.mKick}</p>
    <h2 id="mt-h" class="mt-h">{T.mH}</h2>
    <p class="mt-sub">{T.mSub}</p>
    <form class="mt-form" data-mt-form novalidate>
      <label><span>{T.mCat}</span><span class="dt-sel"><select name="cat" required><option value="">…</option>{FOCUS.map((k) => <option value={k}>{FOCUS_LABEL[lang][k]}</option>)}</select></span></label>
      <label><span>{T.mStage}</span><span class="dt-sel"><select name="stage" required><option value="">…</option>{STAGES.map((k) => <option value={k}>{STAGE_LABEL[lang][k]}</option>)}</select></span></label>
      <label><span>{T.mCountry}</span><span class="dt-sel"><select name="country"><option value="">…</option>{pickGroups.map((g) => <optgroup label={rName(g.r)}>{g.list.map((x) => <option value={x.c}>{countryName(x.c, lang)}</option>)}</optgroup>)}</select></span></label>
      <label><span>{T.mAmount}</span><span class="dt-sel"><select name="band"><option value="">…</option>{BAND_LABEL.map((b, k) => <option value={k}>{b}</option>)}</select></span></label>
      <fieldset class="mt-want"><legend>{T.mWant}</legend>
        {Object.entries(T.wants).map(([v, l]) => <label class="mt-pill"><input type="checkbox" name="want" value={v} checked={v === 'money'} /><span>{l}</span></label>)}
      </fieldset>
      <label class="mt-keys"><span>{T.mKeys}</span><input type="text" name="kw" placeholder={T.mKeysPh} autocomplete="off" /></label>
      <div class="mt-btns"><button type="submit" class="ih-cta" data-umami-event="investor-match">{T.mBtn}</button><button type="reset" class="dt-clear" data-mt-reset hidden>{T.mReset}</button></div>
    </form>
    <dialog class="mt-dlg" data-mt-dlg aria-labelledby="mt-dlg-h">
      <div class="mt-dlg-head"><p class="kick" id="mt-dlg-h">{T.mKick}</p><button type="button" class="gl-x" data-mt-close aria-label={T.close}>×</button></div>
    <div class="mt-out" data-mt-out hidden>
      <p class="mt-count"><b data-mt-n>0</b> {T.mResults} · <span data-mt-top>{T.mTop}</span></p>
      <p class="mt-summary" data-mt-summary hidden></p>
      <ol class="mt-list" data-mt-list></ol>
      <div class="mt-lock" data-mt-lock hidden>
        <p class="mt-lock-n"><b data-mt-more>0</b> {T.mLocked}</p>
        <InlineSignup lang={lang} source="investor-match" id="matcher-signup" head={T.mLockH} body={T.mLockP} role="brand" event="investor-match-signup" />
      </div>
      <p class="mt-none" data-mt-none hidden>{T.mNone}</p>
      <p class="mt-ainote" data-mt-ainote hidden></p>
    </div>
    </dialog>
    <div class="mt-pitch" data-pitch data-endpoint={PITCH.endpoint} data-max={PITCH.maxChars}>
      <h3 class="mt-pitch-h">{T.pitchH}</h3>
      <p class="mt-sub">{T.pitchP}</p>
      {PITCH.endpoint ? (
        <>
          <textarea name="pitch" rows="4" maxlength={PITCH.maxChars} placeholder={T.pitchPh} aria-label={T.pitchH} data-pitch-text></textarea>
          <div class="mt-btns"><button type="button" class="ih-cta" data-pitch-btn data-umami-event="investor-pitch">{T.pitchBtn}</button><span class="mt-pitch-n"><b data-pitch-count>0</b> / {PITCH.maxChars}</span><span class="mt-pitch-msg" data-pitch-msg aria-live="polite"></span></div>
        </>
      ) : <p class="mt-ai">{T.pitchSoon}</p>}
    </div>
  </section>

  </aside>
  </div>

  <InlineSignup lang={lang} source="investor-map" id="investors-signup" head={T.signupHead} body={T.signupBody} />

  <section class="note dt-method">
    <b>{T.method}</b>
    <ul>{T.methodBody.map((l) => <li>{l}</li>)}</ul>
  </section>
  <script type="application/json" id="iv-data" set:html={JSON.stringify(data)} />
  <script type="application/json" id="iv-i18n" set:html={JSON.stringify({ lang, subscribe: SUBSCRIBE.endpoint, unlocked: T.mUnlocked, signupErr: T.mSignupErr, pitch: { wait: T.pitchWait, err: T.pitchErr, quota: T.pitchQuota, short: T.pitchShort, locked: T.pitchLocked, btn: T.pitchBtn, aiRead: T.aiRead, aiTop: T.aiTop, aiNote: T.aiNote, top: T.mTop }, ev: T.ev, stage: STAGE_LABEL[lang], focus: FOCUS_LABEL[lang], type: TYPE_LABEL[lang], band: BAND_LABEL, region: REGIONS.map((r) => [r, rName(r)]), countries: Object.fromEntries(countries.map((c) => [c, countryName(c, lang)])), bands: BANDS.map((b) => [b[0], b[1] === Infinity ? null : b[1]]) })} />
</Base>

<style>
  .ih{margin:0 0 8px;max-width:760px}
  .ih-crumb{margin:0 0 14px}
  .ih-crumb a{color:inherit;text-decoration:none}
  .ih-crumb a:hover{color:var(--chalk)}
  .ih-live{display:inline-flex;align-items:center;gap:9px;margin:0 0 18px;padding:6px 13px;border:1px solid var(--accent-line);border-radius:999px;background:var(--accent-soft);font-size:13px;font-weight:600;color:var(--chalk)}
  .ih-live .pulse{box-shadow:0 0 8px 2px var(--accent-line)}
  .ih-h1{font-size:64px;line-height:.95;margin:0;hyphens:manual}
  .ih-sub{margin:18px 0 0;font-size:17px;line-height:1.5;color:var(--g2);max-width:60ch}
  .ih-links{display:flex;flex-wrap:wrap;gap:6px 18px;margin:14px 0 0;font-size:14px}
  .ih-links a{color:var(--chalk);text-decoration:underline;text-underline-offset:4px;text-decoration-color:var(--edge)}
  .ih-links a:hover{color:var(--accent)}
  .ih-links a:first-child{color:var(--accent);font-weight:600;text-decoration:none}
    .ih-cta,.ih-alt{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 22px;border-radius:999px;font-size:15px;font-weight:600;text-decoration:none;white-space:nowrap;border:0;font-family:inherit;cursor:pointer}
  .ih-cta{background:var(--accent);color:var(--accent-ink)}
  .ih-cta:hover{background:var(--chalk);color:var(--ink)}
  @media (prefers-color-scheme: light){:global(:root:not([data-theme="dark"])) .ih-cta:not(:hover){color:#fff}}
  :global(:root[data-theme="light"]) .ih-cta:not(:hover){color:#fff}
  .ih-alt{border:1px solid var(--edge);color:var(--chalk)}
  .ih-alt:hover{border-color:var(--accent);color:var(--accent)}
  @media(max-width:899px){
    .ih-h1{font-size:44px}
    .ih-sub{font-size:15px;margin-top:12px}
    .ih-cta{width:100%}
    .ih-alt{width:100%;border:0;text-decoration:underline;text-underline-offset:4px;min-height:44px}
  }

  /* page grid: filter + list, sidebar with the globe card and the matcher */
  .pg{display:grid;grid-template-columns:minmax(0,1fr) 300px;column-gap:24px;align-items:start;margin:26px 0 0}
  .sb{display:grid;gap:14px;margin-top:12px}
  @media(max-width:899px){.pg{grid-template-columns:1fr}.sb{margin-top:24px}}

  /* globe card */
  .gb{display:block;border:1px solid var(--accent-line);border-radius:16px;overflow:hidden;background:#05070a;color:var(--chalk);text-decoration:none}
  .gb-poster{display:block;width:100%;aspect-ratio:16/9;height:auto;object-fit:cover;transition:transform .6s ease}
  .gb:hover .gb-poster{transform:scale(1.04)}
  .gb-txt{display:flex;flex-direction:column;gap:6px;padding:14px 16px 16px}
  .gb-txt b{font-family:var(--display);font-size:24px;line-height:1;font-weight:400;letter-spacing:.01em}
  .gb-p{font-size:12.5px;line-height:1.5;color:var(--g2)}
  .gb-cta{display:inline-flex;align-items:center;align-self:flex-start;min-height:36px;padding:0 14px;margin-top:4px;border-radius:999px;background:var(--accent);color:var(--accent-ink);font-size:13px;font-weight:600}
  .gb:hover .gb-cta{background:var(--chalk);color:var(--ink)}

  /* matcher */
  .mt{margin:0;border:1px solid var(--accent-line);border-radius:16px;background:var(--panel);padding:18px 16px;scroll-margin-top:16px}
  .mt-h{margin:6px 0 0;font-size:22px;line-height:1.1}
  .mt-sub{margin:8px 0 14px;color:var(--g2);line-height:1.5;font-size:13px}
  .mt-form{display:grid;grid-template-columns:1fr;gap:10px}
  .mt-form>label{display:flex;flex-direction:column;gap:6px;min-width:0;font-size:12.5px;font-weight:600;color:var(--g1)}
  .mt-form select,.mt-form input[type=text]{width:100%;box-sizing:border-box;border:1px solid var(--line);background:var(--ink);color:var(--chalk);border-radius:10px;padding:10px 11px;font:inherit;font-size:14px;min-height:44px}
  .mt-form select{appearance:none;-webkit-appearance:none;padding-right:34px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .mt-form select:focus-visible,.mt-form input:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
  .mt-want{grid-column:1/-1;margin:0;padding:0;border:0;display:flex;flex-wrap:wrap;gap:8px;align-items:center}
  .mt-want legend{float:left;margin-right:6px;padding:0;font-size:12.5px;font-weight:600;color:var(--g1)}
  .mt-pill{position:relative;display:inline-flex;min-height:36px;align-items:center;padding:0 13px;border:1px solid var(--line);border-radius:999px;font-size:13px;color:var(--g1);cursor:pointer;background:var(--ink)}
  .mt-pill input{position:absolute;inset:0;opacity:0;margin:0;cursor:pointer}
  .mt-pill:has(input:checked){background:var(--chalk);color:var(--ink);border-color:var(--chalk)}
  .mt-pill:has(input:focus-visible){outline:2px solid var(--accent);outline-offset:2px}
  .mt-keys{grid-column:1/-1}
  .mt-btns{grid-column:1/-1;display:flex;align-items:center;gap:16px;margin-top:4px}
  .mt-dlg{width:min(800px,calc(100vw - 32px));max-height:min(90vh,calc(100% - 32px));padding:0;border:1px solid var(--accent-line);border-radius:18px;background:var(--panel);color:inherit;box-shadow:0 30px 80px rgba(0,0,0,.6)}
  .mt-dlg::backdrop{background:rgba(0,0,0,.62);backdrop-filter:blur(4px)}
  .mt-dlg-head{position:sticky;top:0;z-index:1;display:flex;align-items:center;justify-content:space-between;padding:12px 18px;border-bottom:1px solid var(--line);background:var(--panel)}
  .mt-dlg-head .kick{margin:0}
  .gl-x{width:32px;height:32px;border:0;border-radius:999px;background:rgba(255,255,255,.08);color:var(--chalk);font-size:20px;line-height:1;cursor:pointer}
  .gl-x:hover{background:rgba(255,255,255,.16)}
  .mt-out{margin:0;padding:16px 18px 20px}
  .mt-out[hidden]{display:none}
  .mt-count{margin:0 0 12px;font-size:13px;color:var(--g2)}
  .mt-count b{color:var(--chalk);font-weight:700}
  .mt-list{list-style:none;margin:0;padding:0;display:grid;gap:10px}
  .mt-list :global(.mr){display:grid;grid-template-columns:64px 1fr;gap:14px;border:1px solid var(--line);border-radius:14px;background:var(--ink);padding:14px 16px;align-items:start}
  .mt-list :global(.mr-score){display:flex;flex-direction:column;align-items:center;justify-content:center;border-radius:12px;background:var(--accent-soft);border:1px solid var(--accent-line);padding:8px 4px;color:var(--accent)}
  .mt-list :global(.mr-score b){font-family:var(--display);font-size:28px;line-height:1}
  .mt-list :global(.mr-score small){font-size:10px;letter-spacing:.08em;text-transform:uppercase;margin-top:2px}
  .mt-list :global(.mr-body){min-width:0}
  .mt-list :global(.mr-top){display:flex;flex-wrap:wrap;align-items:baseline;gap:6px 10px}
  .mt-list :global(.mr-name){margin:0;font-size:16px;font-weight:700}
  .mt-list :global(.mr-name a){color:var(--chalk);text-decoration:none}
  .mt-list :global(.mr-name a:hover){color:var(--accent);text-decoration:underline;text-underline-offset:3px}
  .mt-list :global(.mr-meta){font-size:12.5px;color:var(--g2)}
  .mt-list :global(.mr-meta .fl){display:inline-block;width:16px;height:12px;vertical-align:-1px;margin-right:4px;border-radius:2px;border:1px solid var(--line);box-sizing:content-box}
  .mt-list :global(.mr-why){margin:8px 0 0;padding:0;list-style:none;display:grid;gap:3px;font-size:12.5px;line-height:1.5;color:var(--g1)}
  .mt-list :global(.mr-why li){display:grid;grid-template-columns:72px 1fr;gap:8px}
  .mt-list :global(.mr-why li b){font-weight:600;color:var(--g2)}
  .mt-list :global(.mr-why li i){font-style:normal;color:var(--g3)}
  .mt-list :global(.mr-why li em){font-style:normal;color:var(--accent);font-weight:600}
  .mt-list :global(.mr-src){margin:8px 0 0;font-size:11.5px;color:var(--g3)}
  .mt-list :global(.mr-src a){color:var(--g2)}
  .mt-list :global(.mr.is-locked){filter:blur(5px);pointer-events:none;user-select:none;opacity:.7}
  .mt-lock{margin:14px 0 0}
  .mt-lock[hidden]{display:none}
  .mt-lock-n{margin:0 0 -16px;font-size:13px;color:var(--g2);text-align:center}
  .mt-lock-n b{color:var(--chalk)}
  .mt-lock :global(.isu){margin:0;border-color:var(--accent-line)}
  .mt-lock :global(.mt-note){margin:10px 0 0;padding:10px 12px;border-radius:10px;background:var(--accent-soft);border:1px solid var(--accent-line);font-size:13px;line-height:1.5;color:var(--chalk)}
  .mt-lock :global(.mt-note.is-err){background:none;border-color:var(--down);color:var(--down)}
  .mt-none{margin:0;color:var(--g2);font-size:14px}
  .mt-none[hidden]{display:none}
  .mt-ai{margin:0;font-size:13px;color:var(--g2)}
  .mt-pitch{margin:22px 0 0;border-top:1px solid var(--line);padding-top:18px}
  .mt-pitch-h{margin:0 0 6px;font-size:18px}
  .mt-pitch .mt-sub{margin:0 0 12px}
  .mt-pitch textarea{width:100%;box-sizing:border-box;border:1px solid var(--line);background:var(--ink);color:var(--chalk);border-radius:12px;padding:12px;font:inherit;font-size:14px;line-height:1.5;resize:vertical;min-height:110px}
  .mt-pitch textarea:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
  .mt-pitch .mt-btns{margin-top:10px;flex-wrap:wrap}
  .mt-pitch-n{font-family:var(--mono);font-size:11.5px;color:var(--g3)}
  .mt-pitch-n b{font-weight:500;color:var(--g2)}
  .mt-pitch-msg{font-size:13px;color:var(--g2)}
  .mt-pitch-msg.is-err{color:var(--down)}
  .mt-list :global(.mr-ai){margin:8px 0 0;padding:8px 10px;border-radius:10px;background:var(--accent-soft);border:1px solid var(--accent-line);font-size:13px;line-height:1.5;color:var(--chalk)}
  .mt-list :global(.mr-ai b){display:block;font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--accent);margin-bottom:2px}
  .mt-summary{margin:0 0 12px;font-size:14px;line-height:1.55;color:var(--chalk)}
  .mt-summary[hidden]{display:none}
  .mt-ainote{margin:12px 0 0;font-size:12px;color:var(--g3)}
  .mt-ainote[hidden]{display:none}
  @media(max-width:899px){
    .mt-form{grid-template-columns:1fr 1fr;gap:10px}
    .mt-dlg{width:100vw;max-width:100vw;height:100dvh;max-height:100dvh;border-radius:0;border:0}
    .mt-form select,.mt-form input[type=text]{min-height:48px;font-size:16px}
    .mt-btns{flex-direction:column;align-items:stretch}
    .mt-btns .ih-cta{width:100%}
    .mt-list :global(.mr){grid-template-columns:52px 1fr;gap:10px;padding:12px}
    .mt-list :global(.mr-score b){font-size:24px}
    .mt-list :global(.mr-why li){display:block}
    .mt-list :global(.mr-why li b::after){content:": "}
  }

  /* filter layout: sidebar on desktop, sheet on phones */
  .fx{position:relative;display:grid;grid-template-columns:220px minmax(0,1fr);grid-template-areas:"bar bar" "count count" "chips chips" "side list";column-gap:20px;margin:0;scroll-margin-top:16px}
  .fx-bar{grid-area:bar;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px}
  .fx-open{display:none}
  .dt-q,.dt-sel{position:relative;display:block;min-width:0}
  .dt-q svg{position:absolute;left:13px;top:50%;width:16px;height:16px;transform:translateY(-50%);color:var(--g2);pointer-events:none}
  .dt-sel::after{content:"";position:absolute;right:14px;top:50%;width:7px;height:7px;border-right:1.5px solid var(--g2);border-bottom:1.5px solid var(--g2);transform:translateY(-70%) rotate(45deg);pointer-events:none}
  .fx-bar input,.fx-bar select{width:100%;box-sizing:border-box;border:1px solid var(--line);background:var(--panel);color:var(--chalk);border-radius:10px;padding:9px 11px;font:inherit;font-size:14px;min-height:42px}
