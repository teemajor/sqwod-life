  .fx-bar select{appearance:none;-webkit-appearance:none;padding-right:34px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .fx-bar input:focus-visible,.fx-bar select:focus-visible,.fx-open:focus-visible,.dt-clear:focus-visible,.fx-more:focus-visible,.iv-tag:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
  .dt-count{grid-area:count;display:flex;align-items:center;justify-content:space-between;gap:12px;font-size:12px;color:var(--g2);margin:8px 0 0}
  .dt-count b{font-weight:600;color:var(--chalk)}
  .dt-clear{border:0;background:none;padding:8px 0;margin:-8px 0;font:inherit;font-size:12px;font-weight:600;color:var(--chalk);text-decoration:underline;text-underline-offset:3px;cursor:pointer}
  .dt-clear:hover{color:var(--accent)}
  .dt-clear[hidden]{display:none}
  .fx-chips{grid-area:chips;list-style:none;margin:8px 0 0;padding:0;display:flex;flex-wrap:wrap;gap:6px}
  .fx-chips:empty{display:none}
  .fx-chips :global(button){display:inline-flex;align-items:center;gap:6px;min-height:30px;padding:0 10px;border:1px solid var(--accent-line);background:var(--accent-soft);color:var(--chalk);border-radius:999px;font:inherit;font-size:12.5px;cursor:pointer}
  .fx-chips :global(button::after){content:"×";font-size:15px;color:var(--g2)}
  .fx-chips :global(button:hover){border-color:var(--accent)}
  .fx-side{grid-area:side;align-self:start;position:sticky;top:16px;max-height:calc(100vh - 32px);overflow:auto;margin-top:12px;padding-right:4px;scrollbar-width:thin}
  .fx-side-head,.fx-veil{display:none}
  .fx-side-foot{display:none}
  .fx-g{border-top:1px solid var(--line);padding:4px 0 8px}
  .fx-g:first-child{border-top:0}
  .fx-g summary{cursor:pointer;list-style:none;display:flex;align-items:center;justify-content:space-between;min-height:40px;font-size:13px;font-weight:700;color:var(--chalk);user-select:none}
  .fx-g summary::-webkit-details-marker{display:none}
  .fx-g summary::after{content:"";width:7px;height:7px;border-right:1.5px solid var(--g2);border-bottom:1.5px solid var(--g2);transform:rotate(45deg);margin-right:6px;transition:transform .15s}
  .fx-g[open] summary::after{transform:rotate(-135deg);margin-top:4px}
  .fx-g>div{display:grid;gap:2px;padding-bottom:4px}
  .fx-opt{display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:9px;min-height:32px;padding:2px 4px;border-radius:8px;font-size:13px;color:var(--g1);cursor:pointer}
  .fx-opt:hover{background:var(--panel)}
  .fx-opt[hidden]{display:none}
  .fx-opt input{width:16px;height:16px;margin:0;accent-color:var(--accent);cursor:pointer}
  .fx-opt span{display:flex;align-items:center;gap:7px;min-width:0;line-height:1.3}
  .fx-opt i{font-style:normal;font-family:var(--mono);font-size:11px;color:var(--g3);min-width:2ch;text-align:right}
  .fx-opt.is-zero{color:var(--g3)}
  .fx-opt.is-zero i{color:var(--g4)}
  .fx-help{margin:4px 0 0}
  .fx-help summary{cursor:pointer;list-style:none;font-size:12px;color:var(--g2);text-decoration:underline;text-underline-offset:3px;padding:4px}
  .fx-help summary::-webkit-details-marker{display:none}
  .fx-help summary:hover{color:var(--chalk)}
  .fx-help ul{margin:6px 0 4px;padding:0 4px;list-style:none;display:grid;gap:7px;font-size:12px;line-height:1.45;color:var(--g2)}
  .fx-help li b{color:var(--g1);font-weight:600}
  .fx-more{border:0;background:none;padding:6px 4px;margin:2px 0 0;font:inherit;font-size:12.5px;font-weight:600;color:var(--chalk);text-decoration:underline;text-underline-offset:3px;cursor:pointer;justify-self:start}
  .fx-more:hover{color:var(--accent)}
  .iv-list{grid-area:list;list-style:none;margin:12px 0 24px;padding:0;display:grid;grid-template-columns:1fr;gap:12px;align-content:start}
  @media(max-width:899px){
    .fx{grid-template-columns:1fr;grid-template-areas:"bar" "count" "chips" "list";margin-top:0}
    .fx-bar{grid-template-columns:1fr auto}
    .dt-q{grid-column:1/-1}
    .fx-sort{grid-column:1}
    .fx-bar input,.fx-bar select{min-height:48px;padding-top:0;padding-bottom:0;font-size:16px}
    .fx-open{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:0 16px;border:1px solid var(--line);background:var(--panel);color:var(--chalk);border-radius:10px;font:inherit;font-size:15px;font-weight:600;cursor:pointer;white-space:nowrap}
    .fx-open svg{width:18px;height:18px}
    .fx-open b{display:inline-flex;align-items:center;justify-content:center;min-width:22px;height:22px;padding:0 6px;border-radius:999px;background:var(--accent);color:var(--accent-ink);font-size:12px}
    .fx-open b[hidden]{display:none}
    .dt-count{margin-top:10px;font-size:13px}
    .fx-chips :global(button){min-height:36px}
    .fx-side{position:fixed;inset:auto 0 0 0;z-index:60;max-height:88vh;margin:0;padding:0;border-radius:18px 18px 0 0;background:var(--ink);border-top:1px solid var(--line);box-shadow:0 -12px 40px rgba(0,0,0,.45);display:flex;flex-direction:column;transform:translateY(102%);transition:transform .22s ease;visibility:hidden}
    .fx-side.is-open{transform:none;visibility:visible}
    .fx-side-head{display:flex;align-items:center;justify-content:space-between;padding:14px 18px 10px;border-bottom:1px solid var(--line);font-size:16px}
    .fx-x{border:0;background:var(--panel);color:var(--chalk);width:36px;height:36px;border-radius:999px;font-size:22px;line-height:1;cursor:pointer}
    .fx-side-body{flex:1;overflow:auto;padding:4px 18px 8px;-webkit-overflow-scrolling:touch}
    .fx-opt{min-height:44px;font-size:15px}
    .fx-opt input{width:20px;height:20px}
    .fx-g summary{min-height:46px;font-size:15px}
    .fx-side-foot{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:12px 18px calc(12px + env(safe-area-inset-bottom));border-top:1px solid var(--line);background:var(--ink)}
    .fx-show{flex:1;min-height:48px}
    .fx-veil{display:block;position:fixed;inset:0;z-index:59;background:rgba(0,0,0,.55)}
    .fx-veil[hidden]{display:none}
    .iv-list{margin-top:10px;gap:10px}
  }
  @media(prefers-reduced-motion:reduce){.fx-side{transition:none}}
  :global(body.fx-lock){overflow:hidden}

  /* the cards */
  .iv{border:1px solid var(--line);border-radius:14px;background:var(--panel);padding:16px 18px 14px;min-width:0;scroll-margin-top:24px}
  .iv[hidden]{display:none}
  .iv:target,.iv.is-hit{border-color:var(--accent);box-shadow:0 0 0 1px var(--accent-line)}
  .iv-top{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}
  .iv-name{margin:0;font-size:17px;font-weight:700;line-height:1.3;color:var(--chalk)}
  .iv-name a{color:inherit;text-decoration:none}
  .iv-name a:hover{color:var(--accent);text-decoration:underline;text-underline-offset:3px}
  .iv-type{flex:none;display:inline-flex;align-items:center;min-height:20px;padding:0 8px;border:1px solid var(--line);border-radius:999px;font-size:10.5px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--g1);white-space:nowrap}
  .iv-type-competition,.iv-type-grant{color:var(--accent);border-color:var(--accent-line)}
  .iv-meta{display:flex;flex-wrap:wrap;gap:4px 0;margin:8px 0 0;font-size:12.5px;color:var(--g2);line-height:1.5}
  .iv-meta span::before{content:"·";margin:0 7px;color:var(--g3)}
  .iv-tags{display:flex;flex-wrap:wrap;gap:5px;margin:9px 0 0}
  .iv-tag{border:1px solid var(--line);background:none;color:var(--g1);border-radius:999px;padding:3px 9px;font:inherit;font-size:11.5px;cursor:pointer;line-height:1.3}
  .iv-tag:hover,.iv-tag.on{border-color:var(--accent);color:var(--accent)}
  .iv-focus{margin:8px 0 0;font-size:13.5px;line-height:1.5;color:var(--g1)}
  .iv-deals,.iv-port{margin:8px 0 0;font-size:12.5px;line-height:1.7;color:var(--g2)}
  .iv-deals b,.iv-port b{font-weight:600;color:var(--g1)}
  .iv-deals a{color:var(--chalk);text-decoration:underline;text-decoration-color:var(--edge);text-underline-offset:3px;white-space:nowrap}
  .iv-deals a:hover{color:var(--accent)}
  .iv-deals a :global(.di){width:12px;height:12px;margin-right:3px;vertical-align:-1px}
  .iv-amt{color:var(--g2)}
  .iv-deals i{font-style:normal;color:var(--g3)}
  .iv-port span{white-space:nowrap;color:var(--chalk)}
  .iv-port span i{font-style:normal;color:var(--g3)}
  .iv-port .iv-act{white-space:normal;color:var(--g2)}
  .iv-port .iv-act b{color:var(--accent)}
  .iv-apply{margin:8px 0 0;font-size:12.5px;line-height:1.5;color:var(--g2)}
  .iv-apply.is-open{color:var(--accent);font-weight:600}
  .iv-src{margin:10px 0 0;font-size:11.5px;color:var(--g3)}
  .iv-src a{color:var(--g2)}
  .dt-none{grid-column:1/-1;margin:0;padding:28px 16px;text-align:center;font-size:14px;color:var(--g2);border:1px solid var(--line);border-radius:14px;background:var(--panel);list-style:none}
  .dt-none[hidden]{display:none}
  .dt-none .dt-clear{font-size:14px;margin-left:6px}
  .dt-method ul{margin:8px 0 10px;padding-left:18px}
</style>

<script>
  // ---------- faceted filter: checkboxes with live counts, state in the URL, sheet on phones ----------
  const rows = Array.from(document.querySelectorAll<HTMLLIElement>('.iv'));
  const list = document.querySelector<HTMLUListElement>('.iv-list')!;
  const q = document.querySelector<HTMLInputElement>('[data-q]')!;
  const sort = document.querySelector<HTMLSelectElement>('[data-sort]')!;
  const side = document.querySelector<HTMLElement>('[data-fx-side]')!;
  const boxes = Array.from(side.querySelectorAll<HTMLInputElement>('input[type=checkbox]'));
  const shown = Array.from(document.querySelectorAll('[data-shown],[data-shown-2]'));
  const chipsUl = document.querySelector<HTMLUListElement>('[data-fx-chips]')!;
  const clears = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-clear]'));
  const none = document.querySelector<HTMLElement>('[data-none]')!;
  const badge = document.querySelector<HTMLElement>('[data-fx-n]')!;
  const EUROPE = new Set(['DACH', 'UK', 'Europe']);
  const FACETS = ['type', 'region', 'country', 'stage', 'band', 'focus', 'open', 'deals', 'active', 'abroad', 'leads', 'data'] as const;
  type Facet = (typeof FACETS)[number];
  const SETS: Record<Facet, 'one' | 'many' | 'flag'> = { type: 'one', region: 'one', country: 'one', stage: 'many', band: 'many', focus: 'many', open: 'flag', deals: 'flag', active: 'flag', abroad: 'flag', leads: 'flag', data: 'flag' };

  const state = (): Record<Facet, Set<string>> => {
    const s = Object.fromEntries(FACETS.map((f) => [f, new Set<string>()])) as Record<Facet, Set<string>>;
    for (const b of boxes) if (b.checked) s[b.name as Facet].add(b.value);
    return s;
  };
  /** Does one card pass one facet? OR inside a facet, AND across facets (how Amazon does it). */
  function passes(el: HTMLLIElement, f: Facet, sel: Set<string>): boolean {
    if (!sel.size) return true;
    const v = el.dataset[f] || '';
    if (SETS[f] === 'flag') return v === '1';
    if (f === 'region') return [...sel].some((r) => (r === 'europe-all' ? EUROPE.has(v) : v === r));
    if (SETS[f] === 'one') return sel.has(v);
    const have = v.split(' ');
    return [...sel].some((x) => have.includes(x));
  }
  function apply(push = true) {
    const s = state();
    const text = q.value.trim().toLowerCase();
    let n = 0;
    const okBy = new Map<HTMLLIElement, Record<string, boolean>>();
    for (const el of rows) {
      const by: Record<string, boolean> = { text: !text || (el.dataset.name || '').includes(text) };
      for (const f of FACETS) by[f] = passes(el, f, s[f]);
      okBy.set(el, by);
      const ok = Object.values(by).every(Boolean);
      el.hidden = !ok; if (ok) n++;
    }
    // live counts: for each option, how many cards would show if it were (also) ticked, given every other facet
    for (const b of boxes) {
      const f = b.name as Facet; const one = new Set([b.value]);
      let c = 0;
      for (const el of rows) { const by = okBy.get(el)!; if (by.text && FACETS.every((g) => (g === f ? passes(el, f, one) : by[g]))) c++; }
      const i = b.closest('label')?.querySelector('[data-n]'); if (i) i.textContent = String(c);
      b.closest('label')?.classList.toggle('is-zero', c === 0 && !b.checked);
    }
    sortRows();
    shown.forEach((el) => (el.textContent = String(n)));
    const active = boxes.filter((b) => b.checked).length;
    badge.textContent = String(active); badge.hidden = !active;
    const any = active > 0 || !!text;
    clears.forEach((c) => { if (!c.closest('.dt-none')) c.hidden = !any; });
    none.hidden = n > 0;
    renderChips();
    document.querySelectorAll<HTMLButtonElement>('.iv-tag').forEach((t) => t.classList.toggle('on', s.focus.has(t.dataset.tag || '')));
    if (push) writeUrl();
  }
  function sortRows() {
    const k = sort.value;
    const key = (el: HTMLLIElement) => ({ active: -Number(el.dataset.a12 || 0) * 1e6 - Number(el.dataset.tot || 0), deals: -Number(el.dataset.nd || 0) * 1e6 - Number(el.dataset.tot || 0), recent: el.dataset.last ? -Number(el.dataset.last.replace(/-/g, '')) : 0, open: -Number(el.dataset.open || 0) * 1e9 - Number(el.dataset.a12 || 0), az: 0 } as Record<string, number>)[k] ?? 0;
    const sorted = [...rows].sort((a, b) => key(a) - key(b) || (a.dataset.az || '').localeCompare(b.dataset.az || ''));
    sorted.forEach((el) => list.insertBefore(el, none));
  }
  function renderChips() {
    chipsUl.replaceChildren(...boxes.filter((b) => b.checked).map((b) => {
      const li = document.createElement('li'); const btn = document.createElement('button'); btn.type = 'button';
      const label = b.closest('label')?.querySelector('span')?.textContent?.trim() || b.value;
      btn.textContent = label; btn.setAttribute('aria-label', `${label} ×`);
      btn.addEventListener('click', () => { b.checked = false; apply(); }); li.append(btn); return li;
    }));
  }
  function writeUrl() {
    const p = new URLSearchParams();
    const s = state();
    for (const f of FACETS) if (s[f].size) p.set(f, [...s[f]].join(','));
    if (q.value.trim()) p.set('q', q.value.trim());
    if (sort.value !== 'active') p.set('sort', sort.value);
    const qs = p.toString();
    history.replaceState(null, '', location.pathname + (qs ? '?' + qs : '') + location.hash);
  }
  function readUrl() {
    const p = new URLSearchParams(location.search);
    for (const b of boxes) b.checked = (p.get(b.name) || '').split(',').includes(b.value);
    q.value = p.get('q') || '';
    const so = p.get('sort'); if (so && [...sort.options].some((o) => o.value === so)) sort.value = so;
    // open the groups that carry a selection; show hidden countries if one is ticked
    for (const b of boxes) if (b.checked) { b.closest('details')?.setAttribute('open', ''); const l = b.closest('label'); if (l?.hidden) expand(l.parentElement!, true); }
  }
  function expand(wrap: HTMLElement, open: boolean) {
    wrap.querySelectorAll<HTMLElement>('label').forEach((l, k) => { if (k >= 8) l.hidden = !open; });
    const t = wrap.querySelector<HTMLButtonElement>('[data-fx-toggle]'); if (t) { t.dataset.open = open ? '1' : ''; t.textContent = open ? t.dataset.less! : `${t.dataset.more} (${wrap.querySelectorAll('label').length})`; }
  }
  document.querySelectorAll<HTMLButtonElement>('[data-fx-toggle]').forEach((t) => t.addEventListener('click', () => expand(t.parentElement!, !t.dataset.open)));
  boxes.forEach((b) => b.addEventListener('change', () => apply()));
  q.addEventListener('input', () => apply()); sort.addEventListener('change', () => apply());
  clears.forEach((c) => c.addEventListener('click', () => { boxes.forEach((b) => (b.checked = false)); q.value = ''; apply(); }));
  document.querySelectorAll<HTMLButtonElement>('.iv-tag').forEach((t) => t.addEventListener('click', () => {
    const b = boxes.find((x) => x.name === 'focus' && x.value === t.dataset.tag); if (!b) return;
    b.checked = !b.checked; apply(); document.getElementById('all-investors')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }));
  // phone sheet
  const veil = document.querySelector<HTMLElement>('.fx-veil')!;
  const opener = document.querySelector<HTMLButtonElement>('[data-fx-open]')!;
  function sheet(open: boolean) {
    side.classList.toggle('is-open', open); veil.hidden = !open; document.body.classList.toggle('fx-lock', open);
    opener.setAttribute('aria-expanded', String(open));
    if (open) { side.querySelector<HTMLElement>('.fx-side-body')!.scrollTop = 0; side.querySelector<HTMLElement>('input,button')?.focus(); } else opener.focus();
  }
  opener.addEventListener('click', () => sheet(true));
  document.querySelectorAll<HTMLElement>('[data-fx-close]').forEach((x) => x.addEventListener('click', () => sheet(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && side.classList.contains('is-open')) sheet(false); });
  readUrl();
  apply(false);
  // a deep link (#general-catalyst) from the Deal Tracker: scroll once layout is settled
  if (location.hash) { const t = document.querySelector<HTMLElement>(location.hash); if (t?.classList.contains('iv')) requestAnimationFrame(() => t.scrollIntoView({ block: 'start' })); }

  // ---------- Investor Matcher: rule-based score with the evidence shown ----------
  type Row = { id: string; n: string; t: string; c: string; cc: string; r: string; city: string; st: string[]; sf: string; min: number | null; max: number | null; chk: string; typ: number | null; f: string[]; p: string[]; d: string[]; tot: number; a12: number; last: string; open: number; lead: number; ab: number; kw: string; cbi: string; cb: string };
  const DATA: Row[] = JSON.parse(document.getElementById('iv-data')!.textContent || '[]');
  const I = JSON.parse(document.getElementById('iv-i18n')!.textContent || '{}');
  const STAGE_ORDER = ['idea', 'preseed', 'seed', 'a', 'b', 'growth'];
  const REG: Record<string, RegExp> = { DACH: /^(germany|austria|switzerland|liechtenstein)$/i, UK: /^(united kingdom|uk)$/i, Europe: /^(france|spain|italy|portugal|netherlands|belgium|luxembourg|ireland|denmark|sweden|norway|finland|iceland|poland|czechia|romania|greece|estonia|latvia|lithuania|monaco)$/i, 'North America': /^(united states|canada)$/i, 'Asia-Pacific': /^(japan|china|hong kong|taiwan|south korea|india|singapore|australia|new zealand|indonesia|malaysia|thailand|vietnam|philippines)$/i, 'Middle East': /^(united arab emirates|saudi arabia|qatar|israel|kuwait|bahrain|oman)$/i, 'Latin America': /^(brazil|mexico|argentina|chile|colombia|costa rica|peru)$/i };
  const regionOf = (c: string) => Object.keys(REG).find((k) => REG[k].test(c)) || 'Other';
  const WANT_TYPES: Record<string, string[]> = { money: ['vc', 'corporate'], programme: ['accelerator'], grant: ['grant', 'competition'], buyer: ['buyer'] };
  const fmt = (n: number) => n >= 1e9 ? `$${(n / 1e9).toFixed(1).replace(/\.0$/, '')}B` : n >= 1e6 ? `$${(n / 1e6).toFixed(1).replace(/\.0$/, '')}M` : n >= 1e3 ? `$${Math.round(n / 1e3)}K` : `$${n}`;
  const fmtD = (iso: string) => iso ? new Date(iso + 'T12:00:00Z').toLocaleDateString(I.lang === 'de' ? 'de-DE' : 'en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) : '';
  const stageRange = (st: string[]) => st.length === STAGE_ORDER.length ? (I.lang === 'de' ? 'alle Phasen' : 'any stage') : st.length === 1 ? I.stage[st[0]] : `${I.stage[st[0]]} – ${I.stage[st[st.length - 1]]}`;

  interface Line { k: string; text: string; hit: boolean }
  function score(x: Row, inp: { cat: string; stage: string; country: string; band: number | null; kw: string[] }) {
    const why: Line[] = []; let s = 0;
    // 1. stage (25)
    const si = STAGE_ORDER.indexOf(inp.stage);
    if (x.st.includes(inp.stage)) { s += 25; why.push({ k: 'stage', text: `${stageRange(x.st)} (${x.sf === 'crunchbase' ? 'Crunchbase' : x.sf === 'portfolio' ? 'CB Insights' : I.lang === 'de' ? 'Verzeichnis' : 'directory'})`, hit: true }); }
    else if (x.st.some((k) => Math.abs(STAGE_ORDER.indexOf(k) - si) === 1)) { s += 12; why.push({ k: 'stage', text: `${stageRange(x.st)} · ${I.ev.adjacent}`, hit: false }); }
    else if (!x.st.length) { s += 8; why.push({ k: 'stage', text: I.ev.unknown, hit: false }); }
    else why.push({ k: 'stage', text: `${stageRange(x.st)} · ${I.ev.none}`, hit: false });
    // 2. focus (25): tag match, plus keyword hits in the focus text and portfolio names
    const kwHits = inp.kw.filter((w) => x.kw.includes(w));
    const port = [...x.p, ...x.d].slice(0, 3);
    if (x.f.includes(inp.cat)) { s += 25 + Math.min(5, kwHits.length * 3); why.push({ k: 'focus', text: `${x.f.map((k) => I.focus[k]).join(', ')}${kwHits.length ? ` · „${kwHits.join('“, „')}“` : ''}`, hit: true }); }
    else if (kwHits.length) { s += Math.min(18, 8 + kwHits.length * 5); why.push({ k: 'focus', text: `„${kwHits.join('“, „')}“${x.f.length ? ` · ${x.f.map((k) => I.focus[k]).join(', ')}` : ''}`, hit: true }); }
    else if (!x.f.length) { s += 5; why.push({ k: 'focus', text: I.ev.unknown, hit: false }); }
    else { s -= 10; why.push({ k: 'focus', text: `${x.f.map((k) => I.focus[k]).join(', ')} · ${I.ev.noFocus}`, hit: false }); }
    if (port.length) why.push({ k: 'portfolio', text: port.join(', '), hit: false });
    // 3. geography (20)
    const r = inp.country ? regionOf(inp.country) : '';
    const where = x.c ? `${x.city ? x.city + ', ' : ''}${I.countries[x.c] || x.c}` : I.ev.unknown;
    if (!inp.country) { s += 8; why.push({ k: 'geo', text: where, hit: false }); }
    else if (x.c === inp.country) { s += 15; why.push({ k: 'geo', text: `${where} · ${I.ev.sameCountry}`, hit: true }); }
    else if (x.c && x.r === r) { s += 11; why.push({ k: 'geo', text: `${where} · ${I.ev.sameRegion}`, hit: true }); }
    else if (x.ab) { s += 6; why.push({ k: 'geo', text: `${where} · ${I.ev.abroad}`, hit: false }); }
    else if (!x.c) { s += 4; why.push({ k: 'geo', text: where, hit: false }); }
    else { s += 2; why.push({ k: 'geo', text: `${where} · ${I.ev.otherRegion}`, hit: false }); }
    // 4. cheque (15)
    const b = inp.band;
    if (b == null) { s += 8; if (x.chk || x.typ) why.push({ k: 'check', text: x.chk || `${I.lang === 'de' ? 'typische Runde' : 'typical round'} ${fmt(x.typ!)}`, hit: false }); }
    else if (x.min != null && x.max != null) {
      const [lo, hi] = I.bands[b] as [number, number | null]; const ok = x.min < (hi ?? Infinity) && x.max >= lo;
      const near = !ok && (x.max >= lo / 5 && x.min <= (hi ?? Infinity) * 5);
      s += ok ? 15 : near ? 7 : 0; why.push({ k: 'check', text: `${x.chk} · ${ok ? I.ev.fits : near ? I.ev.near : I.ev.off}`, hit: ok });
    } else if (x.typ) {
      const [lo, hi] = I.bands[b] as [number, number | null]; const mid = hi ? (lo + hi) / 2 : lo * 2;
      const ratio = x.typ / Math.max(mid, 1); const ok = ratio >= 0.5 && ratio <= 4; const near = !ok && ratio >= 0.15 && ratio <= 12;
      s += ok ? 11 : near ? 6 : 1; why.push({ k: 'check', text: `${I.lang === 'de' ? 'typische Runde' : 'typical round'} ${fmt(x.typ)} · ${ok ? I.ev.fits : near ? I.ev.near : I.ev.off}`, hit: ok });
    } else { s += 5; why.push({ k: 'check', text: I.ev.unknown, hit: false }); }
    // 5. activity (15)
    const parts: string[] = [];
    if (x.a12 >= 5) s += 15; else if (x.a12 >= 2) s += 11; else if (x.a12 >= 1) s += 8; else if (x.d.length) s += 6; else if (x.open) s += 10; else s += 2;
    if (x.a12) parts.push(`${x.a12} ${I.ev.inv12}`);
    if (x.last) parts.push(`${I.ev.last} ${fmtD(x.last)}`);
    if (x.d.length) parts.push(`${x.d.length} ${I.ev.tracker}`);
    if (x.open) parts.push(I.ev.open);
    why.push({ k: 'activity', text: parts.join(' · ') || I.ev.unknown, hit: x.a12 > 0 || !!x.open });
    if (x.lead) s += 2;
    return { s: Math.max(0, Math.min(100, Math.round(s))), why };
  }

  const form = document.querySelector<HTMLFormElement>('[data-mt-form]')!;
  const out = document.querySelector<HTMLElement>('[data-mt-out]')!;
  const dlg = document.querySelector<HTMLDialogElement>('[data-mt-dlg]')!;
  dlg.querySelector('[data-mt-close]')!.addEventListener('click', () => dlg.close());
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  const ol = document.querySelector<HTMLOListElement>('[data-mt-list]')!;
  const lock = document.querySelector<HTMLElement>('[data-mt-lock]')!;
  const mnone = document.querySelector<HTMLElement>('[data-mt-none]')!;
  const reset = document.querySelector<HTMLButtonElement>('[data-mt-reset]')!;
  const UNLOCK = 'sqwod_investor_unlock';
  const unlocked = () => { try { return localStorage.getItem(UNLOCK) === '1'; } catch { return false; } };
  // the sign-up form posts and redirects; remember the unlock on this device before it leaves
  let lastRanked: { x: Row; s: number; why: Line[] }[] = []; let lastAi: Map<string, string> | undefined;
  const signup = document.querySelector<HTMLFormElement>('#matcher-signup form');
  signup?.addEventListener('submit', async (e) => {
    // post in the background: the person keeps their results, the Worker still sends the confirmation mail
    e.preventDefault();
    const fd = new FormData(signup); const body: Record<string, string> = {}; fd.forEach((v, k) => (body[k] = String(v)));
    const button = signup.querySelector<HTMLButtonElement>('button[type=submit]'); if (button) button.disabled = true;
    let ok = false;
    try { const r = await fetch(signup.action, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) }); ok = r.ok; } catch {}
    if (button) button.disabled = false;
    const note = document.createElement('p'); note.className = 'mt-note' + (ok ? '' : ' is-err'); note.textContent = ok ? I.unlocked : I.signupErr;
    signup.parentElement?.querySelector('.mt-note')?.remove(); signup.parentElement?.append(note);
    if (ok) { try { localStorage.setItem(UNLOCK, '1'); } catch {} setTimeout(() => render(lastRanked, lastAi), 900); }
  });
  const summaryEl = document.querySelector<HTMLElement>('[data-mt-summary]')!;
  const aiNoteEl = document.querySelector<HTMLElement>('[data-mt-ainote]')!;
  const topEl = document.querySelector<HTMLElement>('[data-mt-top]')!;
  function run() {
    const fd = new FormData(form);
    const cat = String(fd.get('cat') || ''), stage = String(fd.get('stage') || '');
    if (!cat || !stage) { form.reportValidity(); return; }
    const country = String(fd.get('country') || ''); const bandS = String(fd.get('band') || ''); const band = bandS === '' ? null : Number(bandS);
    const wants = fd.getAll('want').map(String); const types = new Set(wants.flatMap((w) => WANT_TYPES[w] || []));
    const kw = String(fd.get('kw') || '').toLowerCase().split(/[,;\s]+/).map((w) => w.trim()).filter((w) => w.length >= 3);
    const ranked = DATA.filter((x) => !types.size || types.has(x.t)).map((x) => ({ x, ...score(x, { cat, stage, country, band, kw }) })).filter((m) => m.s >= 45).sort((a, b) => b.s - a.s || b.x.a12 - a.x.a12 || a.x.n.localeCompare(b.x.n));
    summaryEl.hidden = true; aiNoteEl.hidden = true; topEl.textContent = I.pitch.top;
    render(ranked);
  }
  /** Draw a ranked list; ai: per-id reason from the pitch read (shown above the evidence lines). */
  function render(ranked: { x: Row; s: number; why: Line[] }[], ai?: Map<string, string>) {
    lastRanked = ranked; lastAi = ai;
    const free = unlocked() || ai ? ranked.length : 5;
    ol.replaceChildren(...ranked.slice(0, unlocked() ? ranked.length : 8).map((m, k) => {
      const li = document.createElement('li'); li.className = 'mr' + (k >= free ? ' is-locked' : ''); if (k >= free) li.setAttribute('aria-hidden', 'true');
      const x = m.x;
      const name = x.id ? `<a href="#${x.id}">${esc(x.n)}</a>` : esc(x.n);
      const flag = x.cc ? `<svg class="fl" width="16" height="12" aria-hidden="true"><use href="#fl-${x.cc}"/></svg> ` : '';
      li.innerHTML = `<div class="mr-score"><b>${m.s}</b><small>${esc(I.lang === 'de' ? 'Match' : 'match')}</small></div><div class="mr-body"><div class="mr-top"><h3 class="mr-name">${name}</h3><span class="mr-meta">${esc(I.type[x.t] || x.t)}${x.c ? ` · ${flag}${esc(I.countries[x.c] || x.c)}` : ''}</span></div>`
        + (ai?.get(x.id) ? `<p class="mr-ai"><b>${esc(I.pitch.aiRead)}</b>${esc(ai.get(x.id)!)}</p>` : '')
        + `<ul class="mr-why">${m.why.map((w) => `<li><b>${esc(I.ev[w.k])}</b><span>${w.hit ? '<em>✓</em> ' : ''}${esc(w.text)}</span></li>`).join('')}</ul>`
        + `<p class="mr-src">${[x.cbi ? `<a href="${x.cbi}" rel="nofollow noopener" target="_blank">CB Insights ↗</a>` : '', x.cb ? `<a href="${x.cb}" rel="nofollow noopener" target="_blank">Crunchbase ↗</a>` : '', x.id ? `<a href="#${x.id}">${I.lang === 'de' ? 'Eintrag in der Map' : 'Entry in the map'}</a>` : ''].filter(Boolean).join(' · ')}</p></div>`;
      return li;
    }));
    document.querySelector('[data-mt-n]')!.textContent = String(ranked.length);
    const more = Math.max(0, ranked.length - 5);
    lock.hidden = unlocked() || !!ai || more === 0; document.querySelector('[data-mt-more]')!.textContent = String(more);
    mnone.hidden = ranked.length > 0; out.hidden = false; reset.hidden = false;
    if (!dlg.open) dlg.showModal(); dlg.scrollTop = 0;
  }
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  form.addEventListener('submit', (e) => { e.preventDefault(); run(); });
  form.addEventListener('reset', () => { setTimeout(() => { out.hidden = true; reset.hidden = true; ol.replaceChildren(); if (dlg.open) dlg.close(); }, 0); });
  // results link to cards; make sure the card is visible (clear the filter if it hides it)
  ol.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="#"]'); if (!a) return;
    const t = document.querySelector<HTMLElement>(a.getAttribute('href')!); if (t?.classList.contains('iv') && t.hidden) { boxes.forEach((b) => (b.checked = false)); q.value = ''; apply(); }
    if (dlg.open) dlg.close();
  });

  // ---------- AI pitch read: POST the pitch to the Worker, merge its reasons with the rule-based evidence ----------
  (() => {
    const box = document.querySelector<HTMLElement>('[data-pitch]'); const ta = document.querySelector<HTMLTextAreaElement>('[data-pitch-text]'); const btn = document.querySelector<HTMLButtonElement>('[data-pitch-btn]');
    if (!box || !ta || !btn || !box.dataset.endpoint) return;
    const msg = document.querySelector<HTMLElement>('[data-pitch-msg]')!; const cnt = document.querySelector<HTMLElement>('[data-pitch-count]')!;
    const opened = Date.now();
    const say = (t: string, err = false) => { msg.textContent = t; msg.classList.toggle('is-err', err); };
    const PITCH_KEY = 'sqwod_pitch_text';
    try { const saved = sessionStorage.getItem(PITCH_KEY); if (saved && !ta.value) ta.value = saved; } catch {}
    const refresh = () => { cnt.textContent = String(ta.value.length); btn.textContent = I.pitch.btn; try { sessionStorage.setItem(PITCH_KEY, ta.value); } catch {} };
    ta.addEventListener('input', refresh); refresh();
    btn.addEventListener('click', async () => {
      const text = ta.value.trim(); if (text.length < 40) { say(I.pitch.short, true); return; }
      btn.disabled = true; say(I.pitch.wait);
      try {
        const r = await fetch(box.dataset.endpoint!, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ pitch: text, lang: I.lang, ts: opened }) });
        const j = await r.json().catch(() => ({}));
        if (!r.ok) { say(j.error === 'quota' ? I.pitch.quota : `${I.pitch.err} (${[j.error, j.status, j.detail].filter(Boolean).join(' · ')})`, true); return; }
        const byId = new Map(DATA.map((x) => [x.id, x]));
        const ai = new Map<string, string>((j.matches || []).map((m: any) => [m.id, m.why]));
        // rule-based evidence for each pick, scored with whatever the form holds (or neutral inputs)
        const fd = new FormData(form); const stage = String(fd.get('stage') || 'seed'); const cat = String(fd.get('cat') || '');
        const country = String(fd.get('country') || ''); const bandS = String(fd.get('band') || ''); const band = bandS === '' ? null : Number(bandS);
        const ranked = (j.matches || []).map((m: any) => byId.get(m.id)).filter(Boolean).map((x: Row) => { const m: any = (j.matches || []).find((k: any) => k.id === x.id); const sc = score(x, { cat: cat || (x.f[0] || ''), stage, country, band, kw: [] }); return { x, s: m.score, why: sc.why }; });
        summaryEl.textContent = j.summary || ''; summaryEl.hidden = !j.summary; topEl.textContent = I.pitch.aiTop;
        aiNoteEl.textContent = String(I.pitch.aiNote).replace('{m}', j.model || ''); aiNoteEl.hidden = false;
        render(ranked, ai); say('');
      } catch { say(I.pitch.err, true); } finally { btn.disabled = false; }
    });
  })();


</script>
