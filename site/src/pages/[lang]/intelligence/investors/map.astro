---
// Sqwod Investor Globe: the Investor Map on a 3D globe (globe.gl / three.js, loaded only on this page).
// Every investor with a known HQ is a dot (colour = type, size = investments in the last 12 months);
// arcs run from an investor to the companies it backed on the Deal Tracker; rings mark open calls.
// Filters share the URL parameters of the list page (?type=, ?region=, ?focus=).
import Base from '../../../../layouts/Base.astro';
import { ogPath } from '../../../../lib/og';
import DealGlyphs from '../../../../components/DealGlyphs.astro';
import { flagCode, countryName } from '../../../../lib/flags';
import { investors, FOCUS_LABEL, FOCUS, type InvestorType } from '../../../../lib/investors';
import { globeData, GLOBE_COLORS } from '../../../../lib/globe-data';
import { languages, type Lang } from '../../../../i18n/ui';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const de = lang === 'de';
const all = investors();
const { points, arcs, unplaced } = globeData(lang, all);
const types: InvestorType[] = ['vc', 'corporate', 'accelerator', 'competition', 'grant', 'buyer'];
const REGIONS = ['DACH', 'UK', 'Europe', 'North America', 'Asia-Pacific', 'Middle East', 'Latin America'];
const REGION_DE: Record<string, string> = { DACH: 'DACH', UK: 'UK', Europe: 'Europa', 'North America': 'Nordamerika', 'Asia-Pacific': 'Asien-Pazifik', 'Middle East': 'Naher Osten', 'Latin America': 'Lateinamerika' };
const rName = (r: string) => (de ? REGION_DE[r] || r : r);
const countries = [...new Set(points.map((p) => p.c))];
const cNames = Object.fromEntries([...new Set([...countries, ...arcs.map((a) => a.c)])].map((c) => [c, countryName(c, lang)]));
const flagCodes = [...new Set(points.map((p) => p.cc))].filter(Boolean);

const T = de ? {
  title: 'Sqwod Investor Globe: Fitness- und Wellness-Investoren auf dem Globus', crumb: 'Investor Globe',
  h1: 'Der Investor Globe.', sub: `${points.length} Investoren, Programme und Käufer aus der Investor Map auf einem drehbaren Globus. Punkt = Sitz, Größe = Investments der letzten 12 Monate, Bogen = ein Deal aus dem Deal Tracker in einem anderen Land, Ring = Bewerbung offen.`,
  back: 'Zur Liste', list: 'Investor Map (Liste)', kpi: { shown: 'angezeigt', countries: 'Länder', arcs: 'Deal-Bögen', open: 'offene Aufrufe' },
  all: 'Alle', region: 'Region', focus: 'Fokus', search: 'Investor suchen und hinfliegen …', arcsT: { traffic: 'Bögen: Verkehr', all: 'Bögen: alle', off: 'Bögen: aus' } as Record<string, string>, rotate: 'Drehen', tour: 'Tour', stop: 'Stopp', legend: 'Legende',
  types: { vc: 'Fonds', corporate: 'Corporate', accelerator: 'Accelerator', competition: 'Wettbewerb', grant: 'Förderung', buyer: 'Käufer' } as Record<string, string>,
  hint: 'Ziehen zum Drehen, Scrollen zum Zoomen, Punkt antippen für Details.', nowebgl: 'Dein Browser kann kein WebGL darstellen. Die Investor Map als Liste:',
  close: 'Schließen', stage: 'Phase', cheque: 'Ticket', activity: 'Aktivität', inv12: 'Investments in 12 Monaten', last: 'zuletzt', deals: 'Deals im Deal Tracker', lead: 'Lead', buyerOf: 'Kauf', port: 'Portfolio (CB Insights)', open: 'Bewerbung offen', entry: 'Eintrag in der Investor Map →', site: 'Website ↗', approx: 'Position: Landesmitte (Stadt unbekannt)', unplaced: `${unplaced} Einträge ohne bekannten Sitz fehlen auf dem Globus.`,
  tourStops: [['Europa & DACH', 50, 8, 1.3], ['UK', 54, -2, 1.1], ['Nordamerika', 39, -98, 1.6], ['Indien & Asien', 22, 95, 1.7], ['Naher Osten', 26, 50, 1.4]] as [string, number, number, number][],
} : {
  title: 'Sqwod Investor Globe: fitness and wellness investors on a globe', crumb: 'Investor Globe',
  h1: 'The Investor Globe.', sub: `${points.length} investors, programmes and buyers from the Investor Map on a globe you can spin. Dot = HQ, size = investments in the last 12 months, arc = a Deal Tracker deal in another country, ring = applications open.`,
  back: 'Back to the list', list: 'Investor Map (list)', kpi: { shown: 'shown', countries: 'countries', arcs: 'deal arcs', open: 'open calls' },
  all: 'All', region: 'Region', focus: 'Focus', search: 'Search an investor and fly there…', arcsT: { traffic: 'Arcs: traffic', all: 'Arcs: all', off: 'Arcs: off' } as Record<string, string>, rotate: 'Spin', tour: 'Tour', stop: 'Stop', legend: 'Legend',
  types: { vc: 'Fund', corporate: 'Corporate', accelerator: 'Accelerator', competition: 'Competition', grant: 'Grant', buyer: 'Buyer' } as Record<string, string>,
  hint: 'Drag to spin, scroll to zoom, tap a dot for details.', nowebgl: 'Your browser cannot render WebGL. The Investor Map as a list:',
  close: 'Close', stage: 'Stage', cheque: 'Cheque', activity: 'Activity', inv12: 'investments in 12 months', last: 'last', deals: 'Deals in the Deal Tracker', lead: 'lead', buyerOf: 'bought', port: 'Portfolio (CB Insights)', open: 'Applications open', entry: 'Entry in the Investor Map →', site: 'Website ↗', approx: 'Position: country centre (city unknown)', unplaced: `${unplaced} entries without a known HQ are not on the globe.`,
  tourStops: [['Europe & DACH', 50, 8, 1.3], ['UK', 54, -2, 1.1], ['North America', 39, -98, 1.6], ['India & Asia', 22, 95, 1.7], ['Middle East', 26, 50, 1.4]] as [string, number, number, number][],
};
const url = `https://sqwod.life/${lang}/intelligence/investors/map/`;
const schema = { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Sqwod Investor Globe', description: T.sub, url, inLanguage: lang, applicationCategory: 'BusinessApplication', operatingSystem: 'Web', creator: { '@type': 'Organization', name: 'Sqwod', url: 'https://sqwod.life' } };
const COLORS = GLOBE_COLORS;
---
<Base lang={lang} title={T.title} description={T.sub} active="intelligence" image={ogPath('investors', lang)}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <DealGlyphs flags={flagCodes} />
  <section class="gh">
    <p class="kick gh-crumb"><a href={`/${lang}/intelligence`}>Sqwod Intelligence</a> / <a href={`/${lang}/intelligence/investors/`}>Investor Map</a> / {T.crumb}</p>
    <div class="gh-row">
      <div>
        <h1 class="gh-h1">{T.h1}</h1>
        <p class="gh-sub">{T.sub}</p>
      </div>
      <ul class="gh-kpis" aria-live="polite">
        <li><b class="dnum gh-acc" data-k="shown">{points.length}</b><span>{T.kpi.shown}</span></li>
        <li><b class="dnum" data-k="countries">{countries.length}</b><span>{T.kpi.countries}</span></li>
        <li><b class="dnum" data-k="arcs">{arcs.length}</b><span>{T.kpi.arcs}</span></li>
        <li><b class="dnum" data-k="open">{points.filter((p) => p.open).length}</b><span>{T.kpi.open}</span></li>
      </ul>
    </div>
  </section>

  <div class="gl" data-gl>
    <div class="gl-stars" aria-hidden="true"></div>
    <div class="gl-canvas" data-canvas aria-label={T.title} role="img"></div>
    <div class="gl-ctl" data-ctl>
      <div class="gl-chips" role="group" aria-label="Type">
        <button type="button" class="on" data-type="" aria-pressed="true">{T.all}</button>
        {types.map((t) => <button type="button" data-type={t} aria-pressed="false"><i style={`background:${COLORS[t]}`}></i>{T.types[t]}</button>)}
      </div>
      <div class="gl-row">
        <label class="gl-q"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg><input type="search" list="gl-names" placeholder={T.search} aria-label={T.search} autocomplete="off" data-q /></label>
        <datalist id="gl-names">{points.map((p) => <option value={p.n} />)}</datalist>
        <span class="dt-sel"><select aria-label={T.region} data-region><option value="">{T.region}: {T.all}</option><option value="europe-all">{de ? 'Europa & DACH' : 'Europe & DACH'}</option>{REGIONS.map((r) => <option value={r}>{rName(r)}</option>)}</select></span>
        <span class="dt-sel"><select aria-label={T.focus} data-focus><option value="">{T.focus}: {T.all}</option>{FOCUS.map((f) => <option value={f}>{FOCUS_LABEL[lang][f]}</option>)}</select></span>
        <div class="gl-tog">
          <button type="button" class="on" data-arcs data-mode="traffic" data-labels={JSON.stringify(T.arcsT)}>{T.arcsT.traffic}</button>
          <button type="button" class="on" data-rotate aria-pressed="true">{T.rotate}</button>
          <button type="button" data-tour aria-pressed="false" data-on={T.stop} data-off={T.tour}>{T.tour}</button>
        </div>
      </div>
    </div>
    <p class="gl-hint" data-hint>{T.hint}</p>
    <p class="gl-tourname" data-tourname hidden></p>
    <aside class="gl-panel" data-panel hidden aria-live="polite">
      <button type="button" class="gl-x" data-close aria-label={T.close}>×</button>
      <div data-panel-body></div>
    </aside>
    <div class="gl-nowebgl" data-nowebgl hidden><p>{T.nowebgl}</p><a class="ih-cta" href={`/${lang}/intelligence/investors/`}>{T.list}</a></div>
  </div>
  <p class="gl-foot"><a href={`/${lang}/intelligence/investors/`}>← {T.back}</a> · {T.unplaced}</p>

  <script type="application/json" id="gl-data" set:html={JSON.stringify({ points, arcs, cNames, colors: COLORS, T: { types: T.types, stage: T.stage, cheque: T.cheque, activity: T.activity, inv12: T.inv12, last: T.last, deals: T.deals, lead: T.lead, buyerOf: T.buyerOf, port: T.port, open: T.open, entry: T.entry, site: T.site, approx: T.approx, tourStops: T.tourStops, focus: FOCUS_LABEL[lang] }, lang, listHref: `/${lang}/intelligence/investors/`, dealsHref: `/${lang}/intelligence/deals/` })} />
</Base>

<style>
  .gh{margin:0 0 14px}
  .gh-crumb{margin:0 0 12px}
  .gh-crumb a{color:inherit;text-decoration:none}
  .gh-crumb a:hover{color:var(--chalk)}
  .gh-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:18px 32px;align-items:end}
  .gh-h1{font-size:56px;line-height:.95;margin:0}
  .gh-sub{margin:12px 0 0;font-size:15px;line-height:1.5;color:var(--g2);max-width:64ch}
  .gh-kpis{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,auto);gap:18px}
  .gh-kpis li{display:flex;flex-direction:column;min-width:0}
  .gh-kpis b{font-size:34px;color:var(--chalk);line-height:1}
  .gh-kpis span{font-size:11.5px;color:var(--g2);margin-top:4px;white-space:nowrap}
  .gh-acc{color:var(--accent)}
  @media(max-width:899px){
    .gh-row{grid-template-columns:1fr;gap:14px}
    .gh-h1{font-size:40px}
    .gh-sub{font-size:14px}
    .gh-kpis{grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}
    .gh-kpis b{font-size:26px}
    .gh-kpis span{white-space:normal;font-size:11px}
  }

  /* full-bleed stage */
  .gl{position:relative;width:100vw;margin-left:calc(50% - 50vw);height:min(82vh,900px);min-height:520px;overflow:hidden;background:#05070a;border-top:1px solid var(--line);border-bottom:1px solid var(--line);isolation:isolate}
  .gl-stars{position:absolute;inset:0;z-index:0;background:
    radial-gradient(1px 1px at 12% 22%,#fff 50%,transparent 51%),radial-gradient(1px 1px at 33% 71%,#fff 50%,transparent 51%),radial-gradient(1.5px 1.5px at 57% 14%,#dfe8ff 50%,transparent 51%),radial-gradient(1px 1px at 78% 48%,#fff 50%,transparent 51%),radial-gradient(1px 1px at 91% 83%,#fff 50%,transparent 51%),radial-gradient(1px 1px at 5% 88%,#fff 50%,transparent 51%),radial-gradient(1.5px 1.5px at 66% 92%,#dfe8ff 50%,transparent 51%),radial-gradient(1px 1px at 44% 36%,#fff 50%,transparent 51%),radial-gradient(1px 1px at 22% 55%,#fff 50%,transparent 51%),radial-gradient(1.5px 1.5px at 84% 18%,#fff 50%,transparent 51%),radial-gradient(1px 1px at 70% 66%,#fff 50%,transparent 51%),radial-gradient(1px 1px at 15% 40%,#fff 50%,transparent 51%),radial-gradient(1px 1px at 50% 80%,#fff 50%,transparent 51%),radial-gradient(1px 1px at 96% 35%,#fff 50%,transparent 51%),radial-gradient(1px 1px at 38% 6%,#fff 50%,transparent 51%),radial-gradient(1px 1px at 61% 44%,#fff 50%,transparent 51%),radial-gradient(1px 1px at 27% 93%,#fff 50%,transparent 51%),radial-gradient(1.5px 1.5px at 8% 62%,#dfe8ff 50%,transparent 51%),
    radial-gradient(ellipse at 50% 120%,rgba(127,181,140,.18),transparent 55%),#05070a;opacity:.9}
  .gl-stars::after{content:"";position:absolute;inset:0;background:radial-gradient(ellipse at 50% 50%,transparent 55%,rgba(5,7,10,.85) 100%)}
  .gl-canvas{position:absolute;inset:0;z-index:1;cursor:grab}
  .gl-canvas:active{cursor:grabbing}
  .gl-canvas :global(canvas){outline:none}
  .gl-canvas :global(.scene-tooltip){font-family:inherit!important;font-size:12.5px!important;color:var(--chalk)!important;background:rgba(8,11,9,.92)!important;border:1px solid var(--accent-line);border-radius:10px;padding:8px 11px!important;box-shadow:0 8px 30px rgba(0,0,0,.5);max-width:260px;line-height:1.4}
  .gl-canvas :global(.scene-tooltip b){display:block;font-size:13.5px;margin-bottom:2px}
  .gl-canvas :global(.scene-tooltip small){color:var(--g2)}
  .gl-ctl{position:absolute;left:0;right:0;top:0;z-index:3;padding:14px 24px 0;pointer-events:none}
  .gl-ctl>*{pointer-events:auto}
  .gl-chips{display:flex;flex-wrap:wrap;gap:6px;margin:0 0 8px}
  .gl-chips button,.gl-tog button{display:inline-flex;align-items:center;gap:7px;min-height:34px;padding:0 12px;border:1px solid rgba(255,255,255,.14);background:rgba(8,11,9,.72);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);color:var(--g1);border-radius:999px;font:inherit;font-size:12.5px;cursor:pointer}
  .gl-chips button i{width:8px;height:8px;border-radius:50%;box-shadow:0 0 8px currentColor}
  .gl-chips button.on,.gl-tog button.on{background:var(--chalk);color:var(--ink);border-color:var(--chalk)}
  .gl-chips button:focus-visible,.gl-tog button:focus-visible,.gl-row input:focus-visible,.gl-row select:focus-visible,.gl-x:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
  .gl-row{display:grid;grid-template-columns:minmax(220px,320px) 170px 190px auto;gap:8px;align-items:center}
  .gl-q{position:relative;display:block}
  .gl-q svg{position:absolute;left:12px;top:50%;width:15px;height:15px;transform:translateY(-50%);color:var(--g2);pointer-events:none}
  .dt-sel{position:relative;display:block;min-width:0}
  .dt-sel::after{content:"";position:absolute;right:13px;top:50%;width:7px;height:7px;border-right:1.5px solid var(--g2);border-bottom:1.5px solid var(--g2);transform:translateY(-70%) rotate(45deg);pointer-events:none}
  .gl-row input,.gl-row select{width:100%;box-sizing:border-box;min-height:36px;border:1px solid rgba(255,255,255,.14);background:rgba(8,11,9,.72);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);color:var(--chalk);border-radius:10px;padding:0 11px;font:inherit;font-size:13px}
  .gl-row input{padding-left:34px}
  .gl-row select{appearance:none;-webkit-appearance:none;padding-right:30px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .gl-tog{display:flex;gap:6px}
  .gl-hint{position:absolute;left:24px;bottom:14px;z-index:3;margin:0;font-size:12px;color:var(--g2);text-shadow:0 1px 8px #000;pointer-events:none}
  .gl-tourname{position:absolute;left:50%;bottom:34px;z-index:3;transform:translateX(-50%);margin:0;font-family:var(--display);font-size:34px;letter-spacing:.02em;color:var(--chalk);text-shadow:0 0 30px rgba(127,181,140,.6);pointer-events:none;animation:gl-pop .6s ease}
  .gl-tourname[hidden]{display:none}
  @keyframes gl-pop{from{opacity:0;transform:translate(-50%,10px)}to{opacity:1;transform:translate(-50%,0)}}
  .gl-panel{position:absolute;right:24px;top:110px;bottom:24px;z-index:4;width:min(380px,calc(100% - 48px));overflow:auto;border:1px solid rgba(255,255,255,.14);border-radius:16px;background:rgba(8,11,9,.86);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);padding:18px 18px 16px;box-shadow:0 20px 60px rgba(0,0,0,.55);animation:gl-in .25s ease}
  .gl-panel[hidden]{display:none}
  @keyframes gl-in{from{opacity:0;transform:translateX(12px)}to{opacity:1;transform:none}}
  .gl-x{position:absolute;right:10px;top:10px;width:32px;height:32px;border:0;border-radius:999px;background:rgba(255,255,255,.08);color:var(--chalk);font-size:20px;line-height:1;cursor:pointer}
  .gl-x:hover{background:rgba(255,255,255,.16)}
  .gl-panel :global(h2){margin:0 28px 4px 0;font-size:20px;line-height:1.2}
  .gl-panel :global(h2 a){color:var(--chalk);text-decoration:none}
  .gl-panel :global(h2 a:hover){color:var(--accent);text-decoration:underline;text-underline-offset:3px}
  .gl-panel :global(.gp-type){display:inline-flex;align-items:center;gap:6px;font-size:10.5px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--g1);margin:0 0 6px}
  .gl-panel :global(.gp-type i){width:8px;height:8px;border-radius:50%;box-shadow:0 0 8px currentColor}
  .gl-panel :global(.gp-meta){margin:0;font-size:12.5px;color:var(--g2);line-height:1.5}
  .gl-panel :global(.gp-meta .fl){display:inline-block;width:16px;height:12px;vertical-align:-1px;margin-right:6px;border-radius:2px;border:1px solid var(--line);box-sizing:content-box}
  .gl-panel :global(.gp-tags){display:flex;flex-wrap:wrap;gap:5px;margin:8px 0 0}
  .gl-panel :global(.gp-tags span){border:1px solid rgba(255,255,255,.14);border-radius:999px;padding:2px 8px;font-size:11px;color:var(--g1)}
  .gl-panel :global(.gp-focus){margin:10px 0 0;font-size:13px;line-height:1.5;color:var(--g1)}
  .gl-panel :global(.gp-kv){margin:10px 0 0;padding:0;list-style:none;display:grid;gap:4px;font-size:12.5px;line-height:1.5}
  .gl-panel :global(.gp-kv li){display:grid;grid-template-columns:72px 1fr;gap:8px}
  .gl-panel :global(.gp-kv b){font-weight:600;color:var(--g2)}
  .gl-panel :global(.gp-kv em){font-style:normal;color:var(--accent);font-weight:600}
  .gl-panel :global(.gp-kv a){color:var(--chalk);text-decoration:underline;text-decoration-color:var(--edge);text-underline-offset:3px}
  .gl-panel :global(.gp-kv a:hover){color:var(--accent)}
  .gl-panel :global(.gp-kv i){font-style:normal;color:var(--g3)}
  .gl-panel :global(.gp-open){margin:10px 0 0;font-size:12.5px;font-weight:600;color:var(--accent)}
  .gl-panel :global(.gp-links){margin:14px 0 0;font-size:12.5px;display:flex;flex-wrap:wrap;gap:6px 14px}
  .gl-panel :global(.gp-links a){color:var(--g1)}
  .gl-panel :global(.gp-links a.gp-entry){color:var(--accent);font-weight:600;text-decoration:none}
  .gl-panel :global(.gp-approx){margin:10px 0 0;font-size:11px;color:var(--g3)}
  .gl-nowebgl{position:absolute;inset:0;z-index:5;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;padding:24px;text-align:center;color:var(--g1);background:#05070a}
  .gl-nowebgl[hidden]{display:none}
  .ih-cta{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 20px;border-radius:999px;background:var(--accent);color:var(--accent-ink);font-weight:600;text-decoration:none}
  .gl-foot{margin:12px 0 0;font-size:12.5px;color:var(--g3)}
  .gl-foot a{color:var(--g1)}
  @media(max-width:899px){
    .gl{height:calc(100svh - 56px);min-height:560px;margin-left:-24px;width:calc(100% + 48px)}
    .gl-ctl{padding:10px 12px 0}
    .gl-chips{flex-wrap:nowrap;overflow-x:auto;scrollbar-width:none;margin:0 -12px 8px;padding:0 12px}
    .gl-chips::-webkit-scrollbar{display:none}
    .gl-chips button{flex:0 0 auto;min-height:38px}
    .gl-row{grid-template-columns:1fr 1fr}
    .gl-q{grid-column:1/-1}
    .gl-row input,.gl-row select{min-height:42px;font-size:16px}
    .gl-tog{grid-column:1/-1;justify-content:flex-start}
    .gl-hint{left:12px;bottom:10px;font-size:11px;right:12px}
    .gl-tourname{font-size:26px;bottom:28px}
    .gl-panel{left:8px;right:8px;top:auto;bottom:8px;width:auto;max-height:58%;padding:16px 14px 14px;animation:gl-up .25s ease}
    @keyframes gl-up{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}
  }
  @media(prefers-reduced-motion:reduce){.gl-panel,.gl-tourname{animation:none}}
</style>

<script>
  import { mountGlobe, hasWebGL, type ArcMode } from '../../../../lib/globe-client';
  import type { GlobePoint as Pt, GlobeArc as Arc } from '../../../../lib/globe-data';
  const D = JSON.parse(document.getElementById('gl-data')!.textContent || '{}') as { points: Pt[]; arcs: Arc[]; cNames: Record<string, string>; colors: Record<string, string>; T: any; lang: string; listHref: string; dealsHref: string };
  const el = document.querySelector<HTMLElement>('[data-canvas]')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const esc = (s: string) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const fmtD = (iso: string) => iso ? new Date(iso + 'T12:00:00Z').toLocaleDateString(D.lang === 'de' ? 'de-DE' : 'en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) : '';
  const fmt = (n: number) => n >= 1e9 ? `$${(n / 1e9).toFixed(1).replace(/\.0$/, '')}B` : n >= 1e6 ? `$${(n / 1e6).toFixed(1).replace(/\.0$/, '')}M` : n >= 1e3 ? `$${Math.round(n / 1e3)}K` : `$${n}`;

  if (!hasWebGL()) {
    document.querySelector<HTMLElement>('[data-nowebgl]')!.hidden = false;
  } else {
    let tourOn = false;
    const g = mountGlobe(el, { colors: D.colors, reduce,
      label: (p) => `<b>${esc(p.n)}</b>${esc(D.T.types[p.t])}${p.c ? ` · ${esc(D.cNames[p.c] || p.c)}${p.city ? ', ' + esc(p.city) : ''}` : ''}<br><small>${p.a12 ? `${p.a12} ${esc(D.T.inv12)}` : ''}${p.a12 && p.deals.length ? ' · ' : ''}${p.deals.length ? `${p.deals.length} ${esc(D.T.deals)}` : ''}${p.open ? ` · ${esc(D.T.open)}` : ''}</small>`,
      arcLabel: (a) => `<b>${esc(a.e)}</b><small>${esc(D.cNames[a.c] || a.c)}</small>`,
      onSelect: (p) => select(p), onUserInput: () => { if (tourOn) tour(false); } });


    // ---- filters (share the list page's URL parameters) ----
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.gl-chips button'));
    const region = document.querySelector<HTMLSelectElement>('[data-region]')!;
    const focus = document.querySelector<HTMLSelectElement>('[data-focus]')!;
    const q = document.querySelector<HTMLInputElement>('[data-q]')!;
    const arcsBtn = document.querySelector<HTMLButtonElement>('[data-arcs]')!;
    const rotBtn = document.querySelector<HTMLButtonElement>('[data-rotate]')!;
    const tourBtn = document.querySelector<HTMLButtonElement>('[data-tour]')!;
    const EUROPE = new Set(['DACH', 'UK', 'Europe']);
    let type = '';
    const p0 = new URLSearchParams(location.search);
    const t0 = (p0.get('type') || '').split(',')[0]; if (chips.some((c) => c.dataset.type === t0)) type = t0;
    const r0 = (p0.get('region') || '').split(',')[0]; if ([...region.options].some((o) => o.value === r0)) region.value = r0;
    const f0 = (p0.get('focus') || '').split(',')[0]; if ([...focus.options].some((o) => o.value === f0)) focus.value = f0;
    chips.forEach((c) => { c.classList.toggle('on', (c.dataset.type || '') === type); c.setAttribute('aria-pressed', String((c.dataset.type || '') === type)); });
    const kpi = (k: string, v: number) => { const b = document.querySelector<HTMLElement>(`[data-k="${k}"]`); if (b) b.textContent = String(v); };
    function visible(): Pt[] {
      const r = region.value, f = focus.value;
      return D.points.filter((p) => (!type || p.t === type) && (!r || (r === 'europe-all' ? EUROPE.has(p.r) : p.r === r)) && (!f || p.f.includes(f)));
    }
    function apply() {
      const pts = visible(); const ids = new Set(pts.map((p) => p.id));
      const arcs = D.arcs.filter((a) => ids.has(a.id));
      g.setData(pts, arcs);
      kpi('shown', pts.length); kpi('countries', new Set(pts.map((p) => p.c)).size); kpi('arcs', arcs.length); kpi('open', pts.filter((p) => p.open).length);
      const u = new URLSearchParams(); if (type) u.set('type', type); if (region.value) u.set('region', region.value); if (focus.value) u.set('focus', focus.value);
      history.replaceState(null, '', location.pathname + (u.toString() ? '?' + u : ''));
    }
    chips.forEach((b) => b.addEventListener('click', () => { type = b.dataset.type || ''; chips.forEach((c) => { c.classList.toggle('on', c === b); c.setAttribute('aria-pressed', String(c === b)); }); apply(); }));
    region.addEventListener('change', apply); focus.addEventListener('change', apply);
    arcsBtn.addEventListener('click', () => { const order: ArcMode[] = ['traffic', 'all', 'off']; const next = order[(order.indexOf(arcsBtn.dataset.mode as ArcMode) + 1) % 3]; arcsBtn.dataset.mode = next; arcsBtn.classList.toggle('on', next !== 'off'); arcsBtn.textContent = JSON.parse(arcsBtn.dataset.labels!)[next]; g.setArcMode(next); });
    rotBtn.addEventListener('click', () => { const on = !rotBtn.classList.contains('on'); rotBtn.classList.toggle('on', on); rotBtn.setAttribute('aria-pressed', String(on)); g.spin(on); });
    apply();

    // ---- fly to a searched investor ----
    q.addEventListener('change', () => {
      const name = q.value.trim().toLowerCase(); if (!name) return;
      const p = D.points.find((x) => x.n.toLowerCase() === name) || D.points.find((x) => x.n.toLowerCase().includes(name)); if (!p) return;
      if (!visible().some((x) => x.id === p.id)) { type = ''; region.value = ''; focus.value = ''; chips.forEach((c) => { c.classList.toggle('on', !c.dataset.type); c.setAttribute('aria-pressed', String(!c.dataset.type)); }); apply(); }
      select(p);
    });

    // ---- detail panel ----
    const panel = document.querySelector<HTMLElement>('[data-panel]')!;
    const body = document.querySelector<HTMLElement>('[data-panel-body]')!;
    document.querySelector('[data-close]')!.addEventListener('click', () => { panel.hidden = true; });
    function select(p: Pt) {
      g.spin(false); rotBtn.classList.remove('on'); rotBtn.setAttribute('aria-pressed', 'false');
      g.flyTo(p.lat - (innerWidth < 900 ? 12 : 0), p.lng + (innerWidth < 900 ? 0 : 14), 1.1);
      const flag = p.cc ? `<svg class="fl" width="16" height="12" aria-hidden="true"><use href="#fl-${p.cc}"/></svg>` : '';
      const kv: string[] = [];
      if (p.st) kv.push(`<li><b>${esc(D.T.stage)}</b><span>${esc(p.st)}</span></li>`);
      if (p.chk) kv.push(`<li><b>${esc(D.T.cheque)}</b><span>${esc(p.chk)}</span></li>`);
      const act: string[] = []; if (p.a12) act.push(`<em>${p.a12}</em> ${esc(D.T.inv12)}`); if (p.last) act.push(`${esc(D.T.last)} ${fmtD(p.last)}`);
      if (act.length) kv.push(`<li><b>${esc(D.T.activity)}</b><span>${act.join(' · ')}</span></li>`);
      if (p.deals.length) kv.push(`<li><b>${esc(D.T.deals)}</b><span>${p.deals.map((d) => `<a href="${D.dealsHref}#deal-${esc(d.id)}">${esc(d.e)}</a>${d.amt ? ` <i>${esc(d.amt)}</i>` : ''}${d.role === 'buyer' ? ` <i>(${esc(D.T.buyerOf)})</i>` : d.lead ? ` <i>(${esc(D.T.lead)})</i>` : ''}`).join(' · ')}</span></li>`);
      if (p.port.length) kv.push(`<li><b>${esc(D.T.port)}</b><span>${p.port.map((r) => `${esc(r[0])} <i>${esc(r[1])}${r[2] ? ', ' + fmt(r[2]) : ''}</i>`).join(' · ')}</span></li>`);
      body.innerHTML = `<p class="gp-type"><i style="background:${D.colors[p.t]};color:${D.colors[p.t]}"></i>${esc(D.T.types[p.t])}</p><h2>${p.url ? `<a href="${esc(p.url)}" target="_blank" rel="noopener">${esc(p.n)}</a>` : esc(p.n)}</h2>`
        + `<p class="gp-meta">${flag}${esc(D.cNames[p.c] || p.c)}${p.city ? ', ' + esc(p.city) : ''}</p>`
        + (p.f.length ? `<div class="gp-tags">${p.f.map((f) => `<span>${esc(D.T.focus[f] || f)}</span>`).join('')}</div>` : '')
        + (p.focus ? `<p class="gp-focus">${esc(p.focus)}</p>` : '')
        + (kv.length ? `<ul class="gp-kv">${kv.join('')}</ul>` : '')
        + (p.open ? `<p class="gp-open">${esc(D.T.open)}</p>` : '')
        + `<p class="gp-links"><a class="gp-entry" href="${D.listHref}#${esc(p.id)}">${esc(D.T.entry)}</a>${p.cbi ? `<a href="${esc(p.cbi)}" target="_blank" rel="nofollow noopener">CB Insights ↗</a>` : ''}${p.cb ? `<a href="${esc(p.cb)}" target="_blank" rel="nofollow noopener">Crunchbase ↗</a>` : ''}</p>`
        + (!p.precise ? `<p class="gp-approx">${esc(D.T.approx)}</p>` : '');
      panel.hidden = false; panel.scrollTop = 0;
    }

    // ---- tour: fly through the regions ----
    const tourName = document.querySelector<HTMLElement>('[data-tourname]')!;
    let tourTimer = 0, stop = 0;
    function tour(on: boolean) {
      tourOn = on; tourBtn.classList.toggle('on', on); tourBtn.setAttribute('aria-pressed', String(on)); tourBtn.textContent = on ? tourBtn.dataset.on! : tourBtn.dataset.off!;
      clearTimeout(tourTimer); tourName.hidden = !on;
      if (!on) { g.spin(rotBtn.classList.contains('on')); return; }
      g.spin(false); panel.hidden = true;
      const step = () => {
        const [name, lat, lng, alt] = D.T.tourStops[stop % D.T.tourStops.length] as [string, number, number, number]; stop++;
        tourName.hidden = true; void tourName.offsetWidth; tourName.textContent = name; tourName.hidden = false;
        g.flyTo(lat, lng, alt, 1800);
        tourTimer = window.setTimeout(step, 4200);
      };
      step();
    }
    tourBtn.addEventListener('click', () => tour(!tourOn));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { panel.hidden = true; if (tourOn) tour(false); } });
    document.addEventListener('visibilitychange', () => { if (document.hidden && tourOn) tour(false); });
  }
</script>
