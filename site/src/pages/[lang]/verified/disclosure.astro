---
import Base from '../../../layouts/Base.astro';
import { languages, type Lang } from '../../../i18n/ui';
export function getStaticPaths() { return languages.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;

// Named partner list — every brand sqwod.life has a live commercial relationship with.
// Naming them is the point: a generic "we may earn a commission" tells a reader nothing
// they can check. Update this list when a programme is accepted or ends; keep it in step
// with the tracking links in src/config/verified-categories.ts.
const asOf = { en: '28 August 2026', de: '28. August 2026' };

const partners: { network: string; brands: string[] }[] = [
  { network: 'impact.com', brands: [
    'AG1 (Athletic Greens)', 'ISSA', 'Kailas', 'Manta Sleep', 'Performance Lab',
    'Pvolve', 'Suunto', 'Ultrahuman', 'Vivobarefoot', 'FitTransformer', 'Zhou Nutrition',
  ] },
  { network: 'Awin', brands: ['Optimum Nutrition'] },
  { network: 'Amazon', brands: [
    lang === 'de'
      ? 'Amazon.de-Partnerprogramm (Partner-ID sqwod-21) — betrifft jeden Amazon-Link auf dieser Seite'
      : 'Amazon.de Associates (tag sqwod-21) — applies to every Amazon link on this site',
  ] },
];

const T = {
  en: {
    title: 'Affiliate disclosure',
    crumb: 'Disclosure',
    lede: 'sqwod.life may earn a commission when you buy through links on Sqwod Verified pages. That is advertising, and we label it: affiliate links carry rel="sponsored" and an "Affiliate" tag on the page.',
    firewall: 'The commission never touches the score.',
    firewallBody: 'The Sqwod Score is 45% Crowd Signal, 40% Sqwod Assessment and 15% Value, and it is calculated the same way whether or not a commission exists. We have declined, been declined by, or simply never approached most of the brands we rank — and several products we rate highest pay us nothing at all. If that ever stops being true, this page changes first.',
    who: 'Who we have a commercial relationship with',
    whoBody: 'Current as of',
    rest: 'Everything else is listed on merit',
    restBody: 'A product with no partner programme behind it is linked plainly, with no tracking and no commission. It is on the shelf because it earned a place there. Brands whose applications we were declined for are treated exactly the same way — the rejection has no bearing on how they are scored or ranked.',
    method: 'Our methodology',
  },
  de: {
    title: 'Affiliate-Hinweis',
    crumb: 'Transparenz',
    lede: 'sqwod.life erhält ggf. eine Provision, wenn du über Links auf Sqwod-Verified-Seiten kaufst. Das ist Werbung, und wir kennzeichnen sie: Affiliate-Links tragen rel="sponsored" und auf der Seite den Hinweis „Anzeige / Affiliate".',
    firewall: 'Die Provision berührt den Score nie.',
    firewallBody: 'Der Sqwod Score besteht zu 45 % aus Crowd Signal, zu 40 % aus der Sqwod-Bewertung und zu 15 % aus Value — und wird identisch berechnet, ob eine Provision existiert oder nicht. Die meisten Marken, die wir bewerten, haben wir abgelehnt, sie uns, oder wir haben sie nie angefragt; mehrere unserer bestbewerteten Produkte zahlen uns überhaupt nichts. Sollte das je nicht mehr stimmen, ändert sich zuerst diese Seite.',
    who: 'Mit wem wir eine kommerzielle Beziehung haben',
    whoBody: 'Stand',
    rest: 'Alles andere ist auf Empfehlung gelistet',
    restBody: 'Ein Produkt ohne Partnerprogramm wird schlicht verlinkt — ohne Tracking, ohne Provision. Es steht im Regal, weil es sich den Platz verdient hat. Marken, deren Programme uns abgelehnt haben, behandeln wir exakt genauso: Die Ablehnung hat keinen Einfluss auf Bewertung oder Ranking.',
    method: 'Unsere Methodik',
  },
}[lang];
---
<Base lang={lang} title={`${T.title} — Sqwod Verified`} active="verified">
  <div class="measure">
    <div class="crumb">Sqwod Verified / {T.crumb}</div>
    <h1>{T.title}</h1>
    <p class="prose" style="margin-top:14px">{T.lede}</p>

    <h2>{T.firewall}</h2>
    <p class="prose">{T.firewallBody}</p>

    <h2>{T.who}</h2>
    <p class="dis-asof">{T.whoBody} {asOf[lang]}.</p>
    <div class="dis-nets">
      {partners.map((p) => (
        <div class="dis-net">
          <h3>{p.network}</h3>
          <ul>{p.brands.map((b) => <li>{b}</li>)}</ul>
        </div>
      ))}
    </div>

    <h2>{T.rest}</h2>
    <p class="prose">{T.restBody}</p>

    <p class="prose" style="margin-top:22px"><a href={`/${lang}/verified/methodology`} style="color:var(--g2)">→ {T.method}</a></p>
  </div>
</Base>

<style>
  .dis-asof{font-size:12px;color:var(--g3);margin:0 0 14px;letter-spacing:.02em}
  .dis-nets{display:grid;gap:12px;margin:0 0 8px}
  .dis-net{border:1px solid var(--line);border-radius:14px;background:var(--panel);padding:15px 17px}
  .dis-net h3{margin:0 0 9px;font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--g3)}
  .dis-net ul{margin:0;padding:0;list-style:none;display:flex;flex-wrap:wrap;gap:7px}
  .dis-net li{font-size:13px;color:var(--g1);border:1px solid var(--line);background:var(--panel2);border-radius:8px;padding:5px 10px}
  @media(min-width:620px){.dis-nets{grid-template-columns:1fr}}
</style>
